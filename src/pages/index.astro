---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <title>Redirecting...</title>
    <!-- 即座に /ja/ にリダイレクト -->
    <meta http-equiv="refresh" content={`0;url=${base}/ja/`} />
  </head>
  <body>
    <script>
      const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') ?? '';
      window.location.replace(`${base}/ja/`);
    </script>
  </body>
</html>
