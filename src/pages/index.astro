---
import fs from 'node:fs';
import path from 'node:path';

// 1. フォルダの場所を特定する
const galleryDir = path.resolve('./public/gallery');

// 2. フォルダの中にある「ファイル名」を全部自動で読み込む
// (jpg, png, webpなどの画像ファイルだけを抜き出します)
const imageFiles = fs.existsSync(galleryDir) 
  ? fs.readdirSync(galleryDir).filter(file => /\.(jpg|jpeg|png|webp)$/i.test(file))
  : [];

const title = "デジタル・アーカイブ美術館";
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<style>
			/* 美術館らしいデザイン設定 */
			body { font-family: "Helvetica Neue", Arial, sans-serif; margin: 0; background-color: #f0f0f0; }
			.header { text-align: center; padding: 60px 20px; background: #222; color: #fff; }
			.gallery-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 25px;
				padding: 40px;
			}
			.card {
				background: white;
				border: 1px solid #ddd;
				border-radius: 4px;
				overflow: hidden;
				box-shadow: 0 4px 6px rgba(0,0,0,0.05);
			}
			.card img {
				width: 100%;
				height: 250px;
				object-fit: contain; /* 絵の全体が収まるように表示 */
				background: #fafafa;
			}
			.filename { padding: 10px; font-size: 0.8rem; color: #666; text-align: center; border-top: 1px solid #eee; }
		</style>
	</head>
	<body>
		<div class="header">
			<h1>{title}</h1>
			<p>{imageFiles.length} 点の作品を展示中</p>
		</div>

		<div class="gallery-grid">
			{imageFiles.map((img) => (
				<div class="card">
					<img src={`/gallery/${img}`} alt={img} loading="lazy" />
					<div class="filename">{img}</div>
				</div>
			))}
		</div>
	</body>
</html>