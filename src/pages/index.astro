---
import artworks from '../data/artworks.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "德永デジタル美術館";
const headerTitle = "德永卓磨と幸子の絵画をご覧ください";

// 展示室のリスト定義
const roomNames = [
  { id: 1, prefix: '１）', name: '異人館' },
  { id: 2, prefix: '２）', name: 'ラ・マンチャ' },
  { id: 3, prefix: '３）', name: '神戸風景' },
  { id: 4, prefix: '４）', name: '静物' },
  { id: 5, prefix: '５）', name: '人物' },
  { id: 6, prefix: '６）', name: '記憶' },
  { id: 7, prefix: '７）', name: 'その他' }
];

// ファイル名(001.jpg等)から番号を抽出し、展示室(カテゴリ)を振り分ける
const categorizedArtworks = artworks.map(info => {
  let category = 0;
  const match = info.file?.match(/(\d+)/);
  if (match) {
    const num = parseInt(match[1], 10);
    if (num >= 1 && num <= 6) category = 1;       // 001〜006 は 1)異人館
    else if (num >= 7 && num <= 12) category = 2; // 007〜012 は 2)ラ・マンチャ
  }
  return { ...info, category };
});

// サイズデータから倍率を計算し、カードの横幅(px)を決定する関数
function getCardWidth(sizeStr) {
  const defaultWidth = 280; // 30号の基準サイズ(横幅280px)
  if (!sizeStr) return defaultWidth;

  const match = sizeStr.match(/(\d+(?:\.\d+)?)/);
  if (!match) return defaultWidth;

  const num = parseFloat(match[1]);
  let scale = 1;

  if (sizeStr.includes('号') || num < 100) {
    scale = num / 30; // 30号を 1.0倍 とする
  } else {
    scale = num / 90;
  }

  const clampedScale = Math.max(0.5, Math.min(scale, 2.5));
  return Math.round(defaultWidth * clampedScale);
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="base-url" content={base} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: "Helvetica Neue", Arial, sans-serif; background: #111; color: #fff; overflow-x: hidden; }

      /* ========== ヘッダー ========== */
      .site-header {
        position: fixed;
        top: 0; left: 0; width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 50px;
        z-index: 1000;
        background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%);
      }
      .header-logo {
        font-size: 1.2rem;
        letter-spacing: 0.2em;
        font-weight: 300;
        color: #fff;
        text-shadow: 0 2px 10px rgba(0,0,0,0.8);
      }
      .header-nav {
        display: flex;
        gap: 30px;
      }
      .header-nav a {
        color: #fff;
        text-decoration: none;
        font-size: 0.9rem;
        letter-spacing: 0.1em;
        opacity: 0.7;
        transition: opacity 0.3s, transform 0.3s;
        text-shadow: 0 2px 8px rgba(0,0,0,0.8);
      }
      .header-nav a:hover {
        opacity: 1;
        transform: translateY(-2px);
      }

      /* スマホ向けヘッダー調整 */
      @media (max-width: 768px) {
        .site-header {
          flex-direction: column;
          padding: 15px 20px;
          gap: 15px;
          background: rgba(0,0,0,0.5);
        }
        .header-nav {
          gap: 15px;
        }
        .header-nav a {
          font-size: 0.8rem;
        }
      }

      /* ========== エントランス ========== */
      .entrance {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: 
          linear-gradient(rgba(17, 17, 17, 0.5), rgba(17, 17, 17, 0.85)),
          url('https://images.unsplash.com/photo-1577083165239-0bd9f19fc08f?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 999;
        transition: opacity 1.2s ease, visibility 1.2s ease;
      }
      .entrance.hidden {
        opacity: 0;
        visibility: hidden;
      }
      
      .entrance h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        letter-spacing: 0.3em;
        text-align: center;
        margin-bottom: 15px;
        font-weight: 300;
        color: #fff;
        text-shadow: 0 4px 15px rgba(0,0,0,0.8);
      }
      .entrance p {
        font-size: 0.9rem;
        letter-spacing: 0.25em;
        color: rgba(255,255,255,0.8);
        margin-bottom: 60px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.8);
      }
      .enter-btn {
        padding: 16px 50px;
        border: 1px solid rgba(255,255,255,0.6);
        background: rgba(0,0,0,0.4);
        backdrop-filter: blur(4px);
        color: #fff;
        font-size: 0.9rem;
        letter-spacing: 0.3em;
        cursor: pointer;
        transition: all 0.4s;
        border-radius: 2px;
      }
      .enter-btn:hover {
        background: rgba(255,255,255,0.2);
        border-color: #fff;
        transform: scale(1.05);
      }

      /* ========== 展示室選択画面 ========== */
      .room-selector {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: 
          linear-gradient(rgba(17, 17, 17, 0.7), rgba(17, 17, 17, 0.95)),
          url('https://images.unsplash.com/photo-1577083165239-0bd9f19fc08f?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 999;
        transition: opacity 1.2s ease, visibility 1.2s ease;
      }
      .room-selector.hidden {
        opacity: 0;
        visibility: hidden;
      }
      .room-selector h2 {
        font-size: clamp(1.5rem, 5vw, 2.5rem);
        letter-spacing: 0.3em;
        font-weight: 300;
        color: #fff;
        margin-bottom: 50px;
        text-shadow: 0 4px 15px rgba(0,0,0,0.8);
      }
      .room-list {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
        max-width: 900px;
        padding: 0 20px;
      }
      .room-btn {
        padding: 15px 30px;
        border: 1px solid rgba(255,255,255,0.4);
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(4px);
        color: #fff;
        font-size: 1rem;
        letter-spacing: 0.1em;
        cursor: pointer;
        transition: all 0.3s;
        min-width: 220px;
        border-radius: 2px;
        text-align: center;
      }
      .room-btn:hover {
        background: rgba(255,255,255,0.2);
        border-color: #fff;
        transform: translateY(-2px);
      }
      .back-btn {
        margin-top: 50px;
        background: none;
        border: none;
        color: rgba(255,255,255,0.6);
        cursor: pointer;
        letter-spacing: 0.2em;
        font-size: 0.9rem;
        transition: color 0.3s;
      }
      .back-btn:hover {
        color: #fff;
      }
      @media (max-width: 768px) {
        .room-btn {
          min-width: 140px;
          padding: 12px 15px;
          font-size: 0.9rem;
        }
      }

      /* ========== メインギャラリー ========== */
      .museum {
        opacity: 0;
        visibility: hidden;
        transition: opacity 1.2s ease, visibility 1.2s ease;
        min-height: 100vh;
      }
      .museum.visible { 
        opacity: 1; 
        visibility: visible;
      }

      .museum-header {
        text-align: center;
        padding: 120px 20px 30px;
        background: linear-gradient(180deg, #1a1a1a 0%, #111 100%);
      }
      .museum-header h2 {
        font-size: 1.2rem;
        letter-spacing: 0.4em;
        font-weight: 300;
        color: rgba(255,255,255,0.6);
      }
      .museum-header .count {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.3);
        margin-top: 8px;
        letter-spacing: 0.2em;
      }

      /* ========== 横スクロールエリア ========== */
      .scroll-hint {
        text-align: center;
        padding: 10px;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.25);
        letter-spacing: 0.2em;
        animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 0.8; }
      }

      .gallery-track-wrapper {
        position: relative;
        padding: 40px 0 60px;
      }
      .gallery-track {
        display: flex;
        gap: 60px;
        padding: 20px 80px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
        cursor: grab;
        align-items: flex-end; 
      }
      .gallery-track:active { cursor: grabbing; }
      .gallery-track::-webkit-scrollbar { display: none; }

      .scroll-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: #fff;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        font-size: 1.2rem;
        cursor: pointer;
        z-index: 10;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .scroll-arrow:hover { background: rgba(255,255,255,0.25); }
      .scroll-arrow.left { left: 15px; }
      .scroll-arrow.right { right: 15px; }

      /* 絵カード */
      .artwork-card {
        flex: 0 0 auto;
        cursor: pointer;
        transition: transform 0.3s;
        position: relative;
      }
      .artwork-card:hover { transform: translateY(-8px); }

      .artwork-frame {
        background: #1a1a1a;
        border: 8px solid #2a2a2a;
        box-shadow:
          0 0 0 1px #444,
          inset 0 0 20px rgba(0,0,0,0.5),
          0 20px 60px rgba(0,0,0,0.6);
        border-radius: 2px;
        position: relative;
        width: 100%;
        display: flex;
      }
      .artwork-frame::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, transparent 50%);
        z-index: 1;
        pointer-events: none;
      }
      .artwork-frame img {
        width: 100%;
        height: auto;
        display: block;
      }

      .artwork-label {
        text-align: center;
        margin-top: 15px;
        padding: 0 5px;
      }
      .artwork-label .artwork-title {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.8);
        letter-spacing: 0.05em;
      }
      .artwork-label .artwork-artist {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.35);
        margin-top: 4px;
      }

      /* ========== モーダル ========== */
      .modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0,0,0,0.9);
        z-index: 2000;
        justify-content: center;
        align-items: center;
      }
      .modal-overlay.active { display: flex; }
      
      .modal {
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 4px;
        max-width: 720px;
        width: 92%;
        max-height: 90vh;
        overflow-y: auto;
        padding: 35px;
        position: relative;
        color: #fff;
      }
      
      .modal-close {
        position: absolute;
        top: 15px; right: 20px;
        font-size: 1.3rem;
        cursor: pointer;
        background: none;
        border: none;
        color: rgba(255,255,255,0.5);
        transition: color 0.2s;
      }
      .modal-close:hover { color: #fff; }

      .modal-img-wrap {
        text-align: center;
        margin-bottom: 25px;
        background: #1a1a1a;
        border-radius: 2px;
      }
      .modal-img-wrap img {
        width: auto;
        max-width: 100%;
        max-height: 500px;
        object-fit: contain;
        display: inline-block;
      }

      .modal-info table {
        width: 100%;
        border-collapse: collapse;
      }
      .modal-info th {
        text-align: left;
        padding: 9px 12px;
        color: rgba(255,255,255,0.35);
        font-size: 0.8rem;
        width: 80px;
        border-bottom: 1px solid #2a2a2a;
        font-weight: normal;
        letter-spacing: 0.1em;
      }
      .modal-info td {
        padding: 9px 12px;
        font-size: 0.9rem;
        border-bottom: 1px solid #2a2a2a;
        color: rgba(255,255,255,0.8);
      }
      .modal-description {
        margin-top: 20px;
        padding: 18px;
        background: #222;
        border-radius: 4px;
        font-size: 0.88rem;
        line-height: 1.8;
        color: rgba(255,255,255,0.6);
      }
    </style>
  </head>
  <body>

    <!-- 常に上部に表示されるヘッダー -->
    <header class="site-header">
      <div class="header-logo">{headerTitle}</div>
      <nav class="header-nav">
        <a href="#" id="navTop">TOP</a>
        <a href="#" onclick="alert('概要ページは準備中です。'); return false;">概要</a>
        <a href="#" id="navExhibition">展示室</a>
        <a href="#" onclick="alert('商品販売ページは準備中です。'); return false;">商品販売</a>
      </nav>
    </header>

    <!-- エントランス画面 -->
    <div class="entrance" id="entrance">
      <h1>{title}</h1>
      <p>TOKUNAGA ART MUSEUM</p>
      <button class="enter-btn" id="enterBtn">― 入　館 ―</button>
    </div>

    <!-- 展示室選択画面 -->
    <div class="room-selector hidden" id="roomSelector">
      <h2>展示室を選択</h2>
      <div class="room-list">
        {roomNames.map(room => (
          <button class="room-btn" data-room={room.id} data-name={room.name}>
            {room.prefix}{room.name}
          </button>
        ))}
      </div>
      <button class="back-btn" id="backToTopFromSelector">← TOPへ戻る</button>
    </div>

    <!-- メインギャラリー画面 -->
    <div class="museum" id="museum">
      <div class="museum-header">
        <h2 id="museumTitle">{title}</h2>
        <div class="count" id="museumCount">{categorizedArtworks.length} WORKS</div>
      </div>

      <div class="scroll-hint">← 左右にスクロール →</div>

      <div class="gallery-track-wrapper">
        <button class="scroll-arrow left" id="arrowLeft">‹</button>
        <div class="gallery-track" id="galleryTrack">
          {categorizedArtworks.map((info) => (
            <div
              class="artwork-card"
              style={`width: ${getCardWidth(info.size)}px;`}
              data-category={info.category}
              data-file={info.file}
              data-title={info.title}
              data-artist={info.artist}
              data-year={info.year}
              data-size={info.size}
              data-description={info.description}
            >
              <div class="artwork-frame">
                <img src={`${base}/gallery/${info.file}`} alt={info.title} loading="lazy" />
              </div>
              <div class="artwork-label">
                <div class="artwork-title">{info.title}</div>
                <div class="artwork-artist">{info.artist}</div>
              </div>
            </div>
          ))}
        </div>
        <button class="scroll-arrow right" id="arrowRight">›</button>
      </div>
    </div>

    <!-- 作品詳細モーダル -->
    <div class="modal-overlay" id="modalOverlay">
      <div class="modal">
        <button class="modal-close" id="modalClose">✕</button>
        <div class="modal-img-wrap">
          <img id="modalImg" src="" alt="" />
        </div>
        <div class="modal-info">
          <table>
            <tr><th>タイトル</th><td id="modalTitle"></td></tr>
            <tr><th>作者</th><td id="modalArtist"></td></tr>
            <tr><th>制作年</th><td id="modalYear"></td></tr>
            <tr><th>サイズ</th><td id="modalSize"></td></tr>
          </table>
          <div class="modal-description" id="modalDescription"></div>
        </div>
      </div>
    </div>

    <script>
      const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') ?? '';

      // --- 画面切り替えのロジック ---
      const entrance = document.getElementById('entrance');
      const roomSelector = document.getElementById('roomSelector');
      const museum = document.getElementById('museum');
      const galleryTrack = document.getElementById('galleryTrack');

      // 展示室選択画面を開く
      function openRoomSelector() {
        entrance.classList.add('hidden');
        museum.classList.remove('visible');
        roomSelector.classList.remove('hidden');
      }

      // 選択画面からTOP（エントランス）へ戻る
      function closeRoomSelector() {
        roomSelector.classList.add('hidden');
        entrance.classList.remove('hidden');
      }

      // TOPへ強制的に戻る
      function goToTop() {
        roomSelector.classList.add('hidden');
        museum.classList.remove('visible');
        entrance.classList.remove('hidden');
      }

      // ボタンやナビゲーションへのイベント紐付け
      document.getElementById('enterBtn').addEventListener('click', openRoomSelector);
      
      document.getElementById('navExhibition').addEventListener('click', (e) => {
        e.preventDefault();
        openRoomSelector();
      });

      document.getElementById('navTop').addEventListener('click', (e) => {
        e.preventDefault();
        goToTop();
      });
      
      document.getElementById('backToTopFromSelector').addEventListener('click', closeRoomSelector);


      // --- 展示室（カテゴリ）選択のロジック ---
      document.querySelectorAll('.room-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const roomId = parseInt(btn.dataset.room, 10);
          const roomName = btn.dataset.name;
          
          // 3番以降は整理中としてアラートを表示
          if (roomId >= 3 && roomId <= 7) {
            alert('現在整理中です。');
            return;
          }
          
          // 選択された展示室に紐づく作品のみを抽出（フィルタリング）
          const cards = document.querySelectorAll('.artwork-card');
          let count = 0;
          cards.forEach(card => {
            if (card.dataset.category === String(roomId)) {
              card.style.display = ''; // CSSのデフォルトに戻して表示
              count++;
            } else {
              card.style.display = 'none'; // 条件外の作品は非表示
            }
          });

          // ヘッダー情報（タイトルと作品数）の更新
          document.getElementById('museumTitle').textContent = `展示室：${roomName}`;
          document.getElementById('museumCount').textContent = `${count} WORKS`;

          // スクロール位置の初期化 (アニメーションを一旦切って一瞬で戻す)
          galleryTrack.style.scrollBehavior = 'auto';
          galleryTrack.scrollLeft = 0;
          setTimeout(() => {
            galleryTrack.style.scrollBehavior = 'smooth';
          }, 50);

          // ギャラリー画面へ遷移
          roomSelector.classList.add('hidden');
          museum.classList.add('visible');
        });
      });


      // --- 横スクロールのロジック ---
      const track = document.getElementById('galleryTrack');
      document.getElementById('arrowLeft').addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });
      document.getElementById('arrowRight').addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });

      let isDragging = false;
      let startX = 0;
      let scrollLeft = 0;
      track.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });
      document.addEventListener('mouseup', () => { isDragging = false; });
      track.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        track.scrollLeft = scrollLeft - (x - startX);
      });


      // --- モーダルのロジック ---
      document.querySelectorAll('.artwork-card').forEach(card => {
        card.addEventListener('click', () => {
          document.getElementById('modalImg').src = base + '/gallery/' + card.dataset.file;
          document.getElementById('modalImg').alt = card.dataset.title;
          document.getElementById('modalTitle').textContent = card.dataset.title;
          document.getElementById('modalArtist').textContent = card.dataset.artist;
          document.getElementById('modalYear').textContent = card.dataset.year;
          document.getElementById('modalSize').textContent = card.dataset.size;
          document.getElementById('modalDescription').textContent = card.dataset.description;
          document.getElementById('modalOverlay').classList.add('active');
        });
      });

      document.getElementById('modalOverlay').addEventListener('click', (e) => {
        if (e.target === document.getElementById('modalOverlay')) {
          document.getElementById('modalOverlay').classList.remove('active');
        }
      });
      document.getElementById('modalClose').addEventListener('click', () => {
        document.getElementById('modalOverlay').classList.remove('active');
      });
    </script>
  </body>
</html>
