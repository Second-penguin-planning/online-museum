---
import artworks from '../data/artworks.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = "デジタル・アーカイブ美術館";

// サイズ文字列 "120 × 80 cm" → アスペクト比を計算するヘルパー
function parseAspectRatio(sizeStr: string): { w: number; h: number } | null {
  if (!sizeStr) return null;
  // "120 × 80 cm" / "120x80" / "120 cm × 80 cm" などに対応
  const match = sizeStr.match(/([\d.]+)\s*[×xX×]\s*([\d.]+)/);
  if (!match) return null;
  const w = parseFloat(match[1]);
  const h = parseFloat(match[2]);
  if (!w || !h) return null;
  return { w, h };
}

// カードの基準幅(px)
const BASE_WIDTH = 260;
const MAX_HEIGHT = 420;

function cardHeight(sizeStr: string): number {
  const ratio = parseAspectRatio(sizeStr);
  if (!ratio) return 320; // フォールバック
  const h = Math.round((BASE_WIDTH * ratio.h) / ratio.w);
  return Math.min(h, MAX_HEIGHT);
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="base-url" content={base} />
    <title>{title}</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: "Helvetica Neue", Arial, sans-serif; background: #111; color: #fff; overflow-x: hidden; }

      /* ========== エントランス ========== */
      .entrance {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: radial-gradient(ellipse at center, #1a1a2e 0%, #0d0d0d 70%);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 999;
        transition: opacity 1.2s ease, visibility 1.2s ease;
      }
      .entrance.hidden { opacity: 0; visibility: hidden; }
      .entrance-decoration { display: flex; gap: 30px; margin-bottom: 50px; }
      .entrance-decoration .frame {
        width: 80px; height: 100px;
        border: 2px solid rgba(255,255,255,0.3);
        background: rgba(255,255,255,0.05);
        border-radius: 2px;
        animation: float 3s ease-in-out infinite;
      }
      .entrance-decoration .frame:nth-child(2) { animation-delay: 0.5s; height: 120px; }
      .entrance-decoration .frame:nth-child(3) { animation-delay: 1s; }
      @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
      }
      .entrance h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        letter-spacing: 0.3em; text-align: center;
        margin-bottom: 15px; font-weight: 300;
        background: linear-gradient(135deg, #fff 0%, #aaa 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      }
      .entrance p { font-size: 0.9rem; letter-spacing: 0.2em; color: rgba(255,255,255,0.4); margin-bottom: 60px; }
      .enter-btn {
        padding: 16px 50px;
        border: 1px solid rgba(255,255,255,0.5);
        background: transparent; color: #fff;
        font-size: 0.9rem; letter-spacing: 0.3em;
        cursor: pointer; transition: all 0.4s; border-radius: 2px;
      }
      .enter-btn:hover { background: rgba(255,255,255,0.1); border-color: #fff; transform: scale(1.05); }

      /* ========== メインギャラリー ========== */
      .museum { opacity: 0; transition: opacity 1.2s ease; min-height: 100vh; }
      .museum.visible { opacity: 1; }
      .museum-header {
        text-align: center; padding: 50px 20px 30px;
        background: linear-gradient(180deg, #1a1a1a 0%, #111 100%);
      }
      .museum-header h2 { font-size: 1.2rem; letter-spacing: 0.4em; font-weight: 300; color: rgba(255,255,255,0.6); }
      .museum-header .count { font-size: 0.8rem; color: rgba(255,255,255,0.3); margin-top: 8px; letter-spacing: 0.2em; }

      /* ========== 横スクロール ========== */
      .scroll-hint {
        text-align: center; padding: 10px;
        font-size: 0.75rem; color: rgba(255,255,255,0.25);
        letter-spacing: 0.2em; animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.8; } }

      .gallery-track-wrapper { position: relative; padding: 40px 0 60px; }
      .gallery-track {
        display: flex;
        /* カードの高さが異なるため、下揃えにして額縁ラインを統一感ある見た目に */
        align-items: flex-end;
        gap: 40px;
        padding: 20px 80px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
        cursor: grab;
      }
      .gallery-track:active { cursor: grabbing; }
      .gallery-track::-webkit-scrollbar { display: none; }

      .scroll-arrow {
        position: absolute; top: 50%; transform: translateY(-50%);
        background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
        color: #fff; width: 50px; height: 50px; border-radius: 50%;
        font-size: 1.2rem; cursor: pointer; z-index: 10;
        transition: all 0.3s; display: flex; align-items: center; justify-content: center;
      }
      .scroll-arrow:hover { background: rgba(255,255,255,0.25); }
      .scroll-arrow.left { left: 15px; }
      .scroll-arrow.right { right: 15px; }

      /* ========== 絵カード ========== */
      .artwork-card {
        flex: 0 0 auto;
        width: 260px;
        cursor: pointer;
        transition: transform 0.3s;
      }
      .artwork-card:hover { transform: translateY(-8px); }

      .artwork-frame {
        /* ① 白背景を透過させるため背景を暗色に */
        background: #1a1a1a;
        border: 8px solid #2a2a2a;
        box-shadow:
          0 0 0 1px #444,
          inset 0 0 20px rgba(0,0,0,0.5),
          0 20px 60px rgba(0,0,0,0.6);
        border-radius: 2px;
        overflow: hidden;
        position: relative;
      }
      .artwork-frame::before {
        content: '';
        position: absolute; inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, transparent 50%);
        z-index: 1; pointer-events: none;
      }

      /* ② 実際のサイズ比率に合わせた高さを data 属性で各カードに設定 */
      .artwork-frame img {
        width: 100%;
        /* height は各カードの style で上書き */
        object-fit: contain;
        display: block;

        /* ① 白い部分を透明化: multiply で白(#fff)を背景色と合成 */
        mix-blend-mode: multiply;
        /* multiply だけでは暗い背景上では不十分な場合があるため
           さらに luminosity で明度の高い部分を抑える */
        /* → multiply のみで十分な場合が多い。必要に応じてコメント解除 */
      }

      .artwork-label { text-align: center; margin-top: 15px; padding: 0 5px; }
      .artwork-label .artwork-title { font-size: 0.85rem; color: rgba(255,255,255,0.8); letter-spacing: 0.05em; }
      .artwork-label .artwork-artist { font-size: 0.75rem; color: rgba(255,255,255,0.35); margin-top: 4px; }

      /* ========== モーダル ========== */
      .modal-overlay {
        display: none; position: fixed; top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0,0,0,0.92);
        z-index: 2000; justify-content: center; align-items: center;
      }
      .modal-overlay.active { display: flex; }
      .modal {
        background: #1a1a1a; border: 1px solid #333; border-radius: 4px;
        max-width: 720px; width: 92%; max-height: 90vh;
        overflow-y: auto; padding: 35px; position: relative; color: #fff;
      }
      .modal-close {
        position: absolute; top: 15px; right: 20px;
        font-size: 1.3rem; cursor: pointer;
        background: none; border: none; color: rgba(255,255,255,0.5); transition: color 0.2s;
      }
      .modal-close:hover { color: #fff; }

      /* モーダル内の画像コンテナ：実際の比率を保持 */
      .modal-img-wrap {
        width: 100%;
        max-height: 420px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 25px;
        /* ① 暗背景上で multiply を適用 */
        background: #1a1a1a;
        border-radius: 2px;
        overflow: hidden;
      }
      .modal-img-wrap img {
        /* ② 実際の縦横比を保持 */
        max-width: 100%;
        max-height: 420px;
        width: auto;
        height: auto;
        display: block;
        /* ① 白を透明化 */
        mix-blend-mode: multiply;
      }

      .modal-info table { width: 100%; border-collapse: collapse; }
      .modal-info th {
        text-align: left; padding: 9px 12px;
        color: rgba(255,255,255,0.35); font-size: 0.8rem;
        width: 80px; border-bottom: 1px solid #2a2a2a;
        font-weight: normal; letter-spacing: 0.1em;
      }
      .modal-info td { padding: 9px 12px; font-size: 0.9rem; border-bottom: 1px solid #2a2a2a; color: rgba(255,255,255,0.8); }
      .modal-description {
        margin-top: 20px; padding: 18px; background: #222; border-radius: 4px;
        font-size: 0.88rem; line-height: 1.8; color: rgba(255,255,255,0.6);
      }

      /* サイズ表示バー（モーダル） */
      .size-indicator {
        margin-top: 6px;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.3);
        letter-spacing: 0.05em;
        text-align: center;
      }
    </style>
  </head>
  <body>

    <!-- エントランス -->
    <div class="entrance" id="entrance">
      <div class="entrance-decoration">
        <div class="frame"></div>
        <div class="frame"></div>
        <div class="frame"></div>
      </div>
      <h1>{title}</h1>
      <p>DIGITAL ARCHIVE MUSEUM</p>
      <button class="enter-btn" id="enterBtn">― 入　館 ―</button>
    </div>

    <!-- メインギャラリー -->
    <div class="museum" id="museum">
      <div class="museum-header">
        <h2>{title}</h2>
        <div class="count">{artworks.length} WORKS</div>
      </div>

      <div class="scroll-hint">← 左右にスクロール →</div>

      <div class="gallery-track-wrapper">
        <button class="scroll-arrow left" id="arrowLeft">‹</button>
        <div class="gallery-track" id="galleryTrack">
          {artworks.map((info) => {
            const h = cardHeight(info.size);
            return (
              <div
                class="artwork-card"
                data-file={info.file}
                data-title={info.title}
                data-artist={info.artist}
                data-year={info.year}
                data-size={info.size}
                data-description={info.description}
              >
                <div class="artwork-frame">
                  {/* ② style で高さを実際の比率に設定 */}
                  <img
                    src={`${base}/gallery/${info.file}`}
                    alt={info.title}
                    loading="lazy"
                    style={`height: ${h}px;`}
                  />
                </div>
                <div class="artwork-label">
                  <div class="artwork-title">{info.title}</div>
                  <div class="artwork-artist">{info.artist}</div>
                </div>
              </div>
            );
          })}
        </div>
        <button class="scroll-arrow right" id="arrowRight">›</button>
      </div>
    </div>

    <!-- モーダル -->
    <div class="modal-overlay" id="modalOverlay">
      <div class="modal">
        <button class="modal-close" id="modalClose">✕</button>
        <div class="modal-img-wrap" id="modalImgWrap">
          <img id="modalImg" src="" alt="" />
        </div>
        <div class="size-indicator" id="modalSizeIndicator"></div>
        <div class="modal-info">
          <table>
            <tr><th>タイトル</th><td id="modalTitle"></td></tr>
            <tr><th>作者</th><td id="modalArtist"></td></tr>
            <tr><th>制作年</th><td id="modalYear"></td></tr>
            <tr><th>サイズ</th><td id="modalSize"></td></tr>
          </table>
          <div class="modal-description" id="modalDescription"></div>
        </div>
      </div>
    </div>

    <script>
      const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') ?? '';

      // ── エントランス ──
      document.getElementById('enterBtn').addEventListener('click', () => {
        document.getElementById('entrance').classList.add('hidden');
        document.getElementById('museum').classList.add('visible');
      });

      // ── 矢印スクロール ──
      const track = document.getElementById('galleryTrack');
      document.getElementById('arrowLeft').addEventListener('click', () => track.scrollBy({ left: -320, behavior: 'smooth' }));
      document.getElementById('arrowRight').addEventListener('click', () => track.scrollBy({ left: 320, behavior: 'smooth' }));

      // ── ドラッグスクロール ──
      let isDragging = false, startX = 0, scrollLeft = 0;
      track.addEventListener('mousedown', (e) => { isDragging = true; startX = e.pageX - track.offsetLeft; scrollLeft = track.scrollLeft; });
      document.addEventListener('mouseup', () => { isDragging = false; });
      track.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        e.preventDefault();
        track.scrollLeft = scrollLeft - (e.pageX - track.offsetLeft - startX);
      });

      // ── サイズ文字列 → アスペクト比 ──
      function parseRatio(sizeStr) {
        if (!sizeStr) return null;
        const m = sizeStr.match(/([\d.]+)\s*[×xX×]\s*([\d.]+)/);
        if (!m) return null;
        return { w: parseFloat(m[1]), h: parseFloat(m[2]) };
      }

      // ── モーダル ──
      document.querySelectorAll('.artwork-card').forEach(card => {
        card.addEventListener('click', () => {
          const file = card.dataset.file;
          const sizeStr = card.dataset.size;

          const img = document.getElementById('modalImg');
          img.src = base + '/gallery/' + file;
          img.alt = card.dataset.title;

          // ② モーダル内でも比率を保持（CSS の max-width/max-height で自動調整）
          img.style.width = 'auto';
          img.style.height = 'auto';

          // アスペクト比ヒント表示
          const ratio = parseRatio(sizeStr);
          const indicator = document.getElementById('modalSizeIndicator');
          indicator.textContent = ratio
            ? `縦横比 ${ratio.w} : ${ratio.h}（原寸 ${sizeStr}）`
            : '';

          document.getElementById('modalTitle').textContent = card.dataset.title;
          document.getElementById('modalArtist').textContent = card.dataset.artist;
          document.getElementById('modalYear').textContent = card.dataset.year;
          document.getElementById('modalSize').textContent = sizeStr;
          document.getElementById('modalDescription').textContent = card.dataset.description;
          document.getElementById('modalOverlay').classList.add('active');
        });
      });

      document.getElementById('modalOverlay').addEventListener('click', (e) => {
        if (e.target === document.getElementById('modalOverlay'))
          document.getElementById('modalOverlay').classList.remove('active');
      });
      document.getElementById('modalClose').addEventListener('click', () => {
        document.getElementById('modalOverlay').classList.remove('active');
      });
    </script>
  </body>
</html>
