---
export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } },
  ];
}

const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="base-url" content={base} />
  <title>保管庫 | Tokunaga Art Museum</title>

  <style>
    /* ========== リセット & 基本 ========== */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --crimson-deep:  #4a0a0a;
      --crimson-mid:   #6b1212;
      --crimson-rich:  #8b1a1a;
      --crimson-warm:  #a52020;
      --gold-dim:      #b8960c;
      --gold-bright:   #d4af37;
      --gold-light:    #e8cc6a;
      --text-main:     #f0e6d3;
      --text-sub:      #c4a882;
      --text-muted:    #7a6452;
    }

    body {
      font-family: "Garamond", "Times New Roman", "游明朝", serif;
      background: var(--crimson-deep);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ========== ヘッダー ========== */
    .site-header {
      position: fixed;
      top: 0; left: 0;
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 50px;
      z-index: 1000;
      background: linear-gradient(
        to bottom,
        rgba(20, 4, 4, 0.95) 0%,
        rgba(20, 4, 4, 0.0) 100%
      );
      border-bottom: 1px solid rgba(212, 175, 55, 0.15);
    }

    .header-logo {
      font-size: 1.1rem;
      letter-spacing: 0.25em;
      font-weight: 400;
      color: var(--gold-bright);
      text-shadow: 0 2px 12px rgba(0,0,0,0.9);
      flex-shrink: 0;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .header-nav a {
      color: var(--text-sub);
      text-decoration: none;
      font-size: 0.82rem;
      letter-spacing: 0.15em;
      opacity: 0.85;
      transition: opacity 0.3s, color 0.3s, transform 0.3s;
      text-shadow: 0 2px 8px rgba(0,0,0,0.9);
      white-space: nowrap;
    }

    .header-nav a:hover {
      opacity: 1;
      color: var(--gold-light);
      transform: translateY(-1px);
    }

    .header-nav a.current {
      opacity: 1;
      color: var(--gold-bright);
    }

    .lang-switcher {
      display: flex;
      gap: 12px;
      border-left: 1px solid rgba(212, 175, 55, 0.3);
      padding-left: 18px;
      margin-left: 8px;
    }

    .lang-switcher a {
      font-size: 0.75rem;
      text-decoration: none;
      color: var(--text-sub);
      opacity: 0.55;
      letter-spacing: 0.1em;
      transition: opacity 0.3s, color 0.3s;
    }

    .lang-switcher a.active {
      opacity: 1;
      font-weight: bold;
      color: var(--gold-bright);
    }

    /* ========== ハンバーガー ========== */
    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      background: none;
      border: 1px solid rgba(212, 175, 55, 0.3);
      cursor: pointer;
      padding: 8px;
      flex-shrink: 0;
      transition: border-color 0.3s;
      z-index: 1100;
      position: relative;
    }

    .hamburger:hover { border-color: var(--gold-bright); }

    .hamburger span {
      display: block;
      width: 22px;
      height: 1.5px;
      background: var(--gold-bright);
      transition: transform 0.35s ease, opacity 0.35s ease;
      transform-origin: center;
    }

    .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

    /* ========== モバイルメニュー ========== */
    .mobile-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 1040;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease, visibility 0.4s ease;
      pointer-events: none;
    }

    .mobile-overlay.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .mobile-menu {
      position: fixed;
      top: 0; right: 0;
      width: min(280px, 80vw);
      height: 100%;
      background: linear-gradient(
        160deg,
        rgba(20, 4, 4, 0.98) 0%,
        rgba(50, 8, 8, 0.98) 100%
      );
      border-left: 1px solid rgba(212, 175, 55, 0.2);
      z-index: 1050;
      flex-direction: column;
      padding: 80px 32px 40px;
      gap: 0;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1);
      box-shadow: -8px 0 30px rgba(0,0,0,0.6);
      display: flex;
      pointer-events: none;
    }

    .mobile-menu.open {
      transform: translateX(0);
      pointer-events: auto;
    }

    .mobile-menu-nav {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .mobile-menu-nav a {
      display: block;
      border-bottom: 1px solid rgba(212, 175, 55, 0.12);
      color: var(--text-sub);
      font-family: inherit;
      font-size: 0.88rem;
      letter-spacing: 0.2em;
      padding: 18px 0;
      text-decoration: none;
      transition: color 0.3s, padding-left 0.3s;
    }

    .mobile-menu-nav a:first-child { border-top: 1px solid rgba(212, 175, 55, 0.12); }
    .mobile-menu-nav a:hover { color: var(--gold-light); padding-left: 8px; }
    .mobile-menu-nav a.current { color: var(--gold-bright); }

    .mobile-lang-switcher {
      display: flex;
      gap: 16px;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid rgba(212, 175, 55, 0.2);
    }

    .mobile-lang-switcher a {
      font-size: 0.8rem;
      text-decoration: none;
      color: var(--text-sub);
      opacity: 0.55;
      letter-spacing: 0.12em;
      transition: opacity 0.3s, color 0.3s;
    }

    .mobile-lang-switcher a.active {
      opacity: 1;
      font-weight: bold;
      color: var(--gold-bright);
    }

    /* ========== パスワード画面 ========== */
    #password-screen {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      gap: 1.8rem;
      padding: 20px;

      background:
        linear-gradient(
          160deg,
          rgba(30, 4, 4, 0.92) 0%,
          rgba(74, 10, 10, 0.85) 50%,
          rgba(30, 4, 4, 0.95) 100%
        ),
        repeating-linear-gradient(
          45deg,
          rgba(0,0,0,0.03) 0px,
          rgba(0,0,0,0.03) 1px,
          transparent 1px,
          transparent 8px
        );
    }

    .lock-frame {
      position: relative;
      width: min(420px, 88vw);
      padding: 60px 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.6rem;
    }

    /* 二重枠線 */
    .lock-frame::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1px solid rgba(212, 175, 55, 0.3);
      pointer-events: none;
    }

    .lock-frame::after {
      content: '';
      position: absolute;
      inset: 8px;
      border: 1px solid rgba(212, 175, 55, 0.12);
      pointer-events: none;
    }

    .lock-icon-wrap {
      font-size: 2.4rem;
      color: var(--gold-dim);
      animation: glow 2.5s ease-in-out infinite;
    }

    @keyframes glow {
      0%, 100% { text-shadow: 0 0 8px rgba(212, 175, 55, 0.3); }
      50%       { text-shadow: 0 0 24px rgba(212, 175, 55, 0.7); }
    }

    .lock-eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.45em;
      color: var(--gold-dim);
      text-transform: uppercase;
    }

    .lock-title {
      font-size: clamp(1.4rem, 5vw, 2rem);
      font-weight: 400;
      letter-spacing: 0.35em;
      color: var(--text-main);
      text-shadow: 0 2px 20px rgba(0,0,0,0.8);
    }

    .lock-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
    }

    .lock-divider::before,
    .lock-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
    }

    .lock-divider-diamond {
      width: 5px;
      height: 5px;
      background: var(--gold-dim);
      transform: rotate(45deg);
      flex-shrink: 0;
    }

    #pw-input {
      background: rgba(74, 10, 10, 0.4);
      border: 1px solid rgba(212, 175, 55, 0.3);
      color: var(--text-main);
      font-family: "Garamond", "Times New Roman", serif;
      font-size: 1.8rem;
      letter-spacing: 0.6em;
      padding: 0.6rem 1.2rem;
      text-align: center;
      width: 180px;
      outline: none;
      transition: border-color 0.3s, box-shadow 0.3s;
    }

    #pw-input:focus {
      border-color: var(--gold-bright);
      box-shadow: 0 0 16px rgba(212, 175, 55, 0.2);
    }

    #pw-input.error {
      border-color: #c04040;
      animation: shake 0.35s ease;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25%       { transform: translateX(-10px); }
      75%       { transform: translateX(10px); }
    }

    #pw-error {
      color: #c06060;
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      min-height: 1.2em;
      text-align: center;
    }

    /* 入室ボタン（index.astroのenter-btnと同系） */
    .enter-btn {
      position: relative;
      padding: 13px 44px;
      background: transparent;
      color: var(--gold-bright);
      font-family: inherit;
      font-size: 0.8rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      cursor: pointer;
      border: none;
      overflow: hidden;
      transition: color 0.45s ease;
      min-height: 44px;
      -webkit-tap-highlight-color: transparent;
    }

    .enter-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1px solid var(--gold-dim);
      transition: border-color 0.45s ease;
    }

    .enter-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--gold-bright);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.45s cubic-bezier(0.76, 0, 0.24, 1);
      z-index: -1;
    }

    .enter-btn:hover { color: var(--crimson-deep); }
    .enter-btn:hover::before { border-color: var(--gold-bright); }
    .enter-btn:hover::after  { transform: scaleX(1); }

    /* ========== 保管庫メイン ========== */
    #storage-main {
      display: none;
      padding: 120px 40px 80px;
      max-width: 1200px;
      margin: 0 auto;
    }

    /* ページタイトル */
    .storage-page-header {
      text-align: center;
      margin-bottom: 60px;
      position: relative;
    }

    .storage-page-eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.5em;
      color: var(--gold-dim);
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .storage-page-title {
      font-size: clamp(1.4rem, 4vw, 2.2rem);
      font-weight: 400;
      letter-spacing: 0.3em;
      color: var(--text-main);
      margin-bottom: 20px;
    }

    .storage-page-header::after {
      content: '';
      display: block;
      width: 80px;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
      margin: 0 auto;
    }

    /* ===== アーティストセクション ===== */
    .artist-section {
      margin-bottom: 70px;
    }

    .artist-header {
      display: flex;
      align-items: baseline;
      gap: 16px;
      margin-bottom: 24px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      position: relative;
    }

    .artist-header::before {
      content: '';
      position: absolute;
      left: 0;
      bottom: -1px;
      width: 60px;
      height: 1px;
      background: var(--gold-bright);
    }

    .artist-name-ja {
      font-size: clamp(1.1rem, 3vw, 1.4rem);
      font-weight: 400;
      letter-spacing: 0.2em;
      color: var(--text-main);
    }

    .artist-name-en {
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      color: var(--text-muted);
    }

    /* ===== カテゴリタブ ===== */
    .category-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 28px;
    }

    /* room-btnと同系デザイン */
    .tab-btn {
      position: relative;
      padding: 10px 22px;
      background: rgba(74, 10, 10, 0.35);
      color: var(--text-sub);
      font-family: inherit;
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      cursor: pointer;
      border: none;
      text-align: left;
      transition: color 0.3s, background 0.3s;
      overflow: hidden;
      -webkit-tap-highlight-color: transparent;
      min-height: 40px;
    }

    .tab-btn::before {
      content: '';
      position: absolute;
      left: 0; top: 0;
      width: 3px;
      height: 100%;
      background: var(--gold-dim);
      transform: scaleY(0);
      transform-origin: bottom;
      transition: transform 0.3s cubic-bezier(0.76, 0, 0.24, 1);
    }

    .tab-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      border: 1px solid rgba(212, 175, 55, 0.25);
      transition: border-color 0.3s;
    }

    .tab-btn:hover,
    .tab-btn.active {
      background: rgba(139, 26, 26, 0.55);
      color: var(--gold-light);
    }

    .tab-btn:hover::before,
    .tab-btn.active::before {
      transform: scaleY(1);
    }

    .tab-btn:hover::after,
    .tab-btn.active::after {
      border-color: rgba(212, 175, 55, 0.55);
    }

    .tab-btn.active {
      color: var(--gold-bright);
    }

    /* ===== カテゴリパネル ===== */
    .category-panel {
      display: none;
    }

    .category-panel.active {
      display: block;
    }

    /* ===== ギャラリーグリッド ===== */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 20px;
    }

    .gallery-item {
      cursor: pointer;
      transition: transform 0.3s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .gallery-item:hover {
      transform: translateY(-5px);
    }

    /* index.astroのartwork-frameと同系 */
    .gallery-frame {
      border-style: solid;
      border-width: 10px;
      border-color:
        hsl(30, 45%, 36%)
        hsl(30, 45%, 20%)
        hsl(30, 45%, 20%)
        hsl(30, 45%, 36%);
      border-radius: 4px;
      box-shadow:
        6px 8px 20px rgba(0,0,0,0.7),
        0 0 0 1px rgba(0,0,0,0.4),
        inset 0 0 12px rgba(0,0,0,0.3);
    }

    .gallery-frame img {
      display: block;
      width: 100%;
      aspect-ratio: 3/4;
      object-fit: cover;
    }

    .gallery-item-label {
      text-align: center;
      margin-top: 10px;
      font-size: 0.68rem;
      color: var(--text-muted);
      letter-spacing: 0.06em;
    }

    /* 空メッセージ */
    .empty-msg {
      text-align: center;
      padding: 50px 0;
      color: var(--text-muted);
      font-size: 0.82rem;
      letter-spacing: 0.3em;
    }

    /* ===== セクション区切り ===== */
    .section-divider {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 50px 0;
    }

    .section-divider::before,
    .section-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(212, 175, 55, 0.2), transparent);
    }

    .section-divider-diamond {
      width: 5px;
      height: 5px;
      background: var(--gold-dim);
      transform: rotate(45deg);
      flex-shrink: 0;
      opacity: 0.6;
    }

    /* ========== ライトボックス ========== */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10, 2, 2, 0.93);
      z-index: 2000;
      justify-content: center;
      align-items: center;
      backdrop-filter: blur(4px);
      padding: 16px;
    }

    .modal-overlay.active { display: flex; }

    .modal {
      background: linear-gradient(160deg, #1e0808 0%, #150404 100%);
      border: 1px solid rgba(212, 175, 55, 0.2);
      padding: 32px 24px;
      max-width: 700px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
      box-shadow:
        0 30px 80px rgba(0,0,0,0.8),
        inset 0 1px 0 rgba(212, 175, 55, 0.1);
      -webkit-overflow-scrolling: touch;
    }

    .modal-close {
      position: absolute;
      top: 12px; right: 14px;
      background: none;
      border: 1px solid rgba(212, 175, 55, 0.25);
      color: var(--text-sub);
      font-size: 1rem;
      width: 34px;
      height: 34px;
      cursor: pointer;
      transition: border-color 0.3s, color 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-close:hover {
      border-color: var(--gold-bright);
      color: var(--gold-bright);
    }

    .modal-img-wrap {
      text-align: center;
      margin-bottom: 16px;
    }

    .modal-img-wrap img {
      max-width: 100%;
      max-height: 55vh;
      object-fit: contain;
    }

    /* ========== レスポンシブ ========== */
    @media (max-width: 768px) {
      .site-header { padding: 12px 18px; }
      .header-logo { font-size: 0.82rem; letter-spacing: 0.15em; }
      .header-nav  { display: none; }
      .hamburger   { display: flex; }

      #storage-main { padding: 90px 20px 60px; }

      .lock-frame { padding: 44px 28px; }

      .gallery-grid {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 14px;
      }
    }

    @media (max-width: 480px) {
      .category-tabs { gap: 6px; }
      .tab-btn { font-size: 0.72rem; padding: 8px 14px; }
      .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>

  <!-- ========== ヘッダー ========== -->
  <header class="site-header">
    <div class="header-logo">TOKUNAGA ART MUSEUM</div>

    <!-- PC用ナビ -->
    <nav class="header-nav">
      <a href={`${base}/${lang}/`}>ギャラリー</a>
      <a href={`${base}/${lang}/about/`}>アバウト</a>
      <a href={`${base}/${lang}/storage/`} class="current">保管庫</a>
      <div class="lang-switcher">
        <a href={`${base}/ja/storage/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
        <a href={`${base}/en/storage/`} class={lang === 'en' ? 'active' : ''}>EN</a>
        <a href={`${base}/sp/storage/`} class={lang === 'sp' ? 'active' : ''}>SP</a>
      </div>
    </nav>

    <!-- ハンバーガーボタン -->
    <button class="hamburger" id="hamburgerBtn" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- モバイルオーバーレイ -->
  <div class="mobile-overlay" id="mobileOverlay"></div>

  <!-- モバイルメニュー -->
  <div class="mobile-menu" id="mobileMenu">
    <nav class="mobile-menu-nav">
      <a href={`${base}/${lang}/`}>ギャラリー</a>
      <a href={`${base}/${lang}/about/`}>アバウト</a>
      <a href={`${base}/${lang}/storage/`} class="current">保管庫</a>
    </nav>
    <div class="mobile-lang-switcher">
      <a href={`${base}/ja/storage/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
      <a href={`${base}/en/storage/`} class={lang === 'en' ? 'active' : ''}>EN</a>
      <a href={`${base}/sp/storage/`} class={lang === 'sp' ? 'active' : ''}>SP</a>
    </div>
  </div>

  <!-- ========== パスワード画面 ========== -->
  <div id="password-screen">
    <div class="lock-frame">
      <div class="lock-icon-wrap">🔒</div>
      <p class="lock-eyebrow">RESTRICTED ACCESS</p>
      <h1 class="lock-title">保 管 庫</h1>
      <div class="lock-divider">
        <div class="lock-divider-diamond"></div>
      </div>
      <input
        id="pw-input"
        type="password"
        maxlength="10"
        placeholder="· · · ·"
        autocomplete="off"
      />
      <p id="pw-error"></p>
      <button class="enter-btn" id="enterBtn">入 室 す る</button>
    </div>
  </div>

  <!-- ========== 保管庫メイン ========== -->
  <div id="storage-main">

    <div class="storage-page-header">
      <p class="storage-page-eyebrow">STORAGE COLLECTION</p>
      <h2 class="storage-page-title">保 管 庫</h2>
    </div>

    <!-- ===== 徳永 卓磨 ===== -->
    <section class="artist-section">
      <div class="artist-header">
        <span class="artist-name-ja">徳永 卓磨</span>
        <span class="artist-name-en">Takuma Tokunaga</span>
      </div>

      <div class="category-tabs" data-artist="takuma">
        <button class="tab-btn active" data-cat="ijinkan">異人館</button>
        <button class="tab-btn"        data-cat="kobe">神戸</button>
        <button class="tab-btn"        data-cat="spain">スペイン</button>
        <button class="tab-btn"        data-cat="seibutsu">静物</button>
      </div>

      <!-- 異人館 -->
      <div class="category-panel active" id="takuma-ijinkan">
        <div class="gallery-grid">
          <div
            class="gallery-item"
            data-src={`${base}/gallery/013.jpg`}
            data-label="013"
          >
            <div class="gallery-frame">
              <img src={`${base}/gallery/013.jpg`} alt="013" loading="lazy" />
            </div>
            <div class="gallery-item-label">013</div>
          </div>
        </div>
      </div>

      <!-- 神戸 -->
      <div class="category-panel" id="takuma-kobe">
        <p class="empty-msg">— 準備中 —</p>
      </div>

      <!-- スペイン -->
      <div class="category-panel" id="takuma-spain">
        <p class="empty-msg">— 準備中 —</p>
      </div>

      <!-- 静物 -->
      <div class="category-panel" id="takuma-seibutsu">
        <p class="empty-msg">— 準備中 —</p>
      </div>
    </section>

    <!-- セクション区切り -->
    <div class="section-divider">
      <div class="section-divider-diamond"></div>
    </div>

    <!-- ===== 德永 幸子 ===== -->
    <section class="artist-section">
      <div class="artist-header">
        <span class="artist-name-ja">德永 幸子</span>
        <span class="artist-name-en">Sachiko Tokunaga</span>
      </div>

      <div class="category-tabs" data-artist="sachiko">
        <button class="tab-btn active" data-cat="jinbutsu">人物</button>
        <button class="tab-btn"        data-cat="sensou">戦争の記憶</button>
        <button class="tab-btn"        data-cat="fuukei">風景</button>
        <button class="tab-btn"        data-cat="seibutsu">静物 他</button>
      </div>

      <!-- 人物 -->
      <div class="category-panel active" id="sachiko-jinbutsu">
        <p class="empty-msg">— 準備中 —</p>
      </div>

      <!-- 戦争の記憶 -->
      <div class="category-panel" id="sachiko-sensou">
        <p class="empty-msg">— 準備中 —</p>
      </div>

      <!-- 風景 -->
      <div class="category-panel" id="sachiko-fuukei">
        <p class="empty-msg">— 準備中 —</p>
      </div>

      <!-- 静物 他 -->
      <div class="category-panel" id="sachiko-seibutsu">
        <p class="empty-msg">— 準備中 —</p>
      </div>
    </section>

  </div><!-- /storage-main -->

  <!-- ========== ライトボックス ========== -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal">
      <button class="modal-close" id="modalClose">✕</button>
      <div class="modal-img-wrap">
        <img id="modalImg" src="" alt="" />
      </div>
    </div>
  </div>

  <script>
    const base = document.querySelector('meta[name="base-url"]')
                   ?.getAttribute('content') ?? '';

    /* ===== パスワード ===== */
    const CORRECT_PW = '0714';

    function checkPassword() {
      const input   = document.getElementById('pw-input') as HTMLInputElement;
      const errorEl = document.getElementById('pw-error')!;

      if (input.value === CORRECT_PW) {
        document.getElementById('password-screen')!.style.display = 'none';
        document.getElementById('storage-main')!.style.display    = 'block';
        sessionStorage.setItem('storage_auth', '1');
      } else {
        input.classList.add('error');
        errorEl.textContent = 'パスワードが違います';
        setTimeout(() => {
          input.classList.remove('error');
        }, 400);
        input.value = '';
        input.focus();
      }
    }

    // Enter キーで送信
    document.getElementById('pw-input')!
      .addEventListener('keydown', (e) => {
        if (e.key === 'Enter') checkPassword();
      });

    document.getElementById('enterBtn')!
      .addEventListener('click', checkPassword);

    // セッション維持（同タブ内なら再入力不要）
    if (sessionStorage.getItem('storage_auth') === '1') {
      document.getElementById('password-screen')!.style.display = 'none';
      document.getElementById('storage-main')!.style.display    = 'block';
    }

    /* ===== ハンバーガーメニュー ===== */
    const hamburgerBtn  = document.getElementById('hamburgerBtn')!;
    const mobileMenu    = document.getElementById('mobileMenu')!;
    const mobileOverlay = document.getElementById('mobileOverlay')!;

    function openMobileMenu() {
      hamburgerBtn.classList.add('open');
      mobileMenu.classList.add('open');
      mobileOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      hamburgerBtn.classList.remove('open');
      mobileMenu.classList.remove('open');
      mobileOverlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    hamburgerBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileMenu.classList.contains('open')
        ? closeMobileMenu()
        : openMobileMenu();
    });

    mobileOverlay.addEventListener('click', closeMobileMenu);

    /* ===== カテゴリタブ ===== */
    document.querySelectorAll('.category-tabs').forEach((tabGroup) => {
      const artist = (tabGroup as HTMLElement).dataset.artist!;

      tabGroup.querySelectorAll('.tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = (btn as HTMLElement).dataset.cat!;

          // ボタン active 切替
          tabGroup.querySelectorAll('.tab-btn')
            .forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          // パネル切替
          const section = tabGroup.closest('.artist-section')!;
          section.querySelectorAll('.category-panel')
            .forEach(p => p.classList.remove('active'));

          const panelId = `${artist}-${cat}`;
          section.querySelector(`#${panelId}`)!.classList.add('active');
        });
      });
    });

    /* ===== ライトボックス ===== */
    document.querySelectorAll('.gallery-item').forEach((item) => {
      item.addEventListener('click', () => {
        const src   = (item as HTMLElement).dataset.src   ?? '';
        const label = (item as HTMLElement).dataset.label ?? '';
        (document.getElementById('modalImg') as HTMLImageElement).src = src;
        (document.getElementById('modalImg') as HTMLImageElement).alt = label;
        document.getElementById('modalOverlay')!.classList.add('active');
      });
    });

    document.getElementById('modalClose')!.addEventListener('click', () => {
      document.getElementById('modalOverlay')!.classList.remove('active');
    });

    document.getElementById('modalOverlay')!.addEventListener('click', (e) => {
      if ((e.target as Element).id === 'modalOverlay') {
        (e.target as Element).classList.remove('active');
      }
    });
  </script>

</body>
</html>
