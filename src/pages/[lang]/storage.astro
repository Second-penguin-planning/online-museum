---
import artworks from '../../data/artworks.json';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } },
  ];
}

const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 多言語テキスト
const storageUI = {
  ja: {
    nav: { gallery: 'ギャラリー', about: 'アバウト', storage: '保管庫' },
    page: { eyebrow: 'STORAGE COLLECTION', title: '保 管 庫' },
    lock: {
      eyebrow: 'RESTRICTED ACCESS',
      title: '保 管 庫',
      btn: '入 室 す る',
      error: 'パスワードが違います',
    },
    artists: {
      takuma: { ja: '徳永 卓磨', en: 'Takuma Tokunaga' },
      sachiko: { ja: '德永 幸子', en: 'Sachiko Tokunaga' },
    },
    cats: {
      takuma: ['異人館', '神戸', 'スペイン', '静物', '未分類'],
      sachiko: ['人物', '戦争の記憶', '風景', '静物 他', '未分類'],
    },
    unsorted: { title: '未整理', eyebrow: 'アーティスト未設定' },
    preparing: '— 準備中 —',
    published: '公開中',
    unpublished: '非公開',
    genreLabel: 'ジャンル',
    publishLabel: 'ギャラリーに公開',
  },
  en: {
    nav: { gallery: 'Gallery', about: 'About', storage: 'Storage' },
    page: { eyebrow: 'STORAGE COLLECTION', title: 'Storage' },
    lock: {
      eyebrow: 'RESTRICTED ACCESS',
      title: 'Storage',
      btn: 'Enter',
      error: 'Incorrect password',
    },
    artists: {
      takuma: { ja: 'Takuma Tokunaga', en: 'Takuma Tokunaga' },
      sachiko: { ja: 'Sachiko Tokunaga', en: 'Sachiko Tokunaga' },
    },
    cats: {
      takuma: ['Ijinkan', 'Kobe', 'Spain', 'Still Life', 'Unclassified'],
      sachiko: ['People', 'Memories of War', 'Landscape', 'Still Life & Others', 'Unclassified'],
    },
    unsorted: { title: 'Unsorted', eyebrow: 'No artist assigned' },
    preparing: '— Preparing —',
    published: 'Published',
    unpublished: 'Unpublished',
    genreLabel: 'Genre',
    publishLabel: 'Show in gallery',
  },
  sp: {
    nav: { gallery: 'Galería', about: 'Acerca', storage: 'Archivo' },
    page: { eyebrow: 'COLECCIÓN DE ARCHIVO', title: 'Archivo' },
    lock: {
      eyebrow: 'ACCESO RESTRINGIDO',
      title: 'Archivo',
      btn: 'Entrar',
      error: 'Contraseña incorrecta',
    },
    artists: {
      takuma: { ja: 'Takuma Tokunaga', en: 'Takuma Tokunaga' },
      sachiko: { ja: 'Sachiko Tokunaga', en: 'Sachiko Tokunaga' },
    },
    cats: {
      takuma: ['Ijinkan', 'Kobe', 'España', 'Naturaleza muerta', 'Sin clasificar'],
      sachiko: ['Personas', 'Memorias de guerra', 'Paisaje', 'Naturaleza muerta y otros', 'Sin clasificar'],
    },
    unsorted: { title: 'Sin ordenar', eyebrow: 'Sin artista asignado' },
    preparing: '— En preparación —',
    published: 'Publicado',
    unpublished: 'No publicado',
    genreLabel: 'Género',
    publishLabel: 'Mostrar en la galería',
  },
};

const tS = storageUI[lang];

// カテゴリキー（言語によらず固定）。末尾の 'unclassified' はジャンル未設定の受け皿
const takumaCatKeys = ['ijinkan', 'kobe', 'spain', 'seibutsu', 'unclassified'];
const sachikoCatKeys = ['jinbutsu', 'sensou', 'fuukei', 'seibutsu', 'unclassified'];

// artworks.json を元に、アーティスト×ジャンルで作品をグルーピングする
function localize(info) {
  return {
    file: info.file,
    title: info.title?.[lang] || info.title?.ja || '—',
    artistKey: info.artistKey ?? null,
    genre: info.genre ?? 'unclassified',
    published: !!info.published,
    raw: info, // 編集フォームの初期値に使う元エントリ（3言語すべて）
  };
}

const localizedArtworks = artworks.map(localize);

function artworksFor(artistKey, catKey) {
  return localizedArtworks.filter(a => a.artistKey === artistKey && a.genre === catKey);
}

const unsortedArtworks = localizedArtworks.filter(a => a.artistKey === null);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="base-url" content={base} />
  <title>{tS.page.title} | Tokunaga Art Museum</title>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --crimson-deep:  #4a0a0a;
      --crimson-mid:   #6b1212;
      --crimson-rich:  #8b1a1a;
      --crimson-warm:  #a52020;
      --gold-dim:      #b8960c;
      --gold-bright:   #d4af37;
      --gold-light:    #e8cc6a;
      --text-main:     #f0e6d3;
      --text-sub:      #c4a882;
      --text-muted:    #7a6452;
    }

    body {
      font-family: "Garamond", "Times New Roman", "游明朝", serif;
      background: var(--crimson-deep);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ========== ヘッダー ========== */
    .site-header {
      position: fixed;
      top: 0; left: 0;
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 50px;
      z-index: 1000;
      background: linear-gradient(
        to bottom,
        rgba(20, 4, 4, 0.95) 0%,
        rgba(20, 4, 4, 0.0) 100%
      );
      border-bottom: 1px solid rgba(212, 175, 55, 0.15);
    }

    .header-logo {
      font-size: 1.1rem;
      letter-spacing: 0.25em;
      font-weight: 400;
      color: var(--gold-bright);
      text-shadow: 0 2px 12px rgba(0,0,0,0.9);
      flex-shrink: 0;
    }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .header-nav a {
      color: var(--text-sub);
      text-decoration: none;
      font-size: 0.82rem;
      letter-spacing: 0.15em;
      opacity: 0.85;
      transition: opacity 0.3s, color 0.3s, transform 0.3s;
      text-shadow: 0 2px 8px rgba(0,0,0,0.9);
      white-space: nowrap;
    }

    .header-nav a:hover {
      opacity: 1;
      color: var(--gold-light);
      transform: translateY(-1px);
    }

    .header-nav a.current {
      opacity: 1;
      color: var(--gold-bright);
    }

    .lang-switcher {
      display: flex;
      gap: 12px;
      border-left: 1px solid rgba(212, 175, 55, 0.3);
      padding-left: 18px;
      margin-left: 8px;
    }

    .lang-switcher a {
      font-size: 0.75rem;
      text-decoration: none;
      color: var(--text-sub);
      opacity: 0.55;
      letter-spacing: 0.1em;
      transition: opacity 0.3s, color 0.3s;
    }

    .lang-switcher a.active {
      opacity: 1;
      font-weight: bold;
      color: var(--gold-bright);
    }

    /* ========== ハンバーガー ========== */
    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      background: none;
      border: 1px solid rgba(212, 175, 55, 0.3);
      cursor: pointer;
      padding: 8px;
      flex-shrink: 0;
      transition: border-color 0.3s;
      z-index: 1100;
      position: relative;
    }

    .hamburger:hover { border-color: var(--gold-bright); }

    .hamburger span {
      display: block;
      width: 22px;
      height: 1.5px;
      background: var(--gold-bright);
      transition: transform 0.35s ease, opacity 0.35s ease;
      transform-origin: center;
    }

    .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

    /* ========== モバイルオーバーレイ ========== */
    .mobile-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 1040;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease, visibility 0.4s ease;
      pointer-events: none;
    }

    .mobile-overlay.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    /* ========== モバイルメニュー ========== */
    .mobile-menu {
      position: fixed;
      top: 0; right: 0;
      width: min(280px, 80vw);
      height: 100%;
      background: linear-gradient(
        160deg,
        rgba(20, 4, 4, 0.98) 0%,
        rgba(50, 8, 8, 0.98) 100%
      );
      border-left: 1px solid rgba(212, 175, 55, 0.2);
      z-index: 1050;
      display: flex;
      flex-direction: column;
      padding: 80px 32px 40px;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1);
      box-shadow: -8px 0 30px rgba(0,0,0,0.6);
      pointer-events: none;
    }

    .mobile-menu.open {
      transform: translateX(0);
      pointer-events: auto;
    }

    .mobile-menu-nav {
      display: flex;
      flex-direction: column;
    }

    .mobile-menu-nav a {
      display: block;
      border-bottom: 1px solid rgba(212, 175, 55, 0.12);
      color: var(--text-sub);
      font-family: inherit;
      font-size: 0.88rem;
      letter-spacing: 0.2em;
      padding: 18px 0;
      text-decoration: none;
      transition: color 0.3s, padding-left 0.3s;
    }

    .mobile-menu-nav a:first-child {
      border-top: 1px solid rgba(212, 175, 55, 0.12);
    }

    .mobile-menu-nav a:hover { color: var(--gold-light); padding-left: 8px; }
    .mobile-menu-nav a.current { color: var(--gold-bright); }

    .mobile-lang-switcher {
      display: flex;
      gap: 16px;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid rgba(212, 175, 55, 0.2);
    }

    .mobile-lang-switcher a {
      font-size: 0.8rem;
      text-decoration: none;
      color: var(--text-sub);
      opacity: 0.55;
      letter-spacing: 0.12em;
      transition: opacity 0.3s, color 0.3s;
    }

    .mobile-lang-switcher a.active {
      opacity: 1;
      font-weight: bold;
      color: var(--gold-bright);
    }

    /* ========== パスワード画面 ========== */
    #password-screen {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
      background:
        linear-gradient(
          160deg,
          rgba(30, 4, 4, 0.92) 0%,
          rgba(74, 10, 10, 0.85) 50%,
          rgba(30, 4, 4, 0.95) 100%
        ),
        repeating-linear-gradient(
          45deg,
          rgba(0,0,0,0.03) 0px,
          rgba(0,0,0,0.03) 1px,
          transparent 1px,
          transparent 8px
        );
    }

    .lock-frame {
      position: relative;
      width: min(420px, 88vw);
      padding: 60px 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.6rem;
    }

    .lock-frame::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1px solid rgba(212, 175, 55, 0.3);
      pointer-events: none;
    }

    .lock-frame::after {
      content: '';
      position: absolute;
      inset: 8px;
      border: 1px solid rgba(212, 175, 55, 0.12);
      pointer-events: none;
    }

    .lock-icon-wrap {
      font-size: 2.4rem;
      color: var(--gold-dim);
      animation: glow 2.5s ease-in-out infinite;
    }

    @keyframes glow {
      0%, 100% { text-shadow: 0 0 8px rgba(212, 175, 55, 0.3); }
      50%       { text-shadow: 0 0 24px rgba(212, 175, 55, 0.7); }
    }

    .lock-eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.45em;
      color: var(--gold-dim);
      text-transform: uppercase;
    }

    .lock-title {
      font-size: clamp(1.4rem, 5vw, 2rem);
      font-weight: 400;
      letter-spacing: 0.35em;
      color: var(--text-main);
      text-shadow: 0 2px 20px rgba(0,0,0,0.8);
    }

    .lock-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
    }

    .lock-divider::before,
    .lock-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
    }

    .lock-divider-diamond {
      width: 5px;
      height: 5px;
      background: var(--gold-dim);
      transform: rotate(45deg);
      flex-shrink: 0;
    }

    #pw-input {
      background: rgba(74, 10, 10, 0.4);
      border: 1px solid rgba(212, 175, 55, 0.3);
      color: var(--text-main);
      font-family: "Garamond", "Times New Roman", serif;
      font-size: 1.8rem;
      letter-spacing: 0.6em;
      padding: 0.6rem 1.2rem;
      text-align: center;
      width: 180px;
      outline: none;
      transition: border-color 0.3s, box-shadow 0.3s;
    }

    #pw-input:focus {
      border-color: var(--gold-bright);
      box-shadow: 0 0 16px rgba(212, 175, 55, 0.2);
    }

    #pw-input.error {
      border-color: #c04040;
      animation: shake 0.35s ease;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25%       { transform: translateX(-10px); }
      75%       { transform: translateX(10px); }
    }

    #pw-error {
      color: #c06060;
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      min-height: 1.2em;
      text-align: center;
    }

    .enter-btn {
      position: relative;
      padding: 13px 44px;
      background: transparent;
      color: var(--gold-bright);
      font-family: inherit;
      font-size: 0.8rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      cursor: pointer;
      border: none;
      overflow: hidden;
      transition: color 0.45s ease;
      min-height: 44px;
      -webkit-tap-highlight-color: transparent;
    }

    .enter-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1px solid var(--gold-dim);
      transition: border-color 0.45s ease;
    }

    .enter-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--gold-bright);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.45s cubic-bezier(0.76, 0, 0.24, 1);
      z-index: -1;
    }

    .enter-btn:hover { color: var(--crimson-deep); }
    .enter-btn:hover::before { border-color: var(--gold-bright); }
    .enter-btn:hover::after  { transform: scaleX(1); }

    /* ========== 保管庫メイン ========== */
    #storage-main {
      display: none;
      padding: 120px 40px 80px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .storage-page-header {
      text-align: center;
      margin-bottom: 60px;
    }

    .storage-page-eyebrow {
      font-size: 0.65rem;
      letter-spacing: 0.5em;
      color: var(--gold-dim);
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    .storage-page-title {
      font-size: clamp(1.4rem, 4vw, 2.2rem);
      font-weight: 400;
      letter-spacing: 0.3em;
      color: var(--text-main);
      margin-bottom: 20px;
    }

    .storage-page-header::after {
      content: '';
      display: block;
      width: 80px;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
      margin: 0 auto;
    }

    .artist-section { margin-bottom: 70px; }

    .artist-header {
      display: flex;
      align-items: baseline;
      gap: 16px;
      margin-bottom: 24px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(212, 175, 55, 0.2);
      position: relative;
    }

    .artist-header::before {
      content: '';
      position: absolute;
      left: 0; bottom: -1px;
      width: 60px;
      height: 1px;
      background: var(--gold-bright);
    }

    .artist-name-ja {
      font-size: clamp(1.1rem, 3vw, 1.4rem);
      font-weight: 400;
      letter-spacing: 0.2em;
      color: var(--text-main);
    }

    .artist-name-en {
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      color: var(--text-muted);
    }

    .category-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 28px;
    }

    .tab-btn {
      position: relative;
      padding: 10px 22px;
      background: rgba(74, 10, 10, 0.35);
      color: var(--text-sub);
      font-family: inherit;
      font-size: 0.78rem;
      letter-spacing: 0.18em;
      cursor: pointer;
      border: none;
      transition: color 0.3s, background 0.3s;
      overflow: hidden;
      -webkit-tap-highlight-color: transparent;
      min-height: 40px;
    }

    .tab-btn::before {
      content: '';
      position: absolute;
      left: 0; top: 0;
      width: 3px; height: 100%;
      background: var(--gold-dim);
      transform: scaleY(0);
      transform-origin: bottom;
      transition: transform 0.3s cubic-bezier(0.76, 0, 0.24, 1);
    }

    .tab-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      border: 1px solid rgba(212, 175, 55, 0.25);
      transition: border-color 0.3s;
    }

    .tab-btn:hover,
    .tab-btn.active {
      background: rgba(139, 26, 26, 0.55);
      color: var(--gold-light);
    }

    .tab-btn.active { color: var(--gold-bright); }

    .tab-btn:hover::before,
    .tab-btn.active::before { transform: scaleY(1); }

    .tab-btn:hover::after,
    .tab-btn.active::after { border-color: rgba(212, 175, 55, 0.55); }

    .category-panel { display: none; }
    .category-panel.active { display: block; }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 20px;
    }

    .gallery-item {
      cursor: pointer;
      transition: transform 0.3s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .gallery-item:hover { transform: translateY(-5px); }

    .gallery-frame {
      border-style: solid;
      border-width: 10px;
      border-color:
        hsl(30, 45%, 36%)
        hsl(30, 45%, 20%)
        hsl(30, 45%, 20%)
        hsl(30, 45%, 36%);
      border-radius: 4px;
      box-shadow:
        6px 8px 20px rgba(0,0,0,0.7),
        0 0 0 1px rgba(0,0,0,0.4),
        inset 0 0 12px rgba(0,0,0,0.3);
    }

    .gallery-frame img {
      display: block;
      width: 100%;
      aspect-ratio: 3/4;
      object-fit: cover;
    }

    .gallery-item-label {
      text-align: center;
      margin-top: 10px;
      font-size: 0.68rem;
      color: var(--text-muted);
      letter-spacing: 0.06em;
    }

    /* ========== 管理者モード用コントロール ========== */
    .admin-controls {
      display: none;
      flex-direction: column;
      gap: 6px;
      margin-top: 10px;
      padding: 10px;
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid rgba(212, 175, 55, 0.25);
    }

    body.admin-mode .admin-controls { display: flex; }

    .admin-genre-select {
      width: 100%;
      background: rgba(20, 4, 4, 0.8);
      color: var(--text-main);
      border: 1px solid rgba(212, 175, 55, 0.35);
      font-family: inherit;
      font-size: 0.72rem;
      padding: 4px 6px;
    }

    .admin-publish-toggle {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.68rem;
      color: var(--text-sub);
      letter-spacing: 0.04em;
      cursor: pointer;
    }

    .admin-edit-btn {
      background: rgba(212, 175, 55, 0.15);
      color: var(--gold-light);
      border: 1px solid rgba(212, 175, 55, 0.35);
      font-size: 0.7rem;
      padding: 5px 0;
      cursor: pointer;
      transition: background 0.2s;
    }

    .admin-edit-btn:hover { background: rgba(212, 175, 55, 0.3); }

    .admin-save-status {
      font-size: 0.62rem;
      letter-spacing: 0.06em;
      color: var(--gold-bright);
      min-height: 1em;
    }

    .empty-msg {
      text-align: center;
      padding: 50px 0;
      color: var(--text-muted);
      font-size: 0.82rem;
      letter-spacing: 0.3em;
    }

    .section-divider {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 50px 0;
    }

    .section-divider::before,
    .section-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(212, 175, 55, 0.2), transparent);
    }

    .section-divider-diamond {
      width: 5px; height: 5px;
      background: var(--gold-dim);
      transform: rotate(45deg);
      flex-shrink: 0;
      opacity: 0.6;
    }

    /* ========== ライトボックス ========== */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10, 2, 2, 0.93);
      z-index: 2000;
      justify-content: center;
      align-items: center;
      backdrop-filter: blur(4px);
      padding: 16px;
    }

    .modal-overlay.active { display: flex; }

    .modal {
      background: linear-gradient(160deg, #1e0808 0%, #150404 100%);
      border: 1px solid rgba(212, 175, 55, 0.2);
      padding: 32px 24px;
      max-width: 700px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
      box-shadow: 0 30px 80px rgba(0,0,0,0.8), inset 0 1px 0 rgba(212, 175, 55, 0.1);
      -webkit-overflow-scrolling: touch;
    }

    .modal-close {
      position: absolute;
      top: 12px; right: 14px;
      background: none;
      border: 1px solid rgba(212, 175, 55, 0.25);
      color: var(--text-sub);
      font-size: 1rem;
      width: 34px; height: 34px;
      cursor: pointer;
      transition: border-color 0.3s, color 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-close:hover {
      border-color: var(--gold-bright);
      color: var(--gold-bright);
    }

    .modal-img-wrap {
      text-align: center;
      margin-bottom: 16px;
    }

    .modal-img-wrap img {
      max-width: 100%;
      max-height: 55vh;
      object-fit: contain;
    }

    /* ========== 管理者ボタン ========== */
    .admin-btn-wrap {
      text-align: right;
      margin-bottom: 40px;
    }

    .admin-open-btn {
      background: none;
      border: 1px solid rgba(212, 175, 55, 0.2);
      color: var(--text-muted);
      font-family: inherit;
      font-size: 0.68rem;
      letter-spacing: 0.3em;
      padding: 8px 20px;
      cursor: pointer;
      text-transform: uppercase;
      transition: color 0.3s, border-color 0.3s;
    }

    .admin-open-btn:hover {
      color: var(--gold-dim);
      border-color: rgba(212, 175, 55, 0.45);
    }

    /* ========== 管理者モーダル共通 ========== */
    .admin-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(8, 1, 1, 0.96);
      z-index: 3000;
      justify-content: center;
      align-items: flex-start;
      overflow-y: auto;
      padding: 40px 16px 60px;
      backdrop-filter: blur(6px);
    }

    .admin-modal-overlay.active { display: flex; }

    .admin-modal {
      background: linear-gradient(160deg, #1e0606 0%, #120303 100%);
      border: 1px solid rgba(212, 175, 55, 0.25);
      padding: 40px 32px 48px;
      width: 100%;
      max-width: 680px;
      position: relative;
      box-shadow: 0 30px 80px rgba(0,0,0,0.9), inset 0 1px 0 rgba(212, 175, 55, 0.12);
      margin: auto;
    }

    .admin-modal-close {
      position: absolute;
      top: 14px; right: 16px;
      background: none;
      border: 1px solid rgba(212, 175, 55, 0.2);
      color: var(--text-sub);
      font-size: 1rem;
      width: 34px; height: 34px;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: border-color 0.3s, color 0.3s;
    }

    .admin-modal-close:hover { border-color: var(--gold-bright); color: var(--gold-bright); }

    .admin-modal-eyebrow {
      font-size: 0.6rem;
      letter-spacing: 0.45em;
      color: var(--gold-dim);
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .admin-modal-title {
      font-size: clamp(1.1rem, 3vw, 1.5rem);
      font-weight: 400;
      letter-spacing: 0.25em;
      color: var(--text-main);
      margin-bottom: 28px;
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(212, 175, 55, 0.15);
    }

    /* ========== 管理者パスワード ========== */
    #admin-pw-screen { text-align: center; }

    #admin-pw-input {
      background: rgba(74, 10, 10, 0.4);
      border: 1px solid rgba(212, 175, 55, 0.3);
      color: var(--text-main);
      font-family: inherit;
      font-size: 1.6rem;
      letter-spacing: 0.5em;
      padding: 0.6rem 1.2rem;
      text-align: center;
      width: 200px;
      outline: none;
      margin: 0 auto 12px;
      display: block;
      transition: border-color 0.3s;
    }

    #admin-pw-input:focus { border-color: var(--gold-bright); }
    #admin-pw-input.error { border-color: #c04040; animation: shake 0.35s ease; }

    #admin-token-input {
      background: rgba(74, 10, 10, 0.4);
      border: 1px solid rgba(212, 175, 55, 0.3);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.85rem;
      letter-spacing: 0.02em;
      padding: 0.55rem 0.9rem;
      text-align: left;
      width: 100%;
      max-width: 340px;
      outline: none;
      display: block;
      margin: 0 auto;
      transition: border-color 0.3s;
    }

    #admin-token-input:focus { border-color: var(--gold-bright); }
    #admin-token-input.error { border-color: #c04040; animation: shake 0.35s ease; }

    #admin-pw-error {
      color: #c06060;
      font-size: 0.76rem;
      letter-spacing: 0.1em;
      min-height: 1.2em;
      margin-bottom: 16px;
    }

    /* ========== 作品登録フォーム ========== */
    .form-section {
      margin-bottom: 28px;
    }

    .form-section-title {
      font-size: 0.62rem;
      letter-spacing: 0.4em;
      color: var(--gold-dim);
      text-transform: uppercase;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(212, 175, 55, 0.12);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 10px;
    }

    .form-row.three { grid-template-columns: 1fr 1fr 1fr; }
    .form-row.one   { grid-template-columns: 1fr; }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .form-group label {
      font-size: 0.62rem;
      letter-spacing: 0.15em;
      color: var(--text-muted);
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      background: rgba(74, 10, 10, 0.35);
      border: 1px solid rgba(212, 175, 55, 0.2);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.82rem;
      padding: 9px 12px;
      outline: none;
      transition: border-color 0.3s;
      width: 100%;
    }

    .form-group textarea {
      resize: vertical;
      min-height: 72px;
      line-height: 1.6;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus { border-color: var(--gold-bright); }

    .form-group select option { background: #2a0808; }

    .github-token-note {
      font-size: 0.68rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      margin-top: 6px;
      line-height: 1.6;
    }

    .github-token-note a {
      color: var(--gold-dim);
    }

    .form-submit-btn {
      position: relative;
      width: 100%;
      padding: 15px;
      background: transparent;
      color: var(--gold-bright);
      font-family: inherit;
      font-size: 0.82rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      cursor: pointer;
      border: none;
      overflow: hidden;
      transition: color 0.45s ease;
      margin-top: 10px;
    }

    .form-submit-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      border: 1px solid var(--gold-dim);
      transition: border-color 0.45s;
    }

    .form-submit-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--gold-bright);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.45s cubic-bezier(0.76, 0, 0.24, 1);
      z-index: -1;
    }

    .form-submit-btn:hover { color: var(--crimson-deep); }
    .form-submit-btn:hover::before { border-color: var(--gold-bright); }
    .form-submit-btn:hover::after { transform: scaleX(1); }
    .form-submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    #form-status {
      margin-top: 16px;
      text-align: center;
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      min-height: 1.4em;
    }

    #form-status.success { color: #70c080; }
    #form-status.error   { color: #c06060; }
    #form-status.loading { color: var(--gold-dim); }

    /* ========== レスポンシブ ========== */
    @media (max-width: 768px) {
      .site-header { padding: 12px 18px; }
      .header-logo { font-size: 0.82rem; letter-spacing: 0.15em; }
      .header-nav  { display: none; }
      .hamburger   { display: flex; }
      #storage-main { padding: 90px 20px 60px; }
      .lock-frame { padding: 44px 28px; }
      .gallery-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 14px; }
      .admin-modal { padding: 32px 20px 40px; }
      .form-row { grid-template-columns: 1fr; }
      .form-row.three { grid-template-columns: 1fr; }
    }

    @media (max-width: 480px) {
      .category-tabs { gap: 6px; }
      .tab-btn { font-size: 0.72rem; padding: 8px 14px; }
      .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>

  <!-- ===== SP-FAMILYBAR START ===== -->
  <div class="sp-familybar sp-familybar--dark">
    <a href="https://second-penguin.com/#sp-apps" target="_blank" rel="noopener" class="sp-familybar__link">
      セコンドペンギン企画 ファミリーサイト一覧へ <span aria-hidden="true">→</span>
    </a>
  </div>
  <style>
    .sp-familybar { padding: 8px 16px; text-align: center; font-family: -apple-system, "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif; }
    .sp-familybar--dark { background: #16181d; border-bottom: 1px solid #33363f; }
    .sp-familybar__link { font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .sp-familybar--dark .sp-familybar__link { color: #e8e2d0; }
    .sp-familybar__link:hover { text-decoration: underline; }
  </style>
  <!-- ===== SP-FAMILYBAR END ===== -->

  <!-- ========== ヘッダー ========== -->
  <header class="site-header">
    <div class="header-logo">TOKUNAGA ART MUSEUM</div>

    <!-- PC用ナビ -->
    <nav class="header-nav">
      <a href={`${base}/${lang}/`}>{tS.nav.gallery}</a>
      <a href={`${base}/${lang}/about/`}>{tS.nav.about}</a>
      <a href={`${base}/${lang}/shop/`}>SHOP</a>
      <a href={`${base}/${lang}/storage/`} class="current">{tS.nav.storage}</a>
      <div class="lang-switcher">
        <!-- ★ストレージページ内で言語切替 → storage/ を維持したまま言語だけ変更 -->
        <a href={`${base}/ja/storage/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
        <a href={`${base}/en/storage/`} class={lang === 'en' ? 'active' : ''}>EN</a>
        <a href={`${base}/sp/storage/`} class={lang === 'sp' ? 'active' : ''}>SP</a>
      </div>
    </nav>

    <!-- ハンバーガーボタン -->
    <button class="hamburger" id="hamburgerBtn" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- モバイルオーバーレイ -->
  <div class="mobile-overlay" id="mobileOverlay"></div>

  <!-- モバイルメニュー -->
  <div class="mobile-menu" id="mobileMenu">
    <nav class="mobile-menu-nav">
      <a href={`${base}/${lang}/`}>{tS.nav.gallery}</a>
      <a href={`${base}/${lang}/about/`}>{tS.nav.about}</a>
      <a href={`${base}/${lang}/shop/`}>SHOP</a>
      <a href={`${base}/${lang}/storage/`} class="current">{tS.nav.storage}</a>
    </nav>
    <div class="mobile-lang-switcher">
      <!-- ★モバイルも同様に storage/ を維持 -->
      <a href={`${base}/ja/storage/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
      <a href={`${base}/en/storage/`} class={lang === 'en' ? 'active' : ''}>EN</a>
      <a href={`${base}/sp/storage/`} class={lang === 'sp' ? 'active' : ''}>SP</a>
    </div>
  </div>

  <!-- ========== パスワード画面 ========== -->
  <div id="password-screen">
    <div class="lock-frame">
      <div class="lock-icon-wrap">🔒</div>
      <p class="lock-eyebrow">{tS.lock.eyebrow}</p>
      <h1 class="lock-title">{tS.lock.title}</h1>
      <div class="lock-divider">
        <div class="lock-divider-diamond"></div>
      </div>
      <input
        id="pw-input"
        type="password"
        maxlength="10"
        placeholder="· · · ·"
        autocomplete="off"
      />
      <p id="pw-error"></p>
      <button class="enter-btn" id="enterBtn">{tS.lock.btn}</button>
    </div>
  </div>

  <!-- ========== 保管庫メイン ========== -->
  <div id="storage-main">
    <div class="storage-page-header">
      <p class="storage-page-eyebrow">{tS.page.eyebrow}</p>
      <h2 class="storage-page-title">{tS.page.title}</h2>
    </div>

    <!-- 管理者ボタン -->
    <div class="admin-btn-wrap">
      <button class="admin-open-btn" id="adminOpenBtn">⚙ ADMIN</button>
    </div>

    <!-- ===== 徳永 卓磨 ===== -->
    <section class="artist-section">
      <div class="artist-header">
        <span class="artist-name-ja">{tS.artists.takuma.ja}</span>
        <span class="artist-name-en">{tS.artists.takuma.en}</span>
      </div>

      <div class="category-tabs" data-artist="takuma">
        {takumaCatKeys.map((key, i) => (
          <button class={`tab-btn${i === 0 ? ' active' : ''}`} data-cat={key}>
            {tS.cats.takuma[i]}
          </button>
        ))}
      </div>

      {takumaCatKeys.map((key, i) => {
        const items = artworksFor('takuma', key);
        return (
          <div class={`category-panel${i === 0 ? ' active' : ''}`} id={`takuma-${key}`}>
            {items.length > 0 ? (
              <div class="gallery-grid">
                {items.map(art => (
                  <div class="gallery-item" data-src={`${base}/gallery/${art.file}`} data-label={art.title}>
                    <div class="gallery-frame">
                      <img src={`${base}/gallery/${art.file}`} alt={art.title} loading="lazy" />
                    </div>
                    <div class="gallery-item-label">{art.title}</div>
                    <div class="admin-controls" data-file={art.file} data-entry={JSON.stringify(art.raw)}>
                      <select class="admin-genre-select">
                        {takumaCatKeys.map((k2, j) => (
                          <option value={k2} selected={k2 === art.genre}>{tS.cats.takuma[j]}</option>
                        ))}
                      </select>
                      <label class="admin-publish-toggle">
                        <input type="checkbox" class="admin-publish-checkbox" checked={art.published} />
                        {tS.publishLabel}
                      </label>
                      <button type="button" class="admin-edit-btn">✎</button>
                      <span class="admin-save-status"></span>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="empty-msg">{tS.preparing}</p>
            )}
          </div>
        );
      })}
    </section>

    <div class="section-divider">
      <div class="section-divider-diamond"></div>
    </div>

    <!-- ===== 德永 幸子 ===== -->
    <section class="artist-section">
      <div class="artist-header">
        <span class="artist-name-ja">{tS.artists.sachiko.ja}</span>
        <span class="artist-name-en">{tS.artists.sachiko.en}</span>
      </div>

      <div class="category-tabs" data-artist="sachiko">
        {sachikoCatKeys.map((key, i) => (
          <button class={`tab-btn${i === 0 ? ' active' : ''}`} data-cat={key}>
            {tS.cats.sachiko[i]}
          </button>
        ))}
      </div>

      {sachikoCatKeys.map((key, i) => {
        const items = artworksFor('sachiko', key);
        return (
          <div class={`category-panel${i === 0 ? ' active' : ''}`} id={`sachiko-${key}`}>
            {items.length > 0 ? (
              <div class="gallery-grid">
                {items.map(art => (
                  <div class="gallery-item" data-src={`${base}/gallery/${art.file}`} data-label={art.title}>
                    <div class="gallery-frame">
                      <img src={`${base}/gallery/${art.file}`} alt={art.title} loading="lazy" />
                    </div>
                    <div class="gallery-item-label">{art.title}</div>
                    <div class="admin-controls" data-file={art.file} data-entry={JSON.stringify(art.raw)}>
                      <select class="admin-genre-select">
                        {sachikoCatKeys.map((k2, j) => (
                          <option value={k2} selected={k2 === art.genre}>{tS.cats.sachiko[j]}</option>
                        ))}
                      </select>
                      <label class="admin-publish-toggle">
                        <input type="checkbox" class="admin-publish-checkbox" checked={art.published} />
                        {tS.publishLabel}
                      </label>
                      <button type="button" class="admin-edit-btn">✎</button>
                      <span class="admin-save-status"></span>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p class="empty-msg">{tS.preparing}</p>
            )}
          </div>
        );
      })}
    </section>

    {unsortedArtworks.length > 0 && (
      <>
        <div class="section-divider">
          <div class="section-divider-diamond"></div>
        </div>

        <!-- ===== 未整理（アーティスト未設定） ===== -->
        <section class="artist-section">
          <div class="artist-header">
            <span class="artist-name-ja">{tS.unsorted.title}</span>
            <span class="artist-name-en">{tS.unsorted.eyebrow}</span>
          </div>

          <div class="gallery-grid">
            {unsortedArtworks.map(art => (
              <div class="gallery-item" data-src={`${base}/gallery/${art.file}`} data-label={art.title}>
                <div class="gallery-frame">
                  <img src={`${base}/gallery/${art.file}`} alt={art.title} loading="lazy" />
                </div>
                <div class="gallery-item-label">{art.title}</div>
                <div class="admin-controls" data-file={art.file} data-entry={JSON.stringify(art.raw)}>
                  <label class="admin-publish-toggle">
                    <input type="checkbox" class="admin-publish-checkbox" checked={art.published} />
                    {tS.publishLabel}
                  </label>
                  <button type="button" class="admin-edit-btn">✎</button>
                  <span class="admin-save-status"></span>
                </div>
              </div>
            ))}
          </div>
        </section>
      </>
    )}
  </div>

  <!-- ========== 管理者パスワードモーダル ========== -->
  <div class="admin-modal-overlay" id="adminPwOverlay">
    <div class="admin-modal" style="max-width:420px;">
      <button class="admin-modal-close" id="adminPwClose">✕</button>
      <p class="admin-modal-eyebrow">ADMIN ACCESS</p>
      <h2 class="admin-modal-title">管 理 者 認 証</h2>
      <div id="admin-pw-screen">
        <input id="admin-pw-input" type="password" maxlength="20" placeholder="· · · · · ·" autocomplete="off" />
        <input id="admin-token-input" type="password" placeholder="GitHub Personal Access Token" autocomplete="off" style="margin-top:10px;" />
        <p class="github-token-note">
          GitHubの Settings → Developer settings → Personal access tokens で発行。<br>
          「Contents: Read and Write」権限が必要です。このページを開いている間だけ記憶されます。
        </p>
        <p id="admin-pw-error"></p>
        <button class="enter-btn" id="adminPwEnterBtn" style="margin:0 auto; display:block;">認 証 す る</button>
      </div>
    </div>
  </div>

  <!-- ========== 作品登録モーダル ========== -->
  <div class="admin-modal-overlay" id="adminFormOverlay">
    <div class="admin-modal">
      <button class="admin-modal-close" id="adminFormClose">✕</button>
      <p class="admin-modal-eyebrow" id="adminFormEyebrow">ARTWORK REGISTRATION</p>
      <h2 class="admin-modal-title" id="adminFormTitle">作 品 情 報 登 録</h2>

      <form id="artworkForm" autocomplete="off">

        <!-- 基本情報 -->
        <div class="form-section">
          <p class="form-section-title">基本情報</p>
          <div class="form-row">
            <div class="form-group">
              <label>ファイル名（例: 01011.jpg）</label>
              <input type="text" id="f-file" placeholder="01011.jpg" required />
            </div>
            <div class="form-group">
              <label>作者</label>
              <select id="f-artist">
                <option value="takuma">徳永 卓磨</option>
                <option value="sachiko">徳永 幸子</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>{tS.genreLabel}</label>
              <select id="f-genre"></select>
            </div>
            <div class="form-group">
              <label class="admin-publish-toggle" style="margin-top:28px;">
                <input type="checkbox" id="f-published" />
                {tS.publishLabel}
              </label>
            </div>
          </div>
        </div>

        <!-- タイトル -->
        <div class="form-section">
          <p class="form-section-title">タイトル</p>
          <div class="form-row three">
            <div class="form-group">
              <label>日本語</label>
              <input type="text" id="f-title-ja" placeholder="作品名" required />
            </div>
            <div class="form-group">
              <label>英語</label>
              <input type="text" id="f-title-en" placeholder="Title" required />
            </div>
            <div class="form-group">
              <label>スペイン語</label>
              <input type="text" id="f-title-sp" placeholder="Título" required />
            </div>
          </div>
        </div>

        <!-- 年・サイズ -->
        <div class="form-section">
          <p class="form-section-title">年・サイズ</p>
          <div class="form-row">
            <div class="form-group">
              <label>制作年（日本語）例: 2024年</label>
              <input type="text" id="f-year-ja" placeholder="2024年" required />
            </div>
            <div class="form-group">
              <label>制作年（英語）例: 2024</label>
              <input type="text" id="f-year-en" placeholder="2024" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>サイズ（日本語）例: 40号</label>
              <input type="text" id="f-size-ja" placeholder="40号" required />
            </div>
            <div class="form-group">
              <label>サイズ（英語）例: No. 40</label>
              <input type="text" id="f-size-en" placeholder="No. 40" required />
            </div>
          </div>
        </div>

        <!-- 説明 -->
        <div class="form-section">
          <p class="form-section-title">説明文</p>
          <div class="form-row one">
            <div class="form-group">
              <label>日本語</label>
              <textarea id="f-desc-ja" placeholder="作品の説明（日本語）" required></textarea>
            </div>
          </div>
          <div class="form-row one">
            <div class="form-group">
              <label>英語</label>
              <textarea id="f-desc-en" placeholder="Description in English" required></textarea>
            </div>
          </div>
          <div class="form-row one">
            <div class="form-group">
              <label>スペイン語</label>
              <textarea id="f-desc-sp" placeholder="Descripción en español" required></textarea>
            </div>
          </div>
        </div>

        <button type="submit" class="form-submit-btn" id="formSubmitBtn">登 録 す る</button>
        <p id="form-status"></p>
      </form>
    </div>
  </div>

  <!-- ========== ライトボックス ========== -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal">
      <button class="modal-close" id="modalClose">✕</button>
      <div class="modal-img-wrap">
        <img id="modalImg" src="" alt="" />
      </div>
    </div>
  </div>

  <script define:vars={{
    pwError: tS.lock.error,
    takumaCatKeys,
    sachikoCatKeys,
    catLabels: { takuma: tS.cats.takuma, sachiko: tS.cats.sachiko },
  }}>
    /* ===== パスワード認証 ===== */
    const CORRECT_PW = '2405';

    function showStorage() {
      document.getElementById('password-screen').style.display = 'none';
      document.getElementById('storage-main').style.display    = 'block';
      // ★ストレージ認証をキーに言語コードを含めない
      //   → どの言語でも同じキーで認証を引き継ぐ
      sessionStorage.setItem('storage_auth', '1');
    }

    function checkPassword() {
      const input   = document.getElementById('pw-input');
      const errorEl = document.getElementById('pw-error');

      if (input.value === CORRECT_PW) {
        showStorage();
      } else {
        input.classList.add('error');
        errorEl.textContent = pwError;
        setTimeout(() => input.classList.remove('error'), 400);
        input.value = '';
        input.focus();
      }
    }

    // ★言語切替時も認証済みなら即表示
    if (sessionStorage.getItem('storage_auth') === '1') {
      showStorage();
    }

    document.getElementById('pw-input')
      .addEventListener('keydown', (e) => { if (e.key === 'Enter') checkPassword(); });

    document.getElementById('enterBtn')
      .addEventListener('click', checkPassword);

    /* ===== ハンバーガーメニュー ===== */
    const hamburgerBtn  = document.getElementById('hamburgerBtn');
    const mobileMenu    = document.getElementById('mobileMenu');
    const mobileOverlay = document.getElementById('mobileOverlay');

    function openMobileMenu() {
      hamburgerBtn.classList.add('open');
      mobileMenu.classList.add('open');
      mobileOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
      hamburgerBtn.classList.remove('open');
      mobileMenu.classList.remove('open');
      mobileOverlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    hamburgerBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileMenu.classList.contains('open') ? closeMobileMenu() : openMobileMenu();
    });

    mobileOverlay.addEventListener('click', closeMobileMenu);

    /* ===== カテゴリタブ ===== */
    document.querySelectorAll('.category-tabs').forEach((tabGroup) => {
      const artist = tabGroup.dataset.artist;

      tabGroup.querySelectorAll('.tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.cat;

          tabGroup.querySelectorAll('.tab-btn')
            .forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const section = tabGroup.closest('.artist-section');
          section.querySelectorAll('.category-panel')
            .forEach(p => p.classList.remove('active'));

          section.querySelector(`#${artist}-${cat}`).classList.add('active');
        });
      });
    });

    /* ===== ライトボックス ===== */
    document.querySelectorAll('.gallery-item').forEach((item) => {
      item.addEventListener('click', (e) => {
        if (e.target.closest('.admin-controls')) return;
        document.getElementById('modalImg').src = item.dataset.src ?? '';
        document.getElementById('modalImg').alt = item.dataset.label ?? '';
        document.getElementById('modalOverlay').classList.add('active');
      });
    });

    document.getElementById('modalClose').addEventListener('click', () => {
      document.getElementById('modalOverlay').classList.remove('active');
    });

    document.getElementById('modalOverlay').addEventListener('click', (e) => {
      if (e.target.id === 'modalOverlay') e.target.classList.remove('active');
    });

    /* ===== 管理者パネル ===== */
    const ADMIN_PW = 'art2024admin';

    // PATはページを開いている間だけメモリ上に保持する（sessionStorageには保存しない）
    let adminToken = null;
    // nullなら新規登録モード。ファイル名が入っていれば、そのファイルの編集モード
    let editingFile = null;

    const adminOpenBtn     = document.getElementById('adminOpenBtn');
    const adminPwOverlay   = document.getElementById('adminPwOverlay');
    const adminPwClose     = document.getElementById('adminPwClose');
    const adminPwInput     = document.getElementById('admin-pw-input');
    const adminTokenInput  = document.getElementById('admin-token-input');
    const adminPwError     = document.getElementById('admin-pw-error');
    const adminPwEnterBtn  = document.getElementById('adminPwEnterBtn');
    const adminFormOverlay = document.getElementById('adminFormOverlay');
    const adminFormClose   = document.getElementById('adminFormClose');
    const adminFormTitle   = document.getElementById('adminFormTitle');
    const adminFormEyebrow = document.getElementById('adminFormEyebrow');
    const fFileInput       = document.getElementById('f-file');

    function resetFormToAddMode() {
      editingFile = null;
      document.getElementById('artworkForm').reset();
      fFileInput.readOnly = false;
      adminFormTitle.textContent = '作 品 情 報 登 録';
      adminFormEyebrow.textContent = 'ARTWORK REGISTRATION';
      populateGenreSelect(document.getElementById('f-artist').value);
      document.getElementById('form-status').textContent = '';
    }

    adminOpenBtn.addEventListener('click', () => {
      if (adminToken) {
        resetFormToAddMode();
        adminFormOverlay.classList.add('active');
      } else {
        adminPwOverlay.classList.add('active');
        adminPwInput.focus();
      }
    });

    adminPwClose.addEventListener('click', () => adminPwOverlay.classList.remove('active'));
    adminFormClose.addEventListener('click', () => adminFormOverlay.classList.remove('active'));

    adminPwOverlay.addEventListener('click', (e) => {
      if (e.target === adminPwOverlay) adminPwOverlay.classList.remove('active');
    });
    adminFormOverlay.addEventListener('click', (e) => {
      if (e.target === adminFormOverlay) adminFormOverlay.classList.remove('active');
    });

    function checkAdminPw() {
      const tokenVal = adminTokenInput.value.trim();

      if (adminPwInput.value === ADMIN_PW && tokenVal) {
        adminToken = tokenVal;
        document.body.classList.add('admin-mode');
        adminPwOverlay.classList.remove('active');
        adminPwInput.value = '';
        adminTokenInput.value = '';
        adminPwError.textContent = '';
        resetFormToAddMode();
        adminFormOverlay.classList.add('active');
      } else {
        adminPwInput.classList.add('error');
        adminPwError.textContent = tokenVal ? pwError : 'GitHub Personal Access Tokenを入力してください';
        setTimeout(() => adminPwInput.classList.remove('error'), 400);
        adminPwInput.value = '';
        adminPwInput.focus();
      }
    }

    adminPwEnterBtn.addEventListener('click', checkAdminPw);
    adminPwInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') checkAdminPw(); });
    adminTokenInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') checkAdminPw(); });

    /* ===== 作品登録フォーム ===== */
    const ARTIST_MAP = {
      takuma:  { ja: '徳永卓磨', en: 'Takuma Tokunaga',  sp: 'Takuma Tokunaga' },
      sachiko: { ja: '徳永幸子', en: 'Sachiko Tokunaga', sp: 'Sachiko Tokunaga' },
    };

    const CAT_KEYS = { takuma: takumaCatKeys, sachiko: sachikoCatKeys };

    const GITHUB_API = 'https://api.github.com/repos/Second-penguin-planning/online-museum/contents/src/data/artworks.json';

    // 現在のartworks.jsonを取得→コールバックで更新→コミット、を1本化
    async function updateArtworksJson(mutate, commitMessage) {
      const getRes = await fetch(GITHUB_API, {
        headers: { 'Authorization': `Bearer ${adminToken}`, 'Accept': 'application/vnd.github.v3+json' }
      });
      if (!getRes.ok) throw new Error(`ファイル取得エラー (${getRes.status})`);

      const fileData = await getRes.json();
      const current  = JSON.parse(atob(fileData.content.replace(/\n/g, '')));

      mutate(current);

      const newContent = btoa(unescape(encodeURIComponent(JSON.stringify(current, null, 2))));

      const putRes = await fetch(GITHUB_API, {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${adminToken}`,
          'Accept': 'application/vnd.github.v3+json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          message: commitMessage,
          content: newContent,
          sha: fileData.sha,
        }),
      });

      if (!putRes.ok) {
        const err = await putRes.json();
        throw new Error(err.message || `保存エラー (${putRes.status})`);
      }
    }

    function populateGenreSelect(artistKey) {
      const genreSelect = document.getElementById('f-genre');
      const keys   = CAT_KEYS[artistKey] || [];
      const labels = catLabels[artistKey] || [];
      genreSelect.innerHTML = keys.map((k, i) => `<option value="${k}">${labels[i]}</option>`).join('');
    }

    const fArtistSelect = document.getElementById('f-artist');
    populateGenreSelect(fArtistSelect.value);
    fArtistSelect.addEventListener('change', () => populateGenreSelect(fArtistSelect.value));

    document.getElementById('artworkForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const statusEl  = document.getElementById('form-status');
      const submitBtn = document.getElementById('formSubmitBtn');
      const artistKey = fArtistSelect.value;
      const artist    = ARTIST_MAP[artistKey];

      const sizeJa = document.getElementById('f-size-ja').value.trim();
      const sizeEn = document.getElementById('f-size-en').value.trim();
      const spSize = sizeEn.replace('No.', 'Nº');

      const yearJa = document.getElementById('f-year-ja').value.trim();
      const yearEn = document.getElementById('f-year-en').value.trim();

      const newEntry = {
        file:        document.getElementById('f-file').value.trim(),
        title:       { ja: document.getElementById('f-title-ja').value.trim(), en: document.getElementById('f-title-en').value.trim(), sp: document.getElementById('f-title-sp').value.trim() },
        artist:      { ja: artist.ja, en: artist.en, sp: artist.sp },
        year:        { ja: yearJa, en: yearEn, sp: yearEn },
        size:        { ja: sizeJa, en: sizeEn, sp: spSize },
        description: { ja: document.getElementById('f-desc-ja').value.trim(), en: document.getElementById('f-desc-en').value.trim(), sp: document.getElementById('f-desc-sp').value.trim() },
        artistKey,
        genre:       document.getElementById('f-genre').value,
        published:   document.getElementById('f-published').checked,
      };

      statusEl.textContent  = '送信中...';
      statusEl.className    = 'loading';
      submitBtn.disabled    = true;

      try {
        if (editingFile) {
          await updateArtworksJson((current) => {
            const entry = current.find(a => a.file === editingFile);
            if (!entry) throw new Error(`${editingFile} が見つかりませんでした`);
            Object.assign(entry, newEntry);
          }, `作品情報更新: ${newEntry.file}`);

          statusEl.textContent = '✓ 更新しました。サイトに反映されるまで数分かかります。';
        } else {
          await updateArtworksJson((current) => {
            if (current.some(a => a.file === newEntry.file)) {
              throw new Error('このファイル名は既に登録されています。カードの✎ボタンから編集してください。');
            }
            current.push(newEntry);
          }, `作品情報追加: ${newEntry.file}`);

          statusEl.textContent = '✓ 登録が完了しました。サイトに反映されるまで数分かかります。';
        }

        statusEl.className = 'success';
        resetFormToAddMode();

      } catch (err) {
        statusEl.textContent = `エラー: ${err.message}`;
        statusEl.className   = 'error';
      } finally {
        submitBtn.disabled = false;
      }
    });

    /* ===== 既存作品の編集（✎ボタン） ===== */
    document.querySelectorAll('.admin-edit-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const panel = btn.closest('.admin-controls');
        const entry = JSON.parse(panel.dataset.entry || '{}');

        editingFile = entry.file;
        fFileInput.value = entry.file || '';
        fFileInput.readOnly = true;

        const artistKey = entry.artistKey || 'takuma';
        fArtistSelect.value = artistKey;
        populateGenreSelect(artistKey);
        document.getElementById('f-genre').value = entry.genre || 'unclassified';
        document.getElementById('f-published').checked = !!entry.published;

        document.getElementById('f-title-ja').value = entry.title?.ja || '';
        document.getElementById('f-title-en').value = entry.title?.en || '';
        document.getElementById('f-title-sp').value = entry.title?.sp || '';
        document.getElementById('f-year-ja').value  = entry.year?.ja || '';
        document.getElementById('f-year-en').value  = entry.year?.en || '';
        document.getElementById('f-size-ja').value  = entry.size?.ja || '';
        document.getElementById('f-size-en').value  = entry.size?.en || '';
        document.getElementById('f-desc-ja').value  = entry.description?.ja || '';
        document.getElementById('f-desc-en').value  = entry.description?.en || '';
        document.getElementById('f-desc-sp').value  = entry.description?.sp || '';

        adminFormTitle.textContent   = '作 品 情 報 編 集';
        adminFormEyebrow.textContent = 'EDIT ARTWORK';
        document.getElementById('form-status').textContent = '';

        // ✎ボタンは管理者モード中（=認証済み）のカードにしか表示されないため、そのままフォームを開く
        adminFormOverlay.classList.add('active');
      });
    });

    /* ===== 各作品カードの公開/ジャンル切り替え（管理者モード） ===== */
    document.querySelectorAll('.admin-controls').forEach((panel) => {
      const file = panel.dataset.file;
      const genreSelect = panel.querySelector('.admin-genre-select');
      const publishCheckbox = panel.querySelector('.admin-publish-checkbox');
      const statusEl = panel.querySelector('.admin-save-status');

      async function saveField(patch, label) {
        if (!adminToken) return;
        statusEl.textContent = '保存中...';
        try {
          await updateArtworksJson((current) => {
            const entry = current.find(a => a.file === file);
            if (entry) Object.assign(entry, patch);
          }, `作品情報更新 (${label}): ${file}`);
          statusEl.textContent = '✓ 保存しました';
        } catch (err) {
          statusEl.textContent = `エラー: ${err.message}`;
        }
      }

      if (genreSelect) {
        genreSelect.addEventListener('click', (e) => e.stopPropagation());
        genreSelect.addEventListener('change', () => saveField({ genre: genreSelect.value }, 'ジャンル'));
      }
      if (publishCheckbox) {
        publishCheckbox.addEventListener('click', (e) => e.stopPropagation());
        publishCheckbox.addEventListener('change', () => saveField({ published: publishCheckbox.checked }, '公開設定'));
      }
    });
  </script>

</body>
</html>
