---
// src/pages/[lang]/about/contact.astro — 製作者と連絡先
import AboutSectionLayout from '../../../layouts/AboutSectionLayout.astro';
import type { Lang } from '../../../data/aboutNav';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } },
  ];
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const meta: Record<Lang, { title: string; description: string; pageTitle: string; body: string }> = {
  ja: {
    title: '製作者と連絡先 — 徳永アートミュージアム',
    description: '徳永アートミュージアムの製作者と連絡先',
    pageTitle: '製作者と連絡先',
    body: '現在準備中です。近日公開予定ですので、しばらくお待ちください。',
  },
  en: {
    title: 'Creator & Contact — Tokunaga Art Museum',
    description: 'Creator and contact information for the Tokunaga Art Museum',
    pageTitle: 'Creator & Contact',
    body: 'This page is currently being prepared. Please check back soon.',
  },
  sp: {
    title: 'Autor y contacto — Museo de Arte Tokunaga',
    description: 'Información del autor y contacto del Museo de Arte Tokunaga',
    pageTitle: 'Autor y contacto',
    body: 'Esta página está actualmente en preparación. Vuelva pronto, por favor.',
  },
};
const m = meta[lang] ?? meta.ja;
---

<AboutSectionLayout
  lang={lang}
  base={base}
  slug="contact/"
  metaTitle={m.title}
  metaDescription={m.description}
  pageTitle={m.pageTitle}
>
  <p class="placeholder-notice">{lang === 'ja' ? '準備中' : lang === 'en' ? 'Coming soon' : 'Próximamente'}</p>
  <p>{m.body}</p>
  <p>
    <a href={`${base}/${lang}/#feedback`}>
      {lang === 'ja' ? 'ご感想・ご意見はトップページのフォームからお寄せください →' : lang === 'en' ? 'Please send your feedback using the form on the home page →' : 'Envíe sus opiniones desde el formulario de la página de inicio →'}
    </a>
  </p>
</AboutSectionLayout>
