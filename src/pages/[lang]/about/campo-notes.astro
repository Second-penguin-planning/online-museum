---
// src/pages/[lang]/about/campo-notes.astro — カンポ・デ・クリプターナ 現地の記録
// お世話になった方々への謝辞・小旅行の記録・バーや食事の手引き・芸術についての考察を掲載。
// 出典は src/data/campoNotes.ts 参照。
import AboutSectionLayout from '../../../layouts/AboutSectionLayout.astro';
import type { Lang } from '../../../data/aboutNav';
import { campoNotesContent } from '../../../data/campoNotes';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } },
  ];
}

const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const c = campoNotesContent[lang] ?? campoNotesContent.ja;
---

<AboutSectionLayout
  lang={lang}
  base={base}
  slug="campo-notes/"
  metaTitle={c.metaTitle}
  metaDescription={c.metaDescription}
  pageTitle={c.navTitle}
>
  <div class="cn-hero">
    <h2 class="cn-title">{c.title}</h2>
    <p class="cn-subtitle">{c.subtitle}</p>
  </div>

  <div class="cn-lead">
    {c.lead.map((p) => <p>{p}</p>)}
  </div>

  <div class="cn-sections">
    {c.sections.map((section) => (
      <section class="cn-section">
        <h3>{section.heading}</h3>
        {section.blocks.map((block) => (
          <div class="cn-block">
            {block.subheading && (
              <p class="cn-block__heading">
                {block.subheading}
                {block.badge && <span class="cn-badge">{block.badge}</span>}
              </p>
            )}
            {block.paragraphs && block.paragraphs.map((p) => <p class="cn-block__text">{p}</p>)}
            {block.items && (
              <dl class="cn-items">
                {block.items.map((item) => (
                  <div class="cn-items__row">
                    {item.label && <dt>{item.label}</dt>}
                    <dd>{item.text}</dd>
                  </div>
                ))}
              </dl>
            )}
            {block.bullets && (
              <ul class="cn-bullets">
                {block.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
            {block.callout && (
              <div class="cn-callout">{block.callout}</div>
            )}
          </div>
        ))}
      </section>
    ))}
  </div>

  <p class="cn-related">
    <a href={`${base}/${lang}/about/${c.relatedLink.slug}`}>{c.relatedLink.label}</a>
  </p>
</AboutSectionLayout>

<style>
  .cn-hero {
    padding: 1.2rem 0 1.6rem;
  }
  .cn-title {
    font-size: 1.45rem;
    line-height: 1.5;
    color: var(--crimson);
    letter-spacing: .03em;
    margin-bottom: .5rem;
  }
  .cn-subtitle {
    font-style: italic;
    color: var(--text-mid);
    font-size: .95rem;
    opacity: .85;
  }

  .cn-lead {
    padding-bottom: 1rem;
    margin-bottom: 1.6rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.4);
  }
  .cn-lead :global(p) { font-size: .93rem; }

  .cn-sections {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }
  .cn-section h3 {
    color: var(--crimson);
    font-size: 1.15rem;
    letter-spacing: .02em;
    margin-bottom: 1rem;
    padding-bottom: .5rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.4);
  }

  .cn-block {
    margin-bottom: 1.2rem;
  }
  .cn-block:last-child { margin-bottom: 0; }
  .cn-block__heading {
    font-weight: 600;
    color: var(--text);
    font-size: .98rem;
    margin-bottom: .3rem;
    display: flex;
    align-items: center;
    gap: .5rem;
  }
  .cn-badge {
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .05em;
    color: var(--text-mid);
    background: rgba(74, 10, 10, 0.08);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 3px;
    padding: .1rem .5rem;
  }
  .cn-block__text {
    font-size: .93rem;
    line-height: 1.85;
  }

  .cn-items {
    margin-top: .4rem;
    display: grid;
    gap: .7rem;
  }
  .cn-items__row dt {
    font-weight: 600;
    color: var(--crimson);
    font-size: .9rem;
    margin-bottom: .2rem;
  }
  .cn-items__row dd {
    font-size: .9rem;
    color: var(--text-mid);
    line-height: 1.75;
  }

  .cn-bullets {
    list-style: none;
    display: grid;
    gap: .5rem;
    margin-top: .3rem;
  }
  .cn-bullets li {
    font-size: .92rem;
    line-height: 1.8;
    padding-left: 1.1rem;
    position: relative;
  }
  .cn-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--gold);
  }

  .cn-callout {
    margin-top: .6rem;
    background: rgba(212, 175, 55, 0.1);
    border-left: 3px solid var(--gold);
    border-radius: 4px;
    padding: .8rem 1.1rem;
    font-size: .9rem;
    color: var(--text-mid);
    line-height: 1.8;
  }

  .cn-related {
    margin-top: 2.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(212, 175, 55, 0.4);
    text-align: right;
  }
  .cn-related a {
    color: var(--crimson);
    text-decoration: none;
    font-size: .92rem;
    font-style: italic;
    border-bottom: 1px dotted var(--gold);
    transition: color .2s;
  }
  .cn-related a:hover { color: var(--gold); }
</style>
