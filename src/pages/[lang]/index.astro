---
import artworks from '../../data/artworks.json';
// ui.ts から辞書データをインポート
import { ui, rooms } from '../../data/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } }
  ];
}

const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// 言語に応じたテキストを取得
const t = ui[lang];
const roomNames = rooms[lang];

// ▼ 作品データの加工
const categorizedArtworks = artworks.map((info, i) => {
  let category = 0;
  const match = info.file?.match(/(\d+)/);
  if (match) {
    const num = parseInt(match[1], 10);
    if (num >= 1 && num <= 6) category = 1;       // 1) 異人館
    else if (num >= 7 && num <= 12) category = 2; // 2) ラ・マンチャ
    // 必要に応じて追加
  }
  
  // 額縁のランダムカラー生成
  const hue = 30 + ((i * 7) % 16);
  const sat = 40 + ((i * 11) % 26);
  const lit = 25 + ((i * 13) % 16);
  const frameLight = `hsl(${hue}, ${sat}%, ${lit + 15}%)`;
  const frameDark = `hsl(${hue}, ${sat}%, ${lit - 12}%)`;

  return { 
    ...info, 
    category, 
    frameLight, 
    frameDark,
    // 万が一翻訳データがない場合に備えて、フォールバック（ja）を設定
    title: info.title?.[lang] || info.title?.ja,
    artist: info.artist?.[lang] || info.artist?.ja,
    year: info.year?.[lang] || info.year?.ja,
    size: info.size?.[lang] || info.size?.ja,
    description: info.description?.[lang] || info.description?.ja,
    rawSizeJa: info.size?.ja
  };
});

// カードの横幅を計算
function getCardWidth(sizeStr) {
  const defaultWidth = 280; 
  if (!sizeStr) return defaultWidth;
  const match = sizeStr.match(/(\d+(?:\.\d+)?)/);
  if (!match) return defaultWidth;
  const num = parseFloat(match[1]);
  let scale = 1;
  if (sizeStr.includes('号') || num < 100) {
    scale = num / 30; 
  } else {
    scale = num / 90;
  }
  const clampedScale = Math.max(0.5, Math.min(scale, 2.5));
  return Math.round(defaultWidth * clampedScale);
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="base-url" content={base} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title}</title>
    <style>
      /* --- スタイルは変更なしのため省略（あなたの元のコードをそのまま使ってください） --- */
      /* ... (元のCSSをここに貼り付け) ... */
      /* （※以下、主要なCSSのみ抜粋して維持します） */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: "Helvetica Neue", Arial, sans-serif; background: #111; color: #fff; overflow-x: hidden; }
      .site-header { position: fixed; top: 0; left: 0; width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 25px 50px; z-index: 1000; background: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%); }
      .header-logo { font-size: 1.2rem; letter-spacing: 0.2em; font-weight: 300; color: #fff; text-shadow: 0 2px 10px rgba(0,0,0,0.8); }
      .header-nav { display: flex; align-items: center; gap: 30px; }
      .header-nav a { color: #fff; text-decoration: none; font-size: 0.9rem; letter-spacing: 0.1em; opacity: 0.7; transition: opacity 0.3s, transform 0.3s; text-shadow: 0 2px 8px rgba(0,0,0,0.8); }
      .header-nav a:hover { opacity: 1; transform: translateY(-2px); }
      .lang-switcher { display: flex; gap: 15px; border-left: 1px solid rgba(255,255,255,0.3); padding-left: 20px; margin-left: 10px; }
      .lang-switcher a { font-size: 0.8rem; text-decoration: none; color: #fff; opacity: 0.5; }
      .lang-switcher a.active { opacity: 1; font-weight: bold; color: #f1c40f; }
      
      .entrance { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(rgba(17,17,17,0.5), rgba(17,17,17,0.85)), url('https://images.unsplash.com/photo-1577083165239-0bd9f19fc08f?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat; display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 999; transition: opacity 1.2s, visibility 1.2s; }
      .entrance.hidden { opacity: 0; visibility: hidden; }
      .enter-btn { padding: 16px 50px; border: 1px solid rgba(255,255,255,0.6); background: rgba(0,0,0,0.4); color: #fff; letter-spacing: 0.3em; cursor: pointer; transition: 0.4s; }
      
      .room-selector { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(17,17,17,0.95); display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 998; transition: 1.2s; }
      .room-selector.hidden { opacity: 0; visibility: hidden; }
      .room-list { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; max-width: 900px; }
      .room-btn { padding: 15px 30px; border: 1px solid rgba(255,255,255,0.4); background: rgba(0,0,0,0.5); color: #fff; min-width: 220px; cursor: pointer; transition: 0.3s; }
      
      .museum { opacity: 0; visibility: hidden; transition: 1.2s; min-height: 100vh; }
      .museum.visible { opacity: 1; visibility: visible; }
      .gallery-track { display: flex; gap: 80px; padding: 60px 100px 150px; overflow-x: auto; scroll-behavior: smooth; align-items: center; }
      .artwork-card { flex: 0 0 auto; cursor: pointer; position: relative; transition: 0.3s; }
      .artwork-frame { border-style: solid; border-width: 18px; border-color: var(--frame-light) var(--frame-dark) var(--frame-dark) var(--frame-light); border-radius: 12px; box-shadow: 10px 15px 35px rgba(0,0,0,0.7); }
      .artwork-frame img { width: 100%; display: block; }
      
      .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 2000; justify-content: center; align-items: center; }
      .modal-overlay.active { display: flex; }
      .modal { background: #1a1a1a; padding: 35px; max-width: 720px; width: 92%; max-height: 90vh; overflow-y: auto; position: relative; }
      .modal-close { position: absolute; top: 15px; right: 20px; background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer; }
    </style>
  </head>
  <body>

    <header class="site-header">
      <div class="header-logo">{t.headerTitle}</div>
      <nav class="header-nav">
        <a href="#" id="navTop">{t.backTop}</a>
        <a href="#" onclick={`alert('${t.alertSummary}'); return false;`}>About</a>
        <a href="#" id="navExhibition">{t.roomSelect}</a>
        <a href="#" onclick={`alert('${t.alertShop}'); return false;`}>Shop</a>
        
        <div class="lang-switcher">
          <a href={`${base}/ja/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
          <a href={`${base}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
          <a href={`${base}/sp/`} class={lang === 'sp' ? 'active' : ''}>SP</a>
        </div>
      </nav>
    </header>

    <div class="entrance" id="entrance">
      <h1>{t.title}</h1>
      <p>TOKUNAGA ART MUSEUM</p>
      <button class="enter-btn" id="enterBtn">{t.enter}</button>
    </div>

    <div class="room-selector hidden" id="roomSelector">
      <h2>{t.roomSelect}</h2>
      <div class="room-list">
        {roomNames.map(room => (
          <button class="room-btn" data-room={room.id} data-name={room.name}>
            {room.prefix}{room.name}
          </button>
        ))}
      </div>
      <button class="back-btn" id="backToTopFromSelector" style="margin-top: 40px; background: none; border: none; color: #aaa; cursor: pointer;">{t.backTop}</button>
    </div>

    <div class="museum" id="museum">
      <div style="text-align: center; padding-top: 120px;">
        <h2 id="museumTitle" style="letter-spacing: 0.3em; font-weight: 300;">{t.title}</h2>
        <div id="museumCount" style="color: #666; font-size: 0.8rem; margin-top: 10px;"></div>
      </div>
      <div style="text-align: center; color: #444; font-size: 0.7rem; margin-top: 20px;">{t.scrollHint}</div>

      <div style="position: relative; display: flex; align-items: center;">
        <button class="scroll-arrow left" id="arrowLeft" style="position: absolute; left: 20px; z-index: 10; background: rgba(255,255,255,0.1); border: none; color: #fff; width: 40px; height: 40px; border-radius: 50%; cursor: pointer;">‹</button>
        <div class="gallery-track" id="galleryTrack">
          {categorizedArtworks.map((info) => (
            <div
              class="artwork-card"
              style={`width: ${getCardWidth(info.rawSizeJa)}px; --frame-light: ${info.frameLight}; --frame-dark: ${info.frameDark};`}
              data-category={info.category}
              data-file={info.file}
              data-title={info.title}
              data-artist={info.artist}
              data-year={info.year}
              data-size={info.size}
              data-description={info.description}
            >
              <div class="artwork-frame">
                <img src={`${base}/gallery/${info.file}`} alt={info.title} loading="lazy" />
              </div>
              <div style="text-align: center; margin-top: 25px;">
                <div style="font-size: 0.8rem; color: #ccc;">{info.title}</div>
                <div style="font-size: 0.7rem; color: #666; margin-top: 4px;">{info.artist}</div>
              </div>
            </div>
          ))}
        </div>
        <button class="scroll-arrow right" id="arrowRight" style="position: absolute; right: 20px; z-index: 10; background: rgba(255,255,255,0.1); border: none; color: #fff; width: 40px; height: 40px; border-radius: 50%; cursor: pointer;">›</button>
      </div>
    </div>

    <div class="modal-overlay" id="modalOverlay">
      <div class="modal">
        <button class="modal-close" id="modalClose">✕</button>
        <div style="text-align: center; margin-bottom: 20px;">
          <img id="modalImg" src="" style="max-width: 100%; max-height: 60vh; object-fit: contain;" />
        </div>
        <div id="modalInfo">
          <h3 id="modalTitle" style="margin-bottom: 10px;"></h3>
          <p style="font-size: 0.9rem; color: #aaa; margin-bottom: 20px;">
            <span id="modalArtist"></span> / <span id="modalYear"></span> / <span id="modalSize"></span>
          </p>
          <div id="modalDescription" style="font-size: 0.85rem; line-height: 1.6; color: #ccc; background: #222; padding: 15px;"></div>
        </div>
      </div>
    </div>

    <script define:vars={{ alertPreparing: t.alertPreparing }}>
      const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') ?? '';
      const entrance = document.getElementById('entrance');
      const roomSelector = document.getElementById('roomSelector');
      const museum = document.getElementById('museum');
      const galleryTrack = document.getElementById('galleryTrack');

      // 表示切り替え関数
      function showEntrance() {
        entrance.classList.remove('hidden');
        roomSelector.classList.add('hidden');
        museum.classList.remove('visible');
      }
      function showSelector() {
        entrance.classList.add('hidden');
        roomSelector.classList.remove('hidden');
        museum.classList.remove('visible');
      }

      // イベントリスナー
      document.getElementById('enterBtn').onclick = showSelector;
      document.getElementById('navExhibition').onclick = (e) => { e.preventDefault(); showSelector(); };
      document.getElementById('navTop').onclick = (e) => { e.preventDefault(); showEntrance(); };
      document.getElementById('backToTopFromSelector').onclick = showEntrance;

      // 部屋の選択処理
      document.querySelectorAll('.room-btn').forEach(btn => {
        btn.onclick = () => {
          const roomId = btn.dataset.room;
          const roomName = btn.dataset.name;
          
          if (parseInt(roomId) >= 3) {
            alert(alertPreparing);
            return;
          }

          let count = 0;
          document.querySelectorAll('.artwork-card').forEach(card => {
            if (card.dataset.category === roomId) {
              card.style.display = 'block';
              count++;
            } else {
              card.style.display = 'none';
            }
          });

          document.getElementById('museumTitle').textContent = roomName;
          document.getElementById('museumCount').textContent = count + " WORKS";
          
          galleryTrack.scrollLeft = 0;
          roomSelector.classList.add('hidden');
          museum.classList.add('visible');
        };
      });

      // スクロール・モーダル処理（あなたの元のスクリプトを維持）
      document.getElementById('arrowLeft').onclick = () => galleryTrack.scrollBy({ left: -400, behavior: 'smooth' });
      document.getElementById('arrowRight').onclick = () => galleryTrack.scrollBy({ left: 400, behavior: 'smooth' });

      document.querySelectorAll('.artwork-card').forEach(card => {
        card.onclick = () => {
          document.getElementById('modalImg').src = `${base}/gallery/${card.dataset.file}`;
          document.getElementById('modalTitle').textContent = card.dataset.title;
          document.getElementById('modalArtist').textContent = card.dataset.artist;
          document.getElementById('modalYear').textContent = card.dataset.year;
          document.getElementById('modalSize').textContent = card.dataset.size;
          document.getElementById('modalDescription').textContent = card.dataset.description;
          document.getElementById('modalOverlay').classList.add('active');
        };
      });

      document.getElementById('modalClose').onclick = () => document.getElementById('modalOverlay').classList.remove('active');
      document.getElementById('modalOverlay').onclick = (e) => { if(e.target.id === 'modalOverlay') e.target.classList.remove('active'); };
    </script>
  </body>
</html>