---
import artworks from '../../data/artworks.json';
import { ui, rooms } from '../../data/ui.ts';
import { readdirSync } from 'fs';
import { join } from 'path';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } }
  ];
}

const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const t = ui[lang];
const roomNames = rooms[lang];

// galleryフォルダの全画像ファイルを取得
const galleryDir = join(process.cwd(), 'public/gallery');
const allGalleryFiles = readdirSync(galleryDir)
  .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
  .filter(f => f.startsWith('01') || f.startsWith('02'))
  .sort();

// artworks.jsonに登録済みのファイル名セット
const registeredFiles = new Set(artworks.map(a => a.file));

// 未登録ファイルを空エントリとして追加
const unregisteredEntries = allGalleryFiles
  .filter(f => !registeredFiles.has(f))
  .map(f => ({ file: f }));

const allArtworks = [...artworks, ...unregisteredEntries];

const categorizedArtworks = allArtworks.map((info, i) => {
  let category = 0;
  if (info.file?.startsWith('01')) category = 1;
  else if (info.file?.startsWith('02')) category = 2;

  const hue = (i * 47) % 360;
  const sat = 18 + ((i * 7) % 14);
  const lit = 28 + ((i * 11) % 12);
  const frameLight = `hsl(${hue}, ${sat}%, ${lit + 12}%)`;
  const frameDark  = `hsl(${hue}, ${sat}%, ${lit - 10}%)`;

  return {
    ...info,
    category,
    frameLight,
    frameDark,
    title:       info.title?.[lang]       || info.title?.ja       || '—',
    artist:      info.artist?.[lang]      || info.artist?.ja      || '—',
    year:        info.year?.[lang]        || info.year?.ja        || '—',
    size:        info.size?.[lang]        || info.size?.ja        || '—',
    description: info.description?.[lang] || info.description?.ja || '',
    rawSizeJa:   info.size?.ja
  };
});

function getCardWidth(sizeStr) {
  const defaultWidth = 280; 
  if (!sizeStr) return defaultWidth;
  const match = sizeStr.match(/(\d+(?:\.\d+)?)/);
  if (!match) return defaultWidth;
  const num = parseFloat(match[1]);
  let scale = 1;
  if (sizeStr.includes('号') || num < 100) {
    scale = num / 30; 
  } else {
    scale = num / 90;
  }
  const clampedScale = Math.max(0.5, Math.min(scale, 2.5));
  return Math.round(defaultWidth * clampedScale);
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="base-url" content={base} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title}</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      :root {
        --crimson-deep:   #4a0a0a;
        --crimson-mid:    #6b1212;
        --crimson-rich:   #8b1a1a;
        --crimson-warm:   #a52020;
        --gold-dim:       #b8960c;
        --gold-bright:    #d4af37;
        --gold-light:     #e8cc6a;
        --parchment:      #f5efe0;
        --text-main:      #f0e6d3;
        --text-sub:       #c4a882;
        --text-muted:     #7a6452;
        --overlay-dark:   rgba(20, 4, 4, 0.75);
      }

      body {
        font-family: "Garamond", "Times New Roman", "游明朝", serif;
        background: var(--crimson-deep);
        color: var(--text-main);
        overflow-x: hidden;
      }

      .site-header {
        position: fixed;
        top: 0; left: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 50px;
        z-index: 1000;
        background: linear-gradient(
          to bottom,
          rgba(20, 4, 4, 0.95) 0%,
          rgba(20, 4, 4, 0.0) 100%
        );
        border-bottom: 1px solid rgba(212, 175, 55, 0.15);
      }

      .header-logo {
        font-size: 1.1rem;
        letter-spacing: 0.25em;
        font-weight: 400;
        color: var(--gold-bright);
        text-shadow: 0 2px 12px rgba(0,0,0,0.9);
        flex-shrink: 0;
      }

      .header-nav {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .header-nav a,
      .header-nav button {
        color: var(--text-sub);
        text-decoration: none;
        font-size: 0.82rem;
        letter-spacing: 0.15em;
        opacity: 0.85;
        transition: opacity 0.3s, color 0.3s, transform 0.3s;
        text-shadow: 0 2px 8px rgba(0,0,0,0.9);
        white-space: nowrap;
        background: none;
        border: none;
        font-family: inherit;
        cursor: pointer;
        padding: 0;
      }

      .header-nav a:hover,
      .header-nav button:hover {
        opacity: 1;
        color: var(--gold-light);
        transform: translateY(-1px);
      }

      .lang-switcher {
        display: flex;
        gap: 12px;
        border-left: 1px solid rgba(212, 175, 55, 0.3);
        padding-left: 18px;
        margin-left: 8px;
      }

      .lang-switcher a {
        font-size: 0.75rem;
        text-decoration: none;
        color: var(--text-sub);
        opacity: 0.55;
        letter-spacing: 0.1em;
        transition: opacity 0.3s, color 0.3s;
      }

      .lang-switcher a.active {
        opacity: 1;
        font-weight: bold;
        color: var(--gold-bright);
      }

      .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 40px;
        height: 40px;
        background: none;
        border: 1px solid rgba(212, 175, 55, 0.3);
        cursor: pointer;
        padding: 8px;
        flex-shrink: 0;
        transition: border-color 0.3s;
        z-index: 1100;
        position: relative;
      }

      .hamburger:hover { border-color: var(--gold-bright); }

      .hamburger span {
        display: block;
        width: 22px;
        height: 1.5px;
        background: var(--gold-bright);
        transition: transform 0.35s ease, opacity 0.35s ease;
        transform-origin: center;
      }

      .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
      .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
      .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

      .mobile-menu {
        position: fixed;
        top: 0; right: 0;
        width: min(280px, 80vw);
        height: 100%;
        background: linear-gradient(
          160deg,
          rgba(20, 4, 4, 0.98) 0%,
          rgba(50, 8, 8, 0.98) 100%
        );
        border-left: 1px solid rgba(212, 175, 55, 0.2);
        z-index: 1050;
        flex-direction: column;
        padding: 80px 32px 40px;
        gap: 0;
        transform: translateX(100%);
        transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1);
        box-shadow: -8px 0 30px rgba(0,0,0,0.6);
        display: flex;
        pointer-events: none;
      }

      .mobile-menu.open {
        transform: translateX(0);
        pointer-events: auto;
      }

      .mobile-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1040;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease, visibility 0.4s ease;
        pointer-events: none;
      }

      .mobile-overlay.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .mobile-menu-nav {
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .mobile-menu-nav a,
      .mobile-menu-nav button {
        display: block;
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        border-bottom: 1px solid rgba(212, 175, 55, 0.12);
        color: var(--text-sub);
        font-family: inherit;
        font-size: 0.88rem;
        letter-spacing: 0.2em;
        padding: 18px 0;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.3s, padding-left 0.3s;
      }

      .mobile-menu-nav a:hover,
      .mobile-menu-nav button:hover {
        color: var(--gold-light);
        padding-left: 8px;
      }

      .mobile-menu-nav a:first-child,
      .mobile-menu-nav button:first-child {
        border-top: 1px solid rgba(212, 175, 55, 0.12);
      }

      .mobile-lang-switcher {
        display: flex;
        gap: 16px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid rgba(212, 175, 55, 0.2);
      }

      .mobile-lang-switcher a {
        font-size: 0.8rem;
        text-decoration: none;
        color: var(--text-sub);
        opacity: 0.55;
        letter-spacing: 0.12em;
        transition: opacity 0.3s, color 0.3s;
      }

      .mobile-lang-switcher a.active {
        opacity: 1;
        font-weight: bold;
        color: var(--gold-bright);
      }

      .entrance {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 990;
        transition: opacity 1.4s ease, visibility 1.4s ease;
        background:
          url('/hero.png') center / cover no-repeat;
      }

      .entrance.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .hero-inner {
        position: absolute;
        bottom: 28%;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        padding: 0 24px;
      }

      .hero-eyebrow {
        font-size: clamp(0.55rem, 2.5vw, 0.75rem);
        letter-spacing: 0.35em;
        color: var(--gold-dim);
        text-transform: uppercase;
        margin-bottom: 16px;
        opacity: 0.9;
      }

      .hero-title {
        font-size: clamp(1.6rem, 6vw, 3.8rem);
        font-weight: 400;
        letter-spacing: 0.15em;
        line-height: 1.15;
        color: var(--text-main);
        text-shadow:
          0 2px 20px rgba(0,0,0,0.9),
          0 0 60px rgba(180, 30, 30, 0.4);
        margin-bottom: 10px;
      }

      .hero-subtitle {
        font-size: clamp(0.55rem, 2.5vw, 0.85rem);
        letter-spacing: 0.4em;
        color: var(--gold-bright);
        text-transform: uppercase;
        margin-bottom: 36px;
        opacity: 0.8;
      }

      .hero-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 36px;
        width: min(260px, 70vw);
      }

      .hero-divider::before,
      .hero-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
      }

      .hero-divider-diamond {
        width: 6px;
        height: 6px;
        background: var(--gold-bright);
        transform: rotate(45deg);
        flex-shrink: 0;
      }

      .enter-btn {
        position: relative;
        padding: 14px 48px;
        background: transparent;
        color: transparent;
        font-family: inherit;
        font-size: clamp(0.68rem, 2.5vw, 0.82rem);
        letter-spacing: 0.4em;
        text-transform: uppercase;
        cursor: pointer;
        border: none;
        width: 220px;
        min-height: 52px;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }

      .room-selector {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 992;
        transition: opacity 1.2s ease, visibility 1.2s ease;
        overflow-y: auto;
        padding: 80px 20px 40px;
        background:
          linear-gradient(
            135deg,
            rgba(20, 4, 4, 0.97) 0%,
            rgba(50, 8, 8, 0.95) 50%,
            rgba(20, 4, 4, 0.97) 100%
          ),
          repeating-linear-gradient(
            0deg,
            rgba(212, 175, 55, 0.02) 0px,
            rgba(212, 175, 55, 0.02) 1px,
            transparent 1px,
            transparent 60px
          );
      }

      .room-selector.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .room-selector-title {
        font-size: clamp(0.6rem, 2.5vw, 0.78rem);
        letter-spacing: 0.5em;
        color: var(--gold-dim);
        text-transform: uppercase;
        margin-bottom: 12px;
        text-align: center;
      }

      .room-selector-heading {
        font-size: clamp(1.2rem, 4vw, 2rem);
        font-weight: 400;
        letter-spacing: 0.2em;
        color: var(--text-main);
        margin-bottom: 40px;
        text-align: center;
      }

      .room-list {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: center;
        max-width: 860px;
        width: 100%;
        padding: 0;
      }

      .room-btn {
        position: relative;
        padding: 18px 28px;
        background: rgba(74, 10, 10, 0.35);
        color: var(--text-sub);
        font-family: inherit;
        font-size: clamp(0.78rem, 2.5vw, 0.82rem);
        letter-spacing: 0.18em;
        min-width: min(210px, 42vw);
        cursor: pointer;
        border: none;
        text-align: left;
        transition: color 0.35s ease, background 0.35s ease;
        overflow: hidden;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        min-height: 44px;
      }

      .room-btn::before {
        content: '';
        position: absolute;
        left: 0; top: 0;
        width: 3px;
        height: 100%;
        background: var(--gold-dim);
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 0.35s cubic-bezier(0.76, 0, 0.24, 1);
      }

      .room-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        border: 1px solid rgba(212, 175, 55, 0.25);
        transition: border-color 0.35s ease;
      }

      .room-btn:hover {
        background: rgba(139, 26, 26, 0.45);
        color: var(--gold-light);
      }

      .room-btn:hover::before { transform: scaleY(1); }
      .room-btn:hover::after  { border-color: rgba(212, 175, 55, 0.55); }

      .room-btn-number {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.3em;
        color: var(--gold-dim);
        margin-bottom: 6px;
        transition: color 0.35s;
      }

      .room-btn:hover .room-btn-number { color: var(--gold-bright); }

      .back-btn {
        margin-top: 40px;
        background: none;
        border: none;
        color: var(--text-muted);
        font-family: inherit;
        font-size: 0.75rem;
        letter-spacing: 0.35em;
        cursor: pointer;
        text-transform: uppercase;
        transition: color 0.3s;
        position: relative;
        padding: 6px 0;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        min-height: 44px;
      }

      .back-btn::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0;
        width: 100%;
        height: 1px;
        background: var(--gold-dim);
        transform: scaleX(0);
        transition: transform 0.3s ease;
      }

      .back-btn:hover { color: var(--text-sub); }
      .back-btn:hover::after { transform: scaleX(1); }

      .museum {
        opacity: 0;
        visibility: hidden;
        transition: opacity 1.2s ease, visibility 1.2s ease;
        min-height: 100vh;
        background:
          linear-gradient(
            to bottom,
            var(--crimson-deep) 0%,
            #2a0808 18%,
            #1a0505 35%,
            #120303 100%
          );
      }

      .museum.visible {
        opacity: 1;
        visibility: visible;
      }

      .museum-header {
        text-align: center;
        padding-top: 90px;
        padding-bottom: 4px;
        position: relative;
        padding-left: 20px;
        padding-right: 20px;
      }

      .museum-header::after {
        content: '';
        display: block;
        width: 80px;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
        margin: 8px auto 0;
      }

      .museum-header-row {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .museum-title {
        font-size: clamp(1rem, 4vw, 1.8rem);
        font-weight: 400;
        letter-spacing: 0.3em;
        color: var(--text-main);
      }

      .museum-count {
        color: var(--text-muted);
        font-size: 0.72rem;
        letter-spacing: 0.25em;
      }

      .scroll-hint {
        text-align: center;
        color: var(--text-muted);
        font-size: 0.65rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-top: 6px;
      }

      .gallery-wrap {
        position: relative;
        display: flex;
        align-items: center;
        margin-top: 2px;
      }

      .gallery-track {
        display: flex;
        gap: 60px;
        padding: 30px 80px 120px;
        overflow-x: auto;
        scroll-behavior: smooth;
        align-items: center;
        scrollbar-width: thin;
        scrollbar-color: var(--crimson-mid) var(--crimson-deep);
        -webkit-overflow-scrolling: touch;
        width: 100%;
      }

      .gallery-track::-webkit-scrollbar { height: 4px; }
      .gallery-track::-webkit-scrollbar-track { background: var(--crimson-deep); }
      .gallery-track::-webkit-scrollbar-thumb { background: var(--crimson-mid); border-radius: 2px; }

      .scroll-arrow {
        position: absolute;
        z-index: 10;
        background: rgba(74, 10, 10, 0.7);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: var(--gold-bright);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 1.3rem;
        transition: background 0.3s, border-color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
        flex-shrink: 0;
      }

      .scroll-arrow:hover {
        background: rgba(139, 26, 26, 0.9);
        border-color: var(--gold-bright);
      }

      .scroll-arrow.left  { left: 6px; }
      .scroll-arrow.right { right: 6px; }

      .artwork-card {
        flex: 0 0 auto;
        cursor: pointer;
        position: relative;
        transition: transform 0.35s ease;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }

      .artwork-card:hover { transform: translateY(-6px); }

      .artwork-frame {
        border-style: solid;
        border-width: 14px;
        border-color:
          var(--frame-light)
          var(--frame-dark)
          var(--frame-dark)
          var(--frame-light);
        border-radius: 8px;
        box-shadow:
          8px 12px 28px rgba(0,0,0,0.8),
          0 0 0 1px rgba(0,0,0,0.4),
          inset 0 0 16px rgba(0,0,0,0.3);
      }

      .artwork-frame img {
        width: 100%;
        display: block;
      }

      .artwork-label {
        text-align: center;
        margin-top: 18px;
        padding: 0 4px;
      }

      .artwork-label-title {
        font-size: 0.78rem;
        color: var(--text-sub);
        letter-spacing: 0.08em;
      }

      .artwork-label-artist {
        font-size: 0.68rem;
        color: var(--text-muted);
        margin-top: 5px;
        letter-spacing: 0.06em;
      }

      .modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(10, 2, 2, 0.93);
        z-index: 2000;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(4px);
        padding: 16px;
      }

      .modal-overlay.active { display: flex; }

      .modal {
        background: linear-gradient(160deg, #1e0808 0%, #150404 100%);
        border: 1px solid rgba(212, 175, 55, 0.2);
        padding: 32px 24px;
        max-width: 740px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        box-shadow:
          0 30px 80px rgba(0,0,0,0.8),
          inset 0 1px 0 rgba(212, 175, 55, 0.1);
        -webkit-overflow-scrolling: touch;
      }

      .modal-close {
        position: absolute;
        top: 12px; right: 14px;
        background: none;
        border: 1px solid rgba(212, 175, 55, 0.25);
        color: var(--text-sub);
        font-size: 1rem;
        width: 34px;
        height: 34px;
        cursor: pointer;
        transition: border-color 0.3s, color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
      }

      .modal-close:hover {
        border-color: var(--gold-bright);
        color: var(--gold-bright);
      }

      .modal-title {
        font-size: clamp(1rem, 3.5vw, 1.2rem);
        font-weight: 400;
        letter-spacing: 0.1em;
        color: var(--text-main);
        margin-bottom: 10px;
        padding-right: 40px;
      }

      .modal-meta {
        font-size: clamp(0.72rem, 2.5vw, 0.82rem);
        color: var(--text-muted);
        margin-bottom: 22px;
        letter-spacing: 0.05em;
        line-height: 1.8;
      }

      .modal-description {
        font-size: clamp(0.8rem, 2.5vw, 0.85rem);
        line-height: 1.75;
        color: var(--text-sub);
        background: rgba(255,255,255,0.03);
        border-left: 2px solid var(--gold-dim);
        padding: 14px 16px;
      }

      @media (max-width: 768px) {
        .site-header { padding: 12px 18px; }
        .header-logo { font-size: 0.82rem; letter-spacing: 0.15em; }
        .header-nav  { display: none; }
        .hamburger   { display: flex; }

        .gallery-track { gap: 36px; padding: 40px 56px 80px; }
        .scroll-arrow { width: 32px; height: 32px; font-size: 1.1rem; }
        .scroll-arrow.left  { left: 4px; }
        .scroll-arrow.right { right: 4px; }

        .modal { padding: 28px 18px; max-height: 88vh; }
        .modal-meta { display: flex; flex-direction: column; gap: 2px; }
        .modal-meta .sep { display: none; }

        .room-btn { min-width: calc(50vw - 28px); padding: 16px 18px; }
        .museum-header { padding-top: 80px; }
      }

      @media (max-width: 480px) {
        .gallery-track { gap: 28px; padding: 36px 48px 70px; }
        .room-list { gap: 10px; }
        .room-btn { min-width: calc(100vw - 56px); }
      }
    </style>
  </head>
  <body>

    <!-- ===== SP-FAMILYBAR START ===== -->
    <div class="sp-familybar sp-familybar--dark">
      <a href="https://second-penguin.com/#sp-apps" target="_blank" rel="noopener" class="sp-familybar__link">
        セコンドペンギン企画 ファミリーサイト一覧へ <span aria-hidden="true">→</span>
      </a>
    </div>
    <style>
      .sp-familybar { padding: 8px 16px; text-align: center; font-family: -apple-system, "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif; }
      .sp-familybar--dark { background: #16181d; border-bottom: 1px solid #33363f; }
      .sp-familybar__link { font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
      .sp-familybar--dark .sp-familybar__link { color: #e8e2d0; }
      .sp-familybar__link:hover { text-decoration: underline; }
    </style>
    <!-- ===== SP-FAMILYBAR END ===== -->

    <!-- ヘッダー -->
    <header class="site-header">
      <div class="header-logo">{t.headerTitle}</div>

      <!-- PC用ナビ -->
      <nav class="header-nav">
        <a href="#" id="navTop">{t.backTop}</a>
        <a href={`${base}/${lang}/about/`}>{t.navAbout}</a>
        <a href="#" id="navExhibition">{t.roomSelect}</a>
        <a href={`${base}/${lang}/shop/`}>{t.navShop}</a>
        <a href={`${base}/${lang}/storage/`}>{t.navStorage}</a>
        <div class="lang-switcher">
          <a href={`${base}/ja/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
          <a href={`${base}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
          <a href={`${base}/sp/`} class={lang === 'sp' ? 'active' : ''}>SP</a>
        </div>
      </nav>

      <!-- ハンバーガーボタン -->
      <button class="hamburger" id="hamburgerBtn" aria-label="メニューを開く">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <!-- モバイルオーバーレイ -->
    <div class="mobile-overlay" id="mobileOverlay"></div>

    <!-- モバイルメニュー -->
    <div class="mobile-menu" id="mobileMenu">
      <nav class="mobile-menu-nav">
        <a href="#" id="mNavTop">{t.backTop}</a>
        <a href={`${base}/${lang}/about/`}>{t.navAbout}</a>
        <button id="mNavExhibition">{t.roomSelect}</button>
        <a href={`${base}/${lang}/shop/`}>{t.navShop}</a>
        <a href={`${base}/${lang}/storage/`}>{t.navStorage}</a>
      </nav>
      <div class="mobile-lang-switcher">
        <a href={`${base}/ja/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
        <a href={`${base}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
        <a href={`${base}/sp/`} class={lang === 'sp' ? 'active' : ''}>SP</a>
      </div>
    </div>

    <!-- ヒーロー / 入口 -->
    <div class="entrance" id="entrance">
      <div class="hero-inner">
        <button class="enter-btn" id="enterBtn">{t.enter}</button>
      </div>
    </div>

    <!-- 展示室セレクター -->
    <div class="room-selector hidden" id="roomSelector">
      <p class="room-selector-title">EXHIBITION ROOMS</p>
      <h2 class="room-selector-heading">{t.roomSelect}</h2>
      <div class="room-list">
        {roomNames.map((room, idx) => (
          <button class="room-btn" data-room={room.id} data-name={room.name}>
            <span class="room-btn-number">ROOM {String(idx + 1).padStart(2, '0')}</span>
            {room.prefix}{room.name}
          </button>
        ))}
      </div>
      <button class="back-btn" id="backToTopFromSelector">{t.backTop}</button>
    </div>

    <!-- ミュージアム本体 -->
    <div class="museum" id="museum">
      <div class="museum-header">
        <div class="museum-header-row">
          <h2 class="museum-title" id="museumTitle">{t.title}</h2>
          <div class="museum-count" id="museumCount"></div>
        </div>
      </div>
      <div class="scroll-hint">{t.scrollHint}</div>

      <div class="gallery-wrap">
        <button class="scroll-arrow left" id="arrowLeft">&#8249;</button>
        <div class="gallery-track" id="galleryTrack">
          {categorizedArtworks.map((info) => (
            <div
              class="artwork-card"
              style={`width: ${getCardWidth(info.rawSizeJa)}px; --frame-light: ${info.frameLight}; --frame-dark: ${info.frameDark};`}
              data-category={info.category}
              data-file={info.file}
              data-title={info.title}
              data-artist={info.artist}
              data-year={info.year}
              data-size={info.size}
              data-description={info.description}
              data-frame-light={info.frameLight}
              data-frame-dark={info.frameDark}
            >
              <div class="artwork-frame">
                <img src={`${base}/gallery/${info.file}`} alt={info.title} loading="lazy" />
              </div>
              <div class="artwork-label">
                <div class="artwork-label-title">{info.title}</div>
                <div class="artwork-label-artist">{info.artist}</div>
              </div>
            </div>
          ))}
        </div>
        <button class="scroll-arrow right" id="arrowRight">&#8250;</button>
      </div>
    </div>

    <!-- モーダル -->
    <div class="modal-overlay" id="modalOverlay">
      <div class="modal">
        <button class="modal-close" id="modalClose">✕</button>
        <div style="text-align: center; margin-bottom: 20px;">
          <div id="modalFrame" style="display: inline-block; border-style: solid; border-width: 18px; border-radius: 6px; box-shadow: 8px 12px 32px rgba(0,0,0,0.85), 0 0 0 1px rgba(0,0,0,0.4), inset 0 0 20px rgba(0,0,0,0.3);">
            <img id="modalImg" src="" style="max-width: 100%; max-height: 48vh; object-fit: contain; display: block;" />
          </div>
        </div>
        <h3 class="modal-title" id="modalTitle"></h3>
        <p class="modal-meta">
          <span id="modalArtist"></span>
          <span class="sep">&ensp;/&ensp;</span>
          <span id="modalYear"></span>
          <span class="sep">&ensp;/&ensp;</span>
          <span id="modalSize"></span>
        </p>
        <div class="modal-description" id="modalDescription"></div>
      </div>
    </div>

    <script define:vars={{ alertPreparing: t.alertPreparing, alertShop: t.alertShop }}>
      const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') ?? '';
      const entrance     = document.getElementById('entrance');
      const roomSelector = document.getElementById('roomSelector');
      const museum       = document.getElementById('museum');
      const galleryTrack = document.getElementById('galleryTrack');

      const hamburgerBtn  = document.getElementById('hamburgerBtn');
      const mobileMenu    = document.getElementById('mobileMenu');
      const mobileOverlay = document.getElementById('mobileOverlay');

      // モバイルメニュー開閉
      function openMobileMenu() {
        hamburgerBtn.classList.add('open');
        mobileMenu.classList.add('open');
        mobileOverlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeMobileMenu() {
        hamburgerBtn.classList.remove('open');
        mobileMenu.classList.remove('open');
        mobileOverlay.classList.remove('open');
        document.body.style.overflow = '';
      }

      hamburgerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (mobileMenu.classList.contains('open')) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      });

      mobileOverlay.addEventListener('click', closeMobileMenu);

      // 画面遷移
      function showEntrance() {
        entrance.classList.remove('hidden');
        roomSelector.classList.add('hidden');
        museum.classList.remove('visible');
        closeMobileMenu();
      }

      function showSelector() {
        entrance.classList.add('hidden');
        roomSelector.classList.remove('hidden');
        museum.classList.remove('visible');
        closeMobileMenu();
      }

      document.getElementById('navExhibition').addEventListener('click', (e) => {
        e.preventDefault();
        showSelector();
      });
      document.getElementById('navTop').addEventListener('click', (e) => {
        e.preventDefault();
        showEntrance();
      });
      document.getElementById('backToTopFromSelector').addEventListener('click', showEntrance);
      document.getElementById('enterBtn').addEventListener('click', (e) => {
        e.preventDefault();
        showSelector();
      });
      document.getElementById('mNavTop').addEventListener('click', (e) => {
        e.preventDefault();
        showEntrance();
      });
      document.getElementById('mNavExhibition').addEventListener('click', (e) => {
        e.preventDefault();
        showSelector();
      });

      // 展示室選択
      document.querySelectorAll('.room-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const roomId   = btn.dataset.room;
          const roomName = btn.dataset.name;

          if (parseInt(roomId) >= 3) {
            alert(alertPreparing);
            return;
          }

          let count = 0;
          document.querySelectorAll('.artwork-card').forEach(card => {
            if (card.dataset.category === roomId) {
              card.style.display = 'block';
              count++;
            } else {
              card.style.display = 'none';
            }
          });

          document.getElementById('museumTitle').textContent = roomName;
          document.getElementById('museumCount').textContent = count + ' WORKS';

          galleryTrack.scrollLeft = 0;
          roomSelector.classList.add('hidden');
          museum.classList.add('visible');
        });
      });

      // スクロール矢印
      document.getElementById('arrowLeft').addEventListener('click', () => {
        galleryTrack.scrollBy({ left: -360, behavior: 'smooth' });
      });
      document.getElementById('arrowRight').addEventListener('click', () => {
        galleryTrack.scrollBy({ left: 360, behavior: 'smooth' });
      });

      // アートワークモーダル
      document.querySelectorAll('.artwork-card').forEach(card => {
        card.addEventListener('click', () => {
          document.getElementById('modalImg').src                 = `${base}/gallery/${card.dataset.file}`;
          document.getElementById('modalTitle').textContent       = card.dataset.title;
          document.getElementById('modalArtist').textContent      = card.dataset.artist;
          document.getElementById('modalYear').textContent        = card.dataset.year;
          document.getElementById('modalSize').textContent        = card.dataset.size;
          document.getElementById('modalDescription').textContent = card.dataset.description;
          const frameLight = card.dataset.frameLight;
          const frameDark  = card.dataset.frameDark;
          const modalFrame = document.getElementById('modalFrame');
          modalFrame.style.borderColor = `${frameLight} ${frameDark} ${frameDark} ${frameLight}`;
          document.getElementById('modalOverlay').classList.add('active');
        });
      });

      document.getElementById('modalClose').addEventListener('click', () => {
        document.getElementById('modalOverlay').classList.remove('active');
      });

      document.getElementById('modalOverlay').addEventListener('click', (e) => {
        if (e.target.id === 'modalOverlay') {
          e.target.classList.remove('active');
        }
      });
    </script>
  </body>
</html>
