---
import artworks from '../../data/artworks.json';
import { ui, rooms, home } from '../../data/ui.ts';
import { campoConceptContent } from '../../data/campoConcept.ts';
import AboutNavDropdown from '../../components/AboutNavDropdown.astro';
import SeoMeta from '../../components/SeoMeta.astro';
import { WORK_LABELS } from '../../data/works.ts';
import { legacy, pillarWorks, VIP_EMAIL } from '../../data/legacy.ts';
import { launch, CAMPO_LP_URL, FEEDBACK_FORM_URL, FEEDBACK_FORM_FAV_ENTRY, FEEDBACK_EMAIL, TOUR_FORM_URL, TOUR_EMAIL, EXHIBITION } from '../../data/launch.ts';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } }
  ];
}

const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const t = ui[lang];
const roomNames = rooms[lang];
const concept = campoConceptContent[lang] ?? campoConceptContent.ja;
const h = home[lang] ?? home.ja;

// 所蔵庫で「ギャラリーに公開」を選んだ作品だけを展示する
const publishedArtworks = artworks.filter(a => a.published);

const DRAWING_LABEL = { ja: '素描', en: 'Drawing', sp: 'Dibujo' };

const categorizedArtworks = publishedArtworks.map((info, i) => {
  let category = 0;
  if (info.artistKey === 'takuma') category = 1;
  else if (info.artistKey === 'sachiko') category = 2;

  return {
    ...info,
    category,
    title:       info.title?.[lang]       || info.title?.ja       || '—',
    artist:      info.artist?.[lang]      || info.artist?.ja      || '—',
    year:        info.year?.[lang]        || info.year?.ja        || '—',
    // 素描は号数の後ろに技法を添える（油彩は表記しない）
    size:        [info.size?.[lang] || info.size?.ja, info.medium === 'drawing' ? DRAWING_LABEL[lang] : ''].filter(Boolean).join(' ・ ') || '—',
    description: info.description?.[lang] || info.description?.ja || '',
    rawSizeJa:   info.size?.ja
  };
});

// ホームの「展示室」カード用：部屋ごとの作品数と代表作
const ROOM_COVER: Record<string, string> = { '1': '01018.jpg' };
const roomCards = roomNames.map((room) => {
  const works = categorizedArtworks.filter((a) => String(a.category) === room.id);
  const cover = works.find((a) => a.file === ROOM_COVER[room.id]) ?? works[0];
  return { ...room, count: works.length, cover: cover?.file };
}).filter((room) => room.count > 0);

// 「今日の一枚」の初期表示（JSが読み込まれると訪問ごとに入れ替わる）
const todayDefault = categorizedArtworks.find((a) => a.file === '01044.jpg') ?? categorizedArtworks[0];

// 「2つの柱」（神戸／カンポ）で取り上げる作品
const lg = legacy[lang] ?? legacy.ja;
const workByFile = (file) => categorizedArtworks.find((a) => a.file === file);
const pillars = (['kobe', 'campo'] as const).map((key) => ({
  key,
  ...lg[key],
  feature: workByFile(pillarWorks[key].feature),
  others: pillarWorks[key].others.map(workByFile).filter(Boolean),
}));
const lpUrl = CAMPO_LP_URL;
const ln = launch[lang] ?? launch.ja;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(EXHIBITION.mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(EXHIBITION.mapQuery)}`;
const calLink = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(ln.exCalTitle)}&dates=${EXHIBITION.calendarDates}&location=${encodeURIComponent(EXHIBITION.mapQuery)}`;
// 「二つの故郷」バナーの背景に使うカンポの作品
const lpBanner = workByFile(pillarWorks.campo.feature);

function getCardWidth(sizeStr) {
  const defaultWidth = 280; 
  if (!sizeStr) return defaultWidth;
  const match = sizeStr.match(/(\d+(?:\.\d+)?)/);
  if (!match) return defaultWidth;
  const num = parseFloat(match[1]);
  let scale = 1;
  if (sizeStr.includes('号') || num < 100) {
    scale = num / 30; 
  } else {
    scale = num / 90;
  }
  const clampedScale = Math.max(0.5, Math.min(scale, 2.5));
  return Math.round(defaultWidth * clampedScale);
}

// 額の太さは作品の大きさ（表示幅）に合わせる
function getFrameWidth(cardWidth) {
  return Math.max(10, Math.min(Math.round(cardWidth * 0.055), 32));
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="base-url" content={base} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${t.title}｜${h.tagline}`}</title>
    <SeoMeta lang={lang} title={`${t.title}｜${h.tagline}`} description={h.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Noto+Serif+JP:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      /* 美術館の展示室のような、チャコールの地に金のアクセント */
      :root {
        --crimson-deep:   #141210;
        --crimson-mid:    #1c1915;
        --crimson-rich:   #25211b;
        --crimson-warm:   #302a21;
        --gold-dim:       #8f7642;
        --gold-bright:    #c9a961;
        --gold-light:     #e6cf96;
        --parchment:      #171512;
        --text-main:      #efe8d8;
        --text-sub:       #c4baa5;
        --text-muted:     #8e8574;
        --overlay-dark:   rgba(12, 10, 8, 0.8);
        --serif-jp:       "Noto Serif JP", "游明朝", "Yu Mincho", serif;
        --serif-latin:    "Cormorant Garamond", "Garamond", serif;
      }

      body {
        font-family: var(--serif-latin), var(--serif-jp);
        background: var(--crimson-deep);
        color: var(--text-main);
        overflow-x: hidden;
      }

      .site-header {
        position: fixed;
        top: 0; left: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 50px;
        gap: 32px;
        z-index: 1000;
        background: linear-gradient(
          to bottom,
          rgba(12, 10, 8, 0.85) 0%,
          rgba(12, 10, 8, 0.0) 100%
        );
        border-bottom: 1px solid rgba(201, 169, 97, 0.12);
      }

      .site-header.solid {
        background: rgba(16, 14, 12, 0.96);
        box-shadow: 0 1px 20px rgba(0, 0, 0, 0.5);
      }

      .header-logo {
        font-size: 1.1rem;
        letter-spacing: 0.25em;
        font-weight: 400;
        color: var(--gold-bright);
        text-decoration: none;
        text-shadow: 0 1px 8px rgba(0,0,0,0.6);
        flex-shrink: 0;
      }

      .header-nav {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .header-nav a,
      .header-nav button {
        color: var(--text-sub);
        text-decoration: none;
        font-size: 0.82rem;
        letter-spacing: 0.15em;
        opacity: 0.85;
        transition: opacity 0.3s, color 0.3s, transform 0.3s;
        text-shadow: 0 1px 8px rgba(0,0,0,0.6);
        white-space: nowrap;
        background: none;
        border: none;
        font-family: inherit;
        cursor: pointer;
        padding: 0;
      }

      .header-nav a:hover,
      .header-nav button:hover {
        opacity: 1;
        color: var(--gold-light);
        transform: translateY(-1px);
      }

      .header-nav a.nav-campo-highlight {
        opacity: 1;
        color: var(--gold-bright);
        border: 1px solid rgba(212, 175, 55, 0.5);
        border-radius: 999px;
        padding: 6px 14px !important;
      }
      .header-nav a.nav-campo-highlight:hover {
        background: rgba(212, 175, 55, 0.12);
        border-color: var(--gold-bright);
      }
      .header-nav a.nav-event { background: rgba(201, 169, 97, 0.16); }
      .header-nav a.nav-external { color: var(--gold-light); }
      .mobile-menu-nav a.nav-campo-highlight {
        color: var(--gold-bright);
      }

      .lang-switcher {
        display: flex;
        gap: 12px;
        border-left: 1px solid rgba(212, 175, 55, 0.3);
        padding-left: 18px;
        margin-left: 8px;
      }

      .lang-switcher a {
        font-size: 0.75rem;
        text-decoration: none;
        color: var(--text-sub);
        opacity: 0.55;
        letter-spacing: 0.1em;
        transition: opacity 0.3s, color 0.3s;
      }

      .lang-switcher a.active {
        opacity: 1;
        font-weight: bold;
        color: var(--gold-bright);
      }

      .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 40px;
        height: 40px;
        background: none;
        border: 1px solid rgba(212, 175, 55, 0.3);
        cursor: pointer;
        padding: 8px;
        flex-shrink: 0;
        transition: border-color 0.3s;
        z-index: 1100;
        position: relative;
      }

      .hamburger:hover { border-color: var(--gold-bright); }

      .hamburger span {
        display: block;
        width: 22px;
        height: 1.5px;
        background: var(--gold-bright);
        transition: transform 0.35s ease, opacity 0.35s ease;
        transform-origin: center;
      }

      .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
      .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
      .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

      .mobile-menu {
        position: fixed;
        top: 0; right: 0;
        width: min(280px, 80vw);
        height: 100%;
        background: linear-gradient(
          160deg,
          rgba(22, 19, 16, 0.99) 0%,
          rgba(14, 12, 10, 0.99) 100%
        );
        border-left: 1px solid rgba(212, 175, 55, 0.2);
        z-index: 1050;
        flex-direction: column;
        padding: 80px 32px 40px;
        gap: 0;
        transform: translateX(100%);
        transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1);
        box-shadow: -8px 0 30px rgba(0,0,0,0.6);
        display: flex;
        pointer-events: none;
      }

      .mobile-menu.open {
        transform: translateX(0);
        pointer-events: auto;
      }

      .mobile-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1040;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease, visibility 0.4s ease;
        pointer-events: none;
      }

      .mobile-overlay.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .mobile-menu-nav {
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .mobile-menu-nav a,
      .mobile-menu-nav button {
        display: block;
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        border-bottom: 1px solid rgba(212, 175, 55, 0.12);
        color: var(--text-sub);
        font-family: inherit;
        font-size: 0.88rem;
        letter-spacing: 0.2em;
        padding: 18px 0;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.3s, padding-left 0.3s;
      }

      .mobile-menu-nav a:hover,
      .mobile-menu-nav button:hover {
        color: var(--gold-light);
        padding-left: 8px;
      }

      .mobile-menu-nav a:first-child,
      .mobile-menu-nav button:first-child {
        border-top: 1px solid rgba(212, 175, 55, 0.12);
      }

      .mobile-lang-switcher {
        display: flex;
        gap: 16px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid rgba(212, 175, 55, 0.2);
      }

      .mobile-lang-switcher a {
        font-size: 0.8rem;
        text-decoration: none;
        color: var(--text-sub);
        opacity: 0.55;
        letter-spacing: 0.12em;
        transition: opacity 0.3s, color 0.3s;
      }

      .mobile-lang-switcher a.active {
        opacity: 1;
        font-weight: bold;
        color: var(--gold-bright);
      }

      /* ホーム：入口写真の下に区画が続く縦スクロール画面 */
      .home {
        position: fixed;
        inset: 0;
        z-index: 990;
        overflow-y: auto;
        overflow-x: hidden;
        -webkit-overflow-scrolling: touch;
        background: var(--parchment);
        transition: opacity 1.2s ease, visibility 1.2s ease;
      }

      .home.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .entrance {
        position: relative;
        width: 100%;
        height: 100vh;
        height: 100svh;
        min-height: 520px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background-color: #ddd8cf;
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
      }

      /* 写真の下半分に影を敷いて、白文字を読めるようにする */
      .entrance::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(20, 14, 6, 0) 30%,
          rgba(12, 10, 8, 0.5) 55%,
          rgba(12, 10, 8, 0.88) 100%
        );
        pointer-events: none;
      }

      .hero-inner {
        position: absolute;
        bottom: 11%;
        left: 50%;
        transform: translateX(-50%);
        width: min(760px, 100%);
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        padding: 0 24px;
        z-index: 1;
      }

      .hero-eyebrow {
        font-size: clamp(0.6rem, 2.5vw, 0.75rem);
        letter-spacing: 0.35em;
        color: #f1dfae;
        text-transform: uppercase;
        margin-bottom: 14px;
        text-shadow: 0 1px 6px rgba(0,0,0,0.6);
      }

      .hero-title {
        font-family: var(--serif-jp);
        font-size: clamp(1.9rem, 6vw, 3.6rem);
        font-weight: 300;
        letter-spacing: 0.15em;
        line-height: 1.2;
        color: #ffffff;
        text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
        margin-bottom: 14px;
      }

      .hero-subtitle {
        font-size: clamp(0.88rem, 3.4vw, 1.12rem);
        letter-spacing: 0.12em;
        line-height: 1.8;
        color: #fbf6ea;
        margin-bottom: 26px;
        text-shadow: 0 1px 10px rgba(0,0,0,0.6);
        text-wrap: balance;
      }

      .hero-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 36px;
        width: min(260px, 70vw);
      }

      .hero-divider::before,
      .hero-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
      }

      .hero-divider-diamond {
        width: 6px;
        height: 6px;
        background: var(--gold-bright);
        transform: rotate(45deg);
        flex-shrink: 0;
      }

      .enter-btn {
        position: relative;
        padding: 14px 40px;
        background: rgba(12, 10, 8, 0.35);
        color: #f6ecd2;
        font-family: inherit;
        font-size: clamp(0.8rem, 2.5vw, 0.9rem);
        letter-spacing: 0.4em;
        text-transform: uppercase;
        white-space: nowrap;
        cursor: pointer;
        border: 1px solid rgba(230, 207, 150, 0.85);
        border-radius: 0;
        backdrop-filter: blur(2px);
        min-width: 220px;
        min-height: 52px;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        box-shadow: 0 6px 20px rgba(0,0,0,0.35);
        transition: background 0.3s ease, transform 0.3s ease;
      }

      .enter-btn:hover {
        background: rgba(201, 169, 97, 0.9);
        color: #141210;
        transform: translateY(-1px);
      }

      .concept-link {
        margin-top: 20px;
        background: none;
        border: none;
        cursor: pointer;
        font-family: inherit;
        color: #f1dfae;
        font-size: 0.66rem;
        letter-spacing: 0.3em;
        text-shadow: 0 1px 6px rgba(0,0,0,0.7);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        transition: opacity 0.3s;
      }
      .concept-link:hover { opacity: 0.85; }
      .concept-link span {
        font-family: var(--serif-jp);
        letter-spacing: 0.08em;
        font-size: 0.95rem;
        color: #ffffff;
        text-decoration: underline;
        text-decoration-color: rgba(241, 223, 174, 0.8);
        text-underline-offset: 4px;
      }

      .scroll-cue {
        position: absolute;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1;
        color: rgba(255,255,255,0.8);
        font-size: 0.6rem;
        letter-spacing: 0.35em;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        background: none;
        border: none;
        font-family: inherit;
        cursor: pointer;
      }
      .scroll-cue::after {
        content: '';
        width: 1px;
        height: 22px;
        background: rgba(255,255,255,0.7);
        animation: cue 2.2s ease-in-out infinite;
        transform-origin: top;
      }
      @keyframes cue { 0%,100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }
      @media (prefers-reduced-motion: reduce) { .scroll-cue::after { animation: none; } }

      /* ── ホームの各区画 ── */
      .home-sec {
        max-width: 1160px;
        margin: 0 auto;
        padding: 150px 32px;
        border-top: 1px solid rgba(201, 169, 97, 0.14);
      }
      .entrance + .home-sec { border-top: 0; }
      .sec-eyebrow:empty { display: none; }
      .sec-eyebrow {
        font-family: var(--serif-latin);
        font-size: 0.74rem;
        letter-spacing: 0.4em;
        color: var(--gold-bright);
        margin-bottom: 18px;
      }
      .sec-heading {
        font-family: var(--serif-jp);
        font-size: clamp(1.45rem, 3.6vw, 2.25rem);
        font-weight: 400;
        letter-spacing: 0.1em;
        line-height: 1.6;
        color: var(--text-main);
        margin-bottom: 32px;
        text-wrap: balance;
      }
      .sec-text {
        font-family: var(--serif-jp);
        font-size: 0.98rem;
        font-weight: 300;
        line-height: 2.2;
        letter-spacing: 0.04em;
        color: var(--text-sub);
        max-width: 34em;
      }
      .sec-text + .sec-text { margin-top: 18px; }
      .sec-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 24px;
        align-items: center;
        margin-top: 28px;
      }
      .sec-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 26px;
        background: transparent;
        color: var(--gold-light);
        text-decoration: none;
        font-size: 0.85rem;
        letter-spacing: 0.18em;
        border: 1px solid var(--gold-dim);
        font-family: var(--serif-jp);
        cursor: pointer;
        transition: background 0.3s, color 0.3s, border-color 0.3s;
      }
      .sec-cta:hover { background: var(--gold-bright); color: #141210; border-color: var(--gold-bright); }
      .sec-link {
        color: var(--gold-light);
        text-decoration: none;
        font-size: 0.88rem;
        letter-spacing: 0.08em;
        border-bottom: 1px solid var(--gold-dim);
        padding-bottom: 2px;
        background: none;
        border-top: 0; border-left: 0; border-right: 0;
        font-family: inherit;
        cursor: pointer;
      }
      .sec-link:hover { color: var(--text-main); }

      .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 56px;
        align-items: center;
      }
      .split > * { min-width: 0; }

      /* 額縁：木の外枠＋金の縁＋マット（余白紙）＋壁に落ちる影 */
      .home-frame {
        display: block;
        position: relative;
        padding: 14px;
        background: linear-gradient(135deg, #5a4128 0%, #3a2715 45%, #24170b 100%);
        box-shadow:
          0 0 0 1px #0a0806,
          inset 0 0 0 2px rgba(201, 169, 97, 0.55),
          0 30px 60px -12px rgba(0, 0, 0, 0.85),
          0 12px 24px -8px rgba(0, 0, 0, 0.6);
      }
      .home-frame img {
        display: block;
        width: 100%;
        height: auto;
        padding: var(--mat, clamp(10px, 2.4vw, 22px));
        background: #e9e2d2;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,0.2);
      }
      /* 作品を照らすスポットライト */
      .spot { position: relative; isolation: isolate; }
      .spot::before {
        content: '';
        position: absolute;
        inset: -18% -12% -6%;
        background: radial-gradient(ellipse at 50% 30%, rgba(255, 236, 196, 0.11) 0%, rgba(255, 236, 196, 0.04) 40%, transparent 70%);
        z-index: -1;
        pointer-events: none;
      }

      .today-figure {
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
      }
      .today-btn {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        max-width: min(520px, 100%);
        transition: transform 0.35s ease;
      }
      .today-btn:hover { transform: translateY(-4px); }
      .today-btn img { max-height: 62vh; width: auto; max-width: 100%; }
      .today-caption { text-align: center; }
      .today-caption b { display: block; font-family: var(--serif-jp); font-weight: 400; font-size: 1.05rem; letter-spacing: 0.1em; color: var(--text-main); }
      .today-caption span { font-size: 0.8rem; color: var(--text-muted); letter-spacing: 0.06em; }


      /* 展示室カード（ホームと部屋選び画面で共通） */
      .storage-links {
        max-width: 860px;
        margin: 40px auto 0;
        text-align: center;
      }
      .storage-links-lead {
        color: var(--text-sub, var(--text-main));
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        line-height: 1.8;
        margin-bottom: 18px;
      }
      .storage-links-btns {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
      }
      .storage-link-btn {
        display: inline-block;
        padding: 12px 26px;
        border: 1px solid var(--gold-dim);
        color: var(--gold-light);
        text-decoration: none;
        font-size: 0.85rem;
        letter-spacing: 0.15em;
        transition: background 0.3s, border-color 0.3s;
      }
      .storage-link-btn:hover {
        background: rgba(201, 169, 97, 0.12);
        border-color: var(--gold-bright);
      }
      .room-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        width: 100%;
        max-width: 860px;
        margin: 0 auto;
      }
      .room-card {
        display: flex;
        flex-direction: column;
        text-align: left;
        background: var(--crimson-mid);
        border: 1px solid rgba(201, 169, 97, 0.22);
        padding: 0;
        cursor: pointer;
        font-family: inherit;
        color: var(--text-main);
        transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }
      .room-card:hover {
        transform: translateY(-4px);
        border-color: var(--gold-bright);
        box-shadow: 0 24px 40px -18px rgba(0, 0, 0, 0.9);
      }
      .room-card img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
      }
      .room-card-body {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px;
      }
      .room-card-number {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.3em;
        color: var(--gold-bright);
        margin-bottom: 4px;
      }
      .room-card-name { font-family: var(--serif-jp); font-size: 1.05rem; letter-spacing: 0.12em; }
      .room-card-count { font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; letter-spacing: 0.06em; }

      .report-box {
        background: var(--crimson-mid);
        border: 1px solid rgba(201, 169, 97, 0.2);
        padding: 56px clamp(24px, 6vw, 72px);
      }

      .home-footer {
        background: #0c0b09;
        border-top: 1px solid rgba(201, 169, 97, 0.18);
        color: #b9b09f;
        padding: 48px 24px 40px;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
      }
      .home-footer-inner {
        max-width: 1040px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 28px;
      }
      .home-footer-logo { color: #d9b65c; letter-spacing: 0.25em; font-size: 0.9rem; margin-bottom: 8px; }
      .home-footer nav { display: flex; flex-wrap: wrap; gap: 10px 22px; }
      .home-footer a { color: #b9b09f; text-decoration: none; }
      .home-footer a:hover { color: #f1dfae; text-decoration: underline; }
      .home-footer .family { display: block; margin-top: 14px; color: #a99f8e; }

      /* ── 2つの柱（神戸／カンポ） ── */
      .sec-head-center { text-align: center; max-width: 760px; margin: 0 auto 110px; }
      .sec-head-center .sec-text { margin: 0 auto; }
      .sec-rule {
        width: 1px;
        height: 56px;
        margin: 0 auto 28px;
        background: linear-gradient(to bottom, transparent, var(--gold-dim));
      }
      .pillar + .pillar { margin-top: 170px; }
      .pillar-grid {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: clamp(48px, 7vw, 96px);
        align-items: center;
      }
      .pillar-grid > * { min-width: 0; }
      .pillar.reverse .pillar-art { order: 2; }
      .pillar-num {
        display: flex;
        align-items: baseline;
        gap: 18px;
        font-family: var(--serif-latin);
        color: var(--gold-bright);
        margin-bottom: 18px;
      }
      .pillar-num b { font-weight: 400; font-size: 3.2rem; line-height: 1; font-style: italic; }
      .pillar-num span { font-size: 0.74rem; letter-spacing: 0.4em; }
      .pillar-years {
        font-family: var(--serif-latin);
        font-style: italic;
        color: var(--text-muted);
        letter-spacing: 0.12em;
        margin: -18px 0 28px;
      }
      .pillar-feature { background: none; border: 0; padding: 0; cursor: pointer; width: 100%; text-align: left; }
      .pillar-feature .home-frame { transition: transform 0.5s ease; }
      .pillar-feature:hover .home-frame { transform: translateY(-4px); }
      .plate {
        margin-top: 22px;
        font-family: var(--serif-jp);
        font-size: 0.8rem;
        color: var(--text-muted);
        letter-spacing: 0.08em;
        text-align: center;
      }
      .plate b { color: var(--text-sub); font-weight: 400; margin-right: 10px; }
      .pillar-thumbs {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 44px;
      }
      .pillar-thumbs button { background: none; border: 0; padding: 0; cursor: pointer; }
      .pillar-thumbs .home-frame { padding: 7px; --mat: 7px; transition: transform 0.4s ease; }
      .pillar-thumbs .home-frame img { aspect-ratio: 1; object-fit: cover; }
      .pillar-thumbs button:hover .home-frame { transform: translateY(-3px); }

      /* ── レガシープロジェクト ── */
      .legacy {
        position: relative;
        background:
          radial-gradient(ellipse at 15% 0%, rgba(201, 169, 97, 0.10) 0%, transparent 55%),
          linear-gradient(180deg, #1d1915 0%, #14120f 100%);
        border: 1px solid rgba(201, 169, 97, 0.28);
        padding: clamp(48px, 8vw, 104px) clamp(24px, 7vw, 96px);
        outline: 1px solid rgba(201, 169, 97, 0.12);
        outline-offset: 10px;
      }
      .legacy-news {
        margin: 40px 0 0;
        padding: 26px 30px;
        border-left: 2px solid var(--gold-bright);
        background: rgba(201, 169, 97, 0.06);
        max-width: 40em;
      }
      .legacy-news b {
        display: block;
        font-family: var(--serif-jp);
        font-weight: 500;
        font-size: 0.78rem;
        letter-spacing: 0.2em;
        color: var(--gold-bright);
        margin-bottom: 8px;
      }
      .legacy-news p { font-family: var(--serif-jp); font-weight: 300; line-height: 2; color: var(--text-main); }
      .legacy-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-top: 56px;
        padding-top: 36px;
        border-top: 1px solid rgba(201, 169, 97, 0.2);
      }
      .legacy-stats b {
        display: block;
        font-family: var(--serif-latin);
        font-weight: 400;
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1.1;
        color: var(--gold-light);
      }
      .legacy-stats span { font-family: var(--serif-jp); font-size: 0.78rem; color: var(--text-muted); letter-spacing: 0.08em; }

      /* ── Limited Edition（支援コミュニティ） ── */
      .vip-cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        margin-bottom: 72px;
      }
      .vip-cards > * { min-width: 0; }
      .vip-card {
        position: relative;
        padding: 52px clamp(26px, 4vw, 48px) 44px;
        background: linear-gradient(160deg, #201c17 0%, #161411 100%);
        border: 1px solid rgba(201, 169, 97, 0.3);
      }
      .vip-card::after {
        content: '';
        position: absolute;
        inset: 8px;
        border: 1px solid rgba(201, 169, 97, 0.1);
        pointer-events: none;
      }
      .vip-mark {
        display: flex;
        align-items: baseline;
        gap: 14px;
        font-family: var(--serif-latin);
        color: var(--gold-bright);
        margin-bottom: 22px;
      }
      .vip-mark b { font-weight: 400; font-size: 3.4rem; line-height: 1; }
      .vip-mark span { font-size: 0.72rem; letter-spacing: 0.4em; }
      .vip-card h3 {
        font-family: var(--serif-jp);
        font-weight: 500;
        font-size: 1.2rem;
        letter-spacing: 0.08em;
        line-height: 1.6;
        color: var(--text-main);
        margin-bottom: 16px;
      }
      .vip-card p { font-family: var(--serif-jp); font-weight: 300; font-size: 0.92rem; line-height: 2.1; color: var(--text-sub); }
      .vip-card small { display: block; margin-top: 18px; font-size: 0.76rem; color: var(--text-muted); font-family: var(--serif-jp); }

      .vip-form {
        max-width: 720px;
        margin: 0 auto;
        padding: clamp(36px, 6vw, 64px) clamp(22px, 6vw, 64px);
        border: 1px solid rgba(201, 169, 97, 0.4);
        background: rgba(12, 10, 8, 0.55);
      }
      .vip-form h3 {
        font-family: var(--serif-jp);
        font-weight: 400;
        font-size: 1.15rem;
        letter-spacing: 0.15em;
        text-align: center;
        color: var(--gold-light);
        margin-bottom: 36px;
      }
      .vip-field { display: block; margin-bottom: 26px; }
      .vip-field > span, .vip-field legend {
        display: block;
        font-family: var(--serif-jp);
        font-size: 0.78rem;
        letter-spacing: 0.15em;
        color: var(--text-muted);
        margin-bottom: 10px;
      }
      fieldset.vip-field { border: 0; padding: 0; min-width: 0; }
      .vip-field input[type="text"],
      .vip-field input[type="email"],
      .vip-field textarea {
        width: 100%;
        background: transparent;
        border: 0;
        border-bottom: 1px solid rgba(201, 169, 97, 0.35);
        color: var(--text-main);
        font-family: var(--serif-jp);
        font-size: 1rem;
        padding: 10px 2px;
        transition: border-color 0.3s;
        border-radius: 0;
      }
      .vip-field textarea { resize: vertical; min-height: 96px; border: 1px solid rgba(201, 169, 97, 0.25); padding: 12px; }
      .vip-field input:focus, .vip-field textarea:focus { outline: none; border-color: var(--gold-light); }
      .vip-check {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--serif-jp);
        font-size: 0.95rem;
        color: var(--text-sub);
        padding: 8px 0;
        cursor: pointer;
      }
      .vip-check input { appearance: none; width: 18px; height: 18px; border: 1px solid var(--gold-dim); flex: none; display: grid; place-items: center; cursor: pointer; }
      .vip-check input[type="radio"] { border-radius: 50%; }
      .vip-check input:checked { background: var(--gold-bright); border-color: var(--gold-bright); }
      .vip-check input:checked::after { content: '✓'; color: #141210; font-size: 0.75rem; line-height: 1; }
      .vip-check input:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 2px; }
      .vip-submit {
        display: block;
        width: 100%;
        margin-top: 12px;
        padding: 20px 24px;
        background: linear-gradient(135deg, #d8bb76 0%, #b8954d 50%, #d2b26a 100%);
        color: #141210;
        border: 0;
        font-family: var(--serif-jp);
        font-weight: 500;
        font-size: 0.98rem;
        letter-spacing: 0.3em;
        cursor: pointer;
        box-shadow: 0 14px 30px -12px rgba(201, 169, 97, 0.45);
        transition: filter 0.3s, transform 0.3s;
      }
      .vip-submit:hover { filter: brightness(1.08); transform: translateY(-1px); }
      .vip-note { margin-top: 16px; font-family: var(--serif-jp); font-size: 0.76rem; line-height: 1.9; color: var(--text-muted); text-align: center; }
      .vip-error { color: #e8a48a; font-family: var(--serif-jp); font-size: 0.82rem; text-align: center; margin-top: 12px; min-height: 1em; }

      /* ── 入口の展示会お知らせ ── */
      .event-badge {
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 4px 12px;
        margin-bottom: 22px;
        padding: 8px 18px;
        background: rgba(12, 10, 8, 0.55);
        border: 1px solid rgba(230, 207, 150, 0.7);
        color: #f6ecd2;
        text-decoration: none;
        font-family: var(--serif-jp);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        backdrop-filter: blur(2px);
        transition: background 0.3s, color 0.3s;
      }
      .event-badge b { font-weight: 500; color: var(--gold-light); letter-spacing: 0.15em; }
      .event-badge:hover { background: rgba(201, 169, 97, 0.9); color: #141210; }
      .event-badge:hover b { color: #141210; }
      .event-badge[hidden] { display: none; }

      /* ── コンセプト・ストーリー ── */
      .story { max-width: 820px; margin: 0 auto; text-align: center; }
      .story .sec-text { margin: 0 auto; text-align: left; }
      .story .sec-text + .sec-text { margin-top: 18px; }
      .story-heading {
        font-family: var(--serif-jp);
        font-size: clamp(1.6rem, 4.4vw, 2.7rem);
        font-weight: 300;
        letter-spacing: 0.08em;
        line-height: 1.6;
        color: var(--text-main);
        text-wrap: balance;
        margin-bottom: 28px;
      }
      .story-lead {
        font-family: var(--serif-jp);
        font-size: clamp(1rem, 2.4vw, 1.25rem);
        letter-spacing: 0.08em;
        line-height: 1.9;
        color: var(--gold-light);
        margin-bottom: 44px;
        text-wrap: balance;
      }
      .story-sign {
        margin: 32px auto 0;
        max-width: 34em;
        text-align: right;
        font-family: var(--serif-jp);
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        color: var(--text-muted);
      }
      .story-sign::before { content: '— '; }
      .story-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-top: 64px;
        padding-top: 40px;
        border-top: 1px solid rgba(201, 169, 97, 0.2);
      }
      .story-stats b {
        display: block;
        font-family: var(--serif-latin);
        font-weight: 400;
        font-size: clamp(2.2rem, 6vw, 3.4rem);
        line-height: 1.1;
        color: var(--gold-light);
      }
      .story-stats small { font-family: var(--serif-jp); font-size: 0.9rem; margin-left: 4px; color: var(--gold-bright); }
      .story-stats span { font-family: var(--serif-jp); font-size: 0.8rem; color: var(--text-muted); letter-spacing: 0.08em; }

      /* ── ローンチング展示会 ── */
      .exhibit {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: clamp(36px, 6vw, 72px);
        align-items: stretch;
        background: var(--crimson-mid);
        border: 1px solid rgba(201, 169, 97, 0.3);
        padding: clamp(32px, 6vw, 72px);
      }
      .exhibit > * { min-width: 0; }
      .exhibit .sec-heading { font-size: clamp(1.4rem, 2.6vw, 1.85rem); }
      .exhibit-rows { margin-top: 36px; border-top: 1px solid rgba(201, 169, 97, 0.2); }
      .exhibit-rows > div {
        display: grid;
        grid-template-columns: 5.5em 1fr;
        gap: 16px;
        padding: 18px 0;
        border-bottom: 1px solid rgba(201, 169, 97, 0.2);
      }
      .exhibit-rows dt { font-family: var(--serif-jp); font-size: 0.78rem; letter-spacing: 0.2em; color: var(--gold-bright); padding-top: 3px; }
      .exhibit-rows dd b { display: block; font-family: var(--serif-jp); font-weight: 400; font-size: 1.02rem; line-height: 1.7; color: var(--text-main); }
      .exhibit-rows dd span { display: block; font-family: var(--serif-jp); font-weight: 300; font-size: 0.88rem; line-height: 1.8; color: var(--text-sub); }
      .exhibit-ended { margin-top: 20px; font-family: var(--serif-jp); color: var(--gold-light); }
      .exhibit-map { min-height: 320px; border: 1px solid rgba(201, 169, 97, 0.25); }
      .exhibit-map iframe {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 320px;
        border: 0;
        filter: grayscale(0.6) sepia(0.15) brightness(0.9);
      }

      /* ── 二つの故郷：スペイン特設サイトへのバナー ── */
      .lp-sec { padding-top: 0; border-top: 0; }
      .lp-banner {
        position: relative;
        display: flex;
        align-items: center;
        min-height: 380px;
        padding: clamp(36px, 6vw, 72px);
        text-decoration: none;
        color: var(--text-main);
        border: 1px solid rgba(201, 169, 97, 0.35);
        background:
          linear-gradient(90deg, rgba(12, 10, 8, 0.94) 0%, rgba(12, 10, 8, 0.78) 50%, rgba(12, 10, 8, 0.25) 100%),
          var(--lp-bg, none) center / cover no-repeat,
          var(--crimson-mid);
        overflow: hidden;
      }
      .lp-banner-text { display: flex; flex-direction: column; align-items: flex-start; max-width: 32em; }
      .lp-banner-heading {
        font-family: var(--serif-jp);
        font-size: clamp(1.4rem, 3.4vw, 2.1rem);
        font-weight: 400;
        letter-spacing: 0.1em;
        line-height: 1.6;
        margin-bottom: 18px;
      }
      .lp-banner-body { font-family: var(--serif-jp); font-weight: 300; font-size: 0.95rem; line-height: 2.1; color: var(--text-sub); margin-bottom: 30px; }
      .lp-banner:hover .lp-banner-cta { background: var(--gold-bright); color: #141210; border-color: var(--gold-bright); }

      .fb-external { display: inline-block; width: auto; padding: 20px 40px; text-decoration: none; }

      /* ── 2027年 ラ・マンチャの旅（構想）：左に案内、右に事前登録 ── */
      .tour {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(36px, 6vw, 72px);
        align-items: start;
      }
      .tour > * { min-width: 0; }
      .tour .vip-form { max-width: none; margin: 0; }
      .tour .vip-form h3 { text-align: left; margin-bottom: 28px; }
      .tour-legal {
        margin-top: 28px;
        padding: 16px 20px;
        border-left: 2px solid var(--gold-dim);
        background: rgba(201, 169, 97, 0.05);
        font-family: var(--serif-jp);
        font-size: 0.8rem;
        line-height: 1.9;
        color: var(--text-muted);
        max-width: 40em;
      }
      .tour-people { display: flex; gap: 8px 18px; flex-wrap: wrap; }
      .vip-field input[type="number"] {
        width: 6em;
        background: transparent;
        border: 0;
        border-bottom: 1px solid rgba(201, 169, 97, 0.35);
        color: var(--text-main);
        font-family: var(--serif-jp);
        font-size: 1rem;
        padding: 10px 2px;
        border-radius: 0;
      }
      .vip-field input[type="number"]:focus { outline: none; border-color: var(--gold-light); }
      .tour-cta-wrap { text-align: left; }

      /* モーダルから作品ページへ */
      .modal-page-link {
        display: inline-block;
        margin-top: 22px;
        color: var(--gold-light);
        font-family: var(--serif-jp);
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-decoration: none;
        border-bottom: 1px solid var(--gold-dim);
        padding-bottom: 2px;
      }
      .modal-page-link:hover { color: #fff; }

      @media (max-width: 860px) {
        .tour { grid-template-columns: 1fr; }
        .exhibit { grid-template-columns: 1fr; }
        .lp-banner { background:
          linear-gradient(180deg, rgba(12, 10, 8, 0.55) 0%, rgba(12, 10, 8, 0.92) 55%),
          var(--lp-bg, none) center / cover no-repeat,
          var(--crimson-mid); align-items: flex-end; min-height: 460px; }
      }
      @media (max-width: 480px) {
        .story-stats { grid-template-columns: 1fr; gap: 22px; }
        .exhibit-rows > div { grid-template-columns: 1fr; gap: 4px; }
      }

      @media (max-width: 860px) {
        .pillar-grid { grid-template-columns: 1fr; gap: 48px; }
        .pillar.reverse .pillar-art { order: 0; }
        .vip-cards { grid-template-columns: 1fr; }
        .sec-head-center { margin-bottom: 72px; }
        .pillar + .pillar { margin-top: 120px; }
      }
      @media (max-width: 480px) {
        .legacy-stats { grid-template-columns: 1fr; gap: 18px; }
        .pillar-thumbs { gap: 12px; }
      }

      @media (max-width: 768px) {
        .home-sec { padding: 96px 20px; }
        .split { grid-template-columns: 1fr; gap: 36px; }
      }

      .campo-concept {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        z-index: 991;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow-y: auto;
        padding: 90px 24px 60px;
        background: var(--parchment);
        transition: opacity 1.2s ease, visibility 1.2s ease;
      }
      .campo-concept.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .campo-concept-inner {
        max-width: 720px;
        margin: 0 auto;
        text-align: center;
      }

      .campo-concept-eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.35em;
        color: var(--gold-bright);
        margin-bottom: 18px;
      }

      .campo-concept-title {
        font-family: var(--serif-jp);
        font-weight: 400;
        font-size: clamp(1.4rem, 3.5vw, 2rem);
        letter-spacing: 0.06em;
        color: var(--text-main);
        margin-bottom: 28px;
      }

      .campo-concept-text {
        font-family: var(--serif-jp);
        font-weight: 300;
        font-size: 0.98rem;
        line-height: 2.2;
        color: var(--text-sub);
        margin-bottom: 20px;
        text-align: left;
      }
      .campo-concept-text:last-of-type { margin-bottom: 36px; }

      .campo-concept-cta {
        display: inline-block;
        color: var(--gold-bright);
        text-decoration: none;
        font-size: 0.88rem;
        letter-spacing: 0.12em;
        border-bottom: 1px solid var(--gold-dim);
        padding-bottom: 4px;
        transition: color 0.3s, border-color 0.3s;
      }
      .campo-concept-cta:hover {
        color: var(--gold-light);
        border-color: var(--gold-light);
      }

      @media (max-width: 640px) {
        .campo-concept { padding: 60px 20px; }
        .campo-concept-text { font-size: 0.92rem; line-height: 1.9; }
      }

      .room-selector {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 992;
        transition: opacity 1.2s ease, visibility 1.2s ease;
        overflow-y: auto;
        padding: 80px 20px 40px;
        background:
          radial-gradient(ellipse at 50% 0%, rgba(201, 169, 97, 0.08) 0%, transparent 60%),
          linear-gradient(180deg, #171512 0%, #100e0c 100%),
          repeating-linear-gradient(
            0deg,
            rgba(201, 169, 97, 0.025) 0px,
            rgba(201, 169, 97, 0.025) 1px,
            transparent 1px,
            transparent 60px
          );
      }

      .room-selector.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .room-selector-title {
        font-size: clamp(0.6rem, 2.5vw, 0.78rem);
        letter-spacing: 0.5em;
        color: var(--gold-dim);
        text-transform: uppercase;
        margin-bottom: 12px;
        text-align: center;
      }

      .room-selector-heading {
        font-size: clamp(1.2rem, 4vw, 2rem);
        font-weight: 400;
        letter-spacing: 0.2em;
        color: var(--text-main);
        margin-bottom: 40px;
        text-align: center;
      }

      .room-list {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: center;
        max-width: 860px;
        width: 100%;
        padding: 0;
      }

      .room-btn {
        position: relative;
        padding: 18px 28px;
        background: rgba(37, 33, 27, 0.6);
        color: var(--text-sub);
        font-family: inherit;
        font-size: clamp(0.78rem, 2.5vw, 0.82rem);
        letter-spacing: 0.18em;
        min-width: min(210px, 42vw);
        cursor: pointer;
        border: none;
        text-align: left;
        transition: color 0.35s ease, background 0.35s ease;
        overflow: hidden;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        min-height: 44px;
      }

      .room-btn::before {
        content: '';
        position: absolute;
        left: 0; top: 0;
        width: 3px;
        height: 100%;
        background: var(--gold-dim);
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 0.35s cubic-bezier(0.76, 0, 0.24, 1);
      }

      .room-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        border: 1px solid rgba(212, 175, 55, 0.25);
        transition: border-color 0.35s ease;
      }

      .room-btn:hover {
        background: rgba(48, 42, 33, 0.8);
        color: var(--gold-light);
      }

      .room-btn:hover::before { transform: scaleY(1); }
      .room-btn:hover::after  { border-color: rgba(212, 175, 55, 0.55); }

      .room-btn-number {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.3em;
        color: var(--gold-dim);
        margin-bottom: 6px;
        transition: color 0.35s;
      }

      .room-btn:hover .room-btn-number { color: var(--gold-bright); }

      .back-btn {
        margin-top: 40px;
        background: none;
        border: none;
        color: var(--text-muted);
        font-family: inherit;
        font-size: 0.75rem;
        letter-spacing: 0.35em;
        cursor: pointer;
        text-transform: uppercase;
        transition: color 0.3s;
        position: relative;
        padding: 6px 0;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        min-height: 44px;
      }

      .back-btn::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0;
        width: 100%;
        height: 1px;
        background: var(--gold-dim);
        transform: scaleX(0);
        transition: transform 0.3s ease;
      }

      .back-btn:hover { color: var(--text-sub); }
      .back-btn:hover::after { transform: scaleX(1); }

      .museum {
        opacity: 0;
        visibility: hidden;
        transition: opacity 1.2s ease, visibility 1.2s ease;
        min-height: 100vh;
        background:
          radial-gradient(ellipse at 50% 35%, rgba(255, 236, 196, 0.07) 0%, transparent 60%),
          linear-gradient(to bottom, #12100e 0%, #1b1814 45%, #15130f 100%);
      }

      .museum.visible {
        opacity: 1;
        visibility: visible;
      }

      .museum-header {
        text-align: center;
        padding-top: 90px;
        padding-bottom: 4px;
        position: relative;
        padding-left: 20px;
        padding-right: 20px;
      }

      .museum-header::after {
        content: '';
        display: block;
        width: 80px;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
        margin: 8px auto 0;
      }

      .museum-header-row {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .museum-title {
        font-family: var(--serif-jp);
        font-size: clamp(1rem, 4vw, 1.8rem);
        font-weight: 400;
        letter-spacing: 0.3em;
        color: var(--text-main);
      }

      .museum-count {
        color: var(--text-muted);
        font-size: 0.72rem;
        letter-spacing: 0.25em;
      }

      .scroll-hint {
        text-align: center;
        color: var(--text-muted);
        font-size: 0.65rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-top: 6px;
      }

      .gallery-wrap {
        position: relative;
        display: flex;
        align-items: center;
        margin-top: 2px;
      }

      .gallery-track {
        display: flex;
        gap: 60px;
        padding: 30px 80px 120px;
        overflow-x: auto;
        scroll-behavior: smooth;
        align-items: center;
        scrollbar-width: thin;
        scrollbar-color: var(--crimson-mid) var(--crimson-deep);
        -webkit-overflow-scrolling: touch;
        width: 100%;
      }

      .gallery-track::-webkit-scrollbar { height: 4px; }
      .gallery-track::-webkit-scrollbar-track { background: var(--crimson-deep); }
      .gallery-track::-webkit-scrollbar-thumb { background: var(--crimson-mid); border-radius: 2px; }

      .scroll-arrow {
        position: absolute;
        z-index: 10;
        background: rgba(28, 25, 21, 0.85);
        border: 1px solid rgba(201, 169, 97, 0.3);
        color: var(--gold-bright);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 1.3rem;
        transition: background 0.3s, border-color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
        flex-shrink: 0;
      }

      .scroll-arrow:hover {
        background: rgba(48, 42, 33, 0.95);
        border-color: var(--gold-bright);
      }

      .scroll-arrow.left  { left: 6px; }
      .scroll-arrow.right { right: 6px; }

      .artwork-card {
        flex: 0 0 auto;
        cursor: pointer;
        position: relative;
        transition: transform 0.35s ease;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }

      .artwork-card:hover { transform: translateY(-6px); }

      /* 額縁：濃い茶色で統一、角は直角。光は左上から当たる想定で、
         上・左を明るく、右・下を暗くして立体感を出す */
      .wood-frame {
        position: relative;
        border-style: solid;
        border-width: var(--frame-w, 16px);
        border-radius: 0;
        border-color: #5f3f25 #2f1d10 #24160b #4b301c;
        background: #1a1008;
        box-shadow:
          -1px -1px 0 rgba(255, 214, 170, 0.12),
          0 0 0 1px #140b05,
          0 28px 50px -10px rgba(0,0,0,0.9);
      }
      /* 額の内側の縁が絵に落とす影（左上から光） */
      .wood-frame::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        box-shadow:
          inset 0 0 0 1px rgba(0,0,0,0.55),
          inset 3px 3px 6px rgba(0,0,0,0.5);
      }

      .artwork-frame img {
        width: 100%;
        display: block;
      }

      .artwork-label {
        text-align: center;
        margin-top: 18px;
        padding: 0 4px;
      }

      .artwork-label-title {
        font-family: var(--serif-jp);
        font-size: 0.8rem;
        color: var(--text-sub);
        letter-spacing: 0.08em;
      }

      .artwork-label-artist {
        font-size: 0.68rem;
        color: var(--text-muted);
        margin-top: 5px;
        letter-spacing: 0.06em;
      }

      .modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(10, 2, 2, 0.93);
        z-index: 2000;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(4px);
        padding: 16px;
      }

      .modal-overlay.active { display: flex; }

      .modal {
        background: linear-gradient(160deg, #1f1b17 0%, #15130f 100%);
        border: 1px solid rgba(201, 169, 97, 0.22);
        padding: 32px 24px;
        max-width: 740px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        box-shadow:
          0 30px 80px rgba(0,0,0,0.8),
          inset 0 1px 0 rgba(212, 175, 55, 0.1);
        -webkit-overflow-scrolling: touch;
      }

      .modal-close {
        position: absolute;
        top: 12px; right: 14px;
        background: none;
        border: 1px solid rgba(212, 175, 55, 0.25);
        color: var(--text-sub);
        font-size: 1rem;
        width: 34px;
        height: 34px;
        cursor: pointer;
        transition: border-color 0.3s, color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
      }

      .modal-close:hover {
        border-color: var(--gold-bright);
        color: var(--gold-bright);
      }

      .modal-title {
        font-family: var(--serif-jp);
        font-size: clamp(1rem, 3.5vw, 1.2rem);
        font-weight: 400;
        letter-spacing: 0.1em;
        color: var(--text-main);
        margin-bottom: 10px;
        padding-right: 40px;
      }

      .modal-meta {
        font-size: clamp(0.72rem, 2.5vw, 0.82rem);
        color: var(--text-muted);
        margin-bottom: 22px;
        letter-spacing: 0.05em;
        line-height: 1.8;
      }

      .modal-description {
        font-size: clamp(0.8rem, 2.5vw, 0.85rem);
        line-height: 1.75;
        color: var(--text-sub);
        background: rgba(255,255,255,0.03);
        border-left: 2px solid var(--gold-dim);
        padding: 14px 16px;
      }

      /* メニューが収まらない幅ではハンバーガーに切り替える */
      @media (max-width: 1180px) {
        .header-nav  { display: none; }
        .hamburger   { display: flex; }
      }

      @media (max-width: 768px) {
        .site-header { padding: 12px 18px; }
        .header-logo { font-size: 0.82rem; letter-spacing: 0.15em; }
        .header-nav  { display: none; }
        .hamburger   { display: flex; }

        .gallery-track { gap: 36px; padding: 40px 56px 80px; }
        .scroll-arrow { width: 32px; height: 32px; font-size: 1.1rem; }
        .scroll-arrow.left  { left: 4px; }
        .scroll-arrow.right { right: 4px; }

        .modal { padding: 28px 18px; max-height: 88vh; }
        .modal-meta { display: flex; flex-direction: column; gap: 2px; }
        .modal-meta .sep { display: none; }

        .room-btn { min-width: calc(50vw - 28px); padding: 16px 18px; }
        .museum-header { padding-top: 80px; }
      }

      @media (max-width: 480px) {
        .gallery-track { gap: 28px; padding: 36px 48px 70px; }
        .room-list { gap: 10px; }
        .room-btn { min-width: calc(100vw - 56px); }
      }
    </style>
  </head>
  <body>

    <!-- ヘッダー -->
    <header class="site-header">
      <a href={`${base}/${lang}/`} class="header-logo" id="navLogo">{t.headerTitle}</a>

      <!-- PC用ナビ -->
      <nav class="header-nav">
        <a href={`${base}/${lang}/#rooms`} id="navExhibition">{h.navRooms}</a>
        <a href={`${base}/${lang}/about/campo-collection/`} class="nav-campo-highlight">{h.navCampo}</a>
        <AboutNavDropdown lang={lang} base={base} mode="desktop" label={h.navArtist} />
        <a href={`${base}/${lang}/#limited`} id="navLimited">{lg.navLimited}</a>
        <a href={`${base}/${lang}/#exhibition`} id="navExhibitionInfo" class="nav-campo-highlight nav-event">{ln.navExhibition}</a>
        <a href={lpUrl} target="_blank" rel="noopener" class="nav-external">{ln.navLp}<span aria-hidden="true"> ↗</span></a>
        <div class="lang-switcher">
          <a href={`${base}/ja/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
          <a href={`${base}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
          <a href={`${base}/sp/`} class={lang === 'sp' ? 'active' : ''}>ES</a>
        </div>
      </nav>

      <!-- ハンバーガーボタン -->
      <button class="hamburger" id="hamburgerBtn" aria-label="メニューを開く">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <!-- モバイルオーバーレイ -->
    <div class="mobile-overlay" id="mobileOverlay"></div>

    <!-- モバイルメニュー -->
    <div class="mobile-menu" id="mobileMenu">
      <nav class="mobile-menu-nav">
        <a href={`${base}/${lang}/`} id="mNavTop">{t.backTop}</a>
        <a href={`${base}/${lang}/#rooms`} id="mNavExhibition">{h.navRooms}</a>
        <a href={`${base}/${lang}/about/campo-collection/`} class="nav-campo-highlight">{h.navCampo}</a>
        <AboutNavDropdown lang={lang} base={base} mode="mobile" label={h.navArtist} />
        <a href={`${base}/${lang}/#exhibition`} id="mNavExhibitionInfo" class="nav-campo-highlight">{ln.navExhibition}</a>
        <a href={`${base}/${lang}/#limited`} id="mNavLimited">{lg.navLimited}</a>
        <a href={`${base}/${lang}/#journey`} id="mNavJourney">{ln.navTour}</a>
        <a href={`${base}/${lang}/#feedback`} id="mNavFeedback">{ln.navFeedback}</a>
        <a href={lpUrl} target="_blank" rel="noopener">{ln.navLp} ↗</a>
      </nav>
      <div class="mobile-lang-switcher">
        <a href={`${base}/ja/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
        <a href={`${base}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
        <a href={`${base}/sp/`} class={lang === 'sp' ? 'active' : ''}>ES</a>
      </div>
    </div>

    <!-- ホーム：入口写真＋区画 -->
    <div class="home" id="home">
      <section class="entrance" id="entrance">
        <script is:inline define:vars={{ heroBase: `${base}/hero/`, heroCount: 8 }}>
          // 所蔵作品を壁に掛けた入口写真を、訪問ごとにランダムで選ぶ
          const n = 1 + Math.floor(Math.random() * heroCount);
          document.getElementById('entrance').style.backgroundImage = `url('${heroBase}hero-${n}.jpg')`;
        </script>
        <div class="hero-inner">
          <a class="event-badge" href="#exhibition" id="eventBadge"><b>{ln.exBadge}</b><span>{ln.exBadgeWhen}</span></a>
          <p class="hero-eyebrow">{t.headerTitle}</p>
          <h1 class="hero-title">{lang === 'ja' ? (<>徳永アート<br />ミュージアム</>) : t.title}</h1>
          <p class="hero-subtitle">{h.tagline}</p>
          <button class="enter-btn" id="enterBtn">{t.enter}</button>
          <button class="concept-link" id="conceptLink">{concept.eyebrow}<span>{concept.title}</span></button>
        </div>
        <button class="scroll-cue" id="scrollCue" type="button">{h.scrollCue}</button>
      </section>

      <!-- コンセプト・ストーリー -->
      <section class="home-sec" id="story">
        <div class="story">
          <div class="sec-rule"></div>
          <p class="sec-eyebrow">{ln.storyEyebrow}</p>
          <h2 class="story-heading">{ln.storyHeading.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
          <p class="story-lead">{ln.storyLead}</p>
          {ln.storyBody.map((p) => <p class="sec-text">{p}</p>)}
          <p class="story-sign">{ln.storySign}</p>
          {ln.storyStats.length > 0 && <div class="story-stats">
            {ln.storyStats.map((s) => <div><b>{s.num}<small>{s.unit}</small></b><span>{s.label}</span></div>)}
          </div>}
        </div>
      </section>

      <!-- ローンチング展示会のご案内 -->
      <section class="home-sec" id="exhibition" data-end={EXHIBITION.end}>
        <div class="exhibit">
          <div class="exhibit-info">
            <p class="sec-eyebrow">{ln.exEyebrow}</p>
            <h2 class="sec-heading">{ln.exHeading}</h2>
            <p class="sec-text">{ln.exLead}</p>
            <p class="exhibit-ended" id="exhibitEnded" hidden>{ln.exEnded}</p>
            <dl class="exhibit-rows">
              {ln.exRows.map((r) => (
                <div><dt>{r.label}</dt><dd><b>{r.value}</b><span>{r.sub}</span></dd></div>
              ))}
            </dl>
            <div class="sec-links">
              <a class="sec-cta" href={mapLink} target="_blank" rel="noopener">{ln.exMap} ↗</a>
              <a class="sec-link" href={calLink} target="_blank" rel="noopener" id="exhibitCal">{ln.exCalendar}</a>
            </div>
          </div>
          <div class="exhibit-map">
            <iframe src={mapSrc} title={ln.exMapTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </section>

      <!-- 画家を形づくった二つの地（神戸／カンポ） -->
      <section class="home-sec" id="pillars">
        <div class="sec-head-center">
          <div class="sec-rule"></div>
          <p class="sec-eyebrow">{lg.pillarsEyebrow}</p>
          <h2 class="sec-heading">{lg.pillarsHeading}</h2>
          <p class="sec-text">{lg.pillarsLead}</p>
        </div>

        {pillars.map((p, i) => (
          <article class={`pillar ${i % 2 ? 'reverse' : ''}`} id={`pillar-${p.key}`}>
            <div class="pillar-grid">
              <div class="pillar-art">
                {p.feature && (
                  <figure style="margin:0" class="spot">
                    <button class="pillar-feature" type="button" data-open-file={p.feature.file}>
                      <span class="home-frame"><img src={`${base}/gallery/${p.feature.file}`} alt={p.feature.title} loading="lazy" /></span>
                    </button>
                    <figcaption class="plate"><b>{p.feature.title}</b>{p.feature.year !== '—' ? p.feature.year : ''}{p.feature.size !== '—' ? ` ・ ${p.feature.size}` : ''}</figcaption>
                  </figure>
                )}
              </div>
              <div>
                {p.num && <p class="pillar-num"><b>{p.num}</b><span>{p.eyebrow}</span></p>}
                <h3 class="sec-heading">{p.heading}</h3>
                <p class="pillar-years">{p.years}</p>
                {p.body.map((para) => <p class="sec-text">{para}</p>)}
                <div class="pillar-thumbs">
                  {p.others.map((w) => (
                    <button type="button" data-open-file={w.file} aria-label={w.title} title={w.title}>
                      <span class="home-frame"><img src={`${base}/gallery/${w.file}`} alt={w.title} loading="lazy" /></span>
                    </button>
                  ))}
                </div>
                <div class="sec-links">
                  {p.key === 'kobe' ? (
                    <button class="sec-cta" type="button" id="kobeOpen" data-files={[p.feature?.file, ...p.others.map((w) => w.file)].join(',')} data-title={p.heading}>{p.cta} →</button>
                  ) : (
                    <>
                      <a class="sec-cta" href={`${base}/${lang}/about/campo-collection/`}>{p.cta} →</a>
                      <a class="sec-link" href={`${base}/${lang}/about/philosophy/`}>{p.sub}</a>
                      <button class="sec-link" id="storyConcept" type="button">{h.storyConcept}</button>
                      <a class="sec-link" href={lpUrl} target="_blank" rel="noopener">{ln.lpShort} ↗</a>
                    </>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </section>

      <!-- 二つの故郷：スペイン特設サイトへ -->
      <section class="home-sec lp-sec">
        <a class="lp-banner" href={lpUrl} target="_blank" rel="noopener" style={lpBanner ? `--lp-bg: url('${base}/gallery/${lpBanner.file}')` : ''}>
          <span class="lp-banner-text">
            <span class="sec-eyebrow">{ln.lpEyebrow}</span>
            <span class="lp-banner-heading">{ln.lpHeading.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</span>
            <span class="lp-banner-body">{ln.lpBody}</span>
            <span class="sec-cta lp-banner-cta">{ln.lpCta} ↗</span>
          </span>
        </a>
      </section>

      <!-- 2027年 ラ・マンチャの旅（構想）と事前登録 -->
      <section class="home-sec" id="journey">
        <div class="tour">
          <div>
            <p class="sec-eyebrow">{ln.tourEyebrow}</p>
            <h2 class="sec-heading">{ln.tourHeading.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
            {ln.tourBody.map((p) => <p class="sec-text">{p}</p>)}
            <dl class="exhibit-rows">
              {ln.tourRows.map((r) => (
                <div><dt>{r.label}</dt><dd><b>{r.value}</b></dd></div>
              ))}
            </dl>
            <p class="tour-legal">{ln.tourLegal}</p>
          </div>
          {TOUR_FORM_URL ? (
            <div class="vip-form tour-cta-wrap">
              <h3>{ln.tourFormTitle}</h3>
              <a class="vip-submit fb-external" href={TOUR_FORM_URL} target="_blank" rel="noopener">{ln.tourFormButton} ↗</a>
            </div>
          ) : (
            <form class="vip-form" id="tourForm" novalidate data-email={TOUR_EMAIL} data-subject={ln.tourSubject}
              data-label-people={ln.tourLabelPeople} data-label-timing={ln.tourLabelTiming} data-msg={ln.tourError}>
              <h3>{ln.tourFormTitle}</h3>
              <label class="vip-field">
                <span>{ln.tourName}</span>
                <input type="text" name="name" id="tourName" autocomplete="name" required />
              </label>
              <label class="vip-field">
                <span>{ln.tourEmail}</span>
                <input type="email" name="email" id="tourEmail" autocomplete="email" required />
              </label>
              <label class="vip-field">
                <span>{ln.tourPeople}</span>
                <input type="number" name="people" id="tourPeople" min="1" max="20" value="1" inputmode="numeric" />
              </label>
              <fieldset class="vip-field">
                <legend>{ln.tourTiming}</legend>
                {ln.tourTimings.map((v, i) => (
                  <label class="vip-check"><input type="radio" name="timing" value={v} checked={i === 1} /> {v}</label>
                ))}
              </fieldset>
              <fieldset class="vip-field">
                <legend>{ln.tourInterest}</legend>
                {ln.tourInterests.map((v) => (
                  <label class="vip-check"><input type="checkbox" name="interest" value={v} /> {v}</label>
                ))}
              </fieldset>
              <label class="vip-field">
                <span>{ln.tourMessage}</span>
                <textarea name="message" id="tourMessage" rows="3"></textarea>
              </label>
              <button class="vip-submit" type="submit">{ln.tourSubmit}</button>
              <p class="vip-error" id="tourError" role="alert"></p>
              <p class="vip-note">{ln.tourNote}</p>
            </form>
          )}
        </div>
      </section>

      <!-- 日西文化交流レガシープロジェクト -->
      <section class="home-sec" id="legacy">
        <div class="legacy">
          <p class="sec-eyebrow">{lg.legacyEyebrow}</p>
          <h2 class="sec-heading">{lg.legacyHeading}</h2>
          {lg.legacyBody.map((p) => <p class="sec-text">{p}</p>)}
          <div class="legacy-news">
            <b>{lg.legacyNewsLabel}</b>
            <p>{lg.legacyNews}</p>
          </div>
          {lg.legacyStats.length > 0 && <div class="legacy-stats">
            {lg.legacyStats.map((s) => <div><b>{s.num}</b><span>{s.label}</span></div>)}
          </div>}
          <div class="sec-links">
            <a class="sec-cta" href={`${lpUrl}#legacy`} target="_blank" rel="noopener">{lg.legacyCta} →</a>
            <a class="sec-link" href={`#limited`} id="legacyToVip">{lg.vipHeading}</a>
          </div>
        </div>
      </section>

      <!-- 今日の一枚 -->
      <section class="home-sec" id="today">
        <div class="split">
          <div>
            <p class="sec-eyebrow">{h.todayEyebrow}</p>
            <h2 class="sec-heading">{h.todayHeading}</h2>
            <p class="sec-text">{h.todayNote}</p>
            <div class="sec-links">
              <button class="sec-cta" id="todayOpen" type="button">{h.todayOpen}</button>
              <button class="sec-link" id="todayAnother" type="button">{h.todayAnother}</button>
            </div>
          </div>
          <figure class="today-figure spot">
            <button class="today-btn" id="todayBtn" type="button" data-file={todayDefault.file}>
              <div class="home-frame"><img id="todayImg" src={`${base}/gallery/${todayDefault.file}`} alt={todayDefault.title} /></div>
            </button>
            <figcaption class="today-caption">
              <b id="todayTitle">{todayDefault.title}</b>
              <span id="todayMeta">{todayDefault.artist}{todayDefault.year !== '—' ? ` ／ ${todayDefault.year}` : ''}</span>
            </figcaption>
          </figure>
        </div>
      </section>


      <!-- 展示室 -->
      <section class="home-sec" id="rooms">
        <p class="sec-eyebrow" style="text-align:center">{h.roomsEyebrow}</p>
        <h2 class="sec-heading" style="text-align:center;margin-bottom:36px">{h.roomsHeading}</h2>
        <div class="room-cards">
          {roomCards.map((room, idx) => (
            <button class="room-card" type="button" data-room={room.id} data-name={room.name}>
              {room.cover && <img src={`${base}/gallery/${room.cover}`} alt="" loading="lazy" />}
              <span class="room-card-body">
                <span>
                  <span class="room-card-number">ROOM {String(idx + 1).padStart(2, '0')}</span>
                  <span class="room-card-name">{room.name}</span>
                </span>
                <span class="room-card-count">{room.count}{lang === 'ja' ? '' : ' '}{h.roomsWorks} →</span>
              </span>
            </button>
          ))}
        </div>
        <div class="storage-links">
          <p class="storage-links-lead">{h.storageLead}</p>
          <div class="storage-links-btns">
            <a class="storage-link-btn" href={`${base}/${lang}/storage/`}>{h.storageGo} →</a>
            <a class="storage-link-btn" href={`${base}/${lang}/storage/#list`}>📋 {h.storageList}</a>
          </div>
        </div>
      </section>

      <!-- Limited Edition ／ プロジェクト支援コミュニティ -->
      <section class="home-sec" id="limited">
        <div class="sec-head-center" style="margin-bottom:80px">
          <div class="sec-rule"></div>
          <p class="sec-eyebrow">{lg.vipEyebrow}</p>
          <h2 class="sec-heading">{lg.vipHeading}</h2>
          <p class="sec-text">{lg.vipLead}</p>
        </div>
        <div class="vip-cards">
          {lg.vipCards.map((c) => (
            <article class="vip-card">
              {c.mark && <p class="vip-mark"><b>{c.mark}</b><span>{c.unit}</span></p>}
              <h3>{c.title}</h3>
              <p>{c.body}</p>
              <small>{c.note}</small>
            </article>
          ))}
        </div>
        <form class="vip-form" id="vipForm" novalidate data-email={VIP_EMAIL} data-subject={lg.mailSubject}>
          <h3>{lg.formTitle}</h3>
          <label class="vip-field">
            <span>{lg.formName}</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label class="vip-field">
            <span>{lg.formEmail}</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <fieldset class="vip-field">
            <legend>{lg.formInterest}</legend>
            <label class="vip-check"><input type="checkbox" name="interest" value={lg.formOptEdition} checked /> {lg.formOptEdition}</label>
            <label class="vip-check"><input type="checkbox" name="interest" value={lg.formOptBoard} /> {lg.formOptBoard}</label>
          </fieldset>
          <label class="vip-field">
            <span>{lg.formMessage}</span>
            <textarea name="message" rows="4"></textarea>
          </label>
          <button class="vip-submit" type="submit">{lg.formSubmit}</button>
          <p class="vip-error" id="vipError" role="alert"></p>
          <p class="vip-note">{lg.formNote}</p>
        </form>
      </section>

      <!-- ご感想・ご意見（将来の展開について） -->
      <section class="home-sec" id="feedback">
        <div class="sec-head-center" style="margin-bottom:56px">
          <div class="sec-rule"></div>
          <p class="sec-eyebrow">{ln.fbEyebrow}</p>
          <h2 class="sec-heading">{ln.fbHeading}</h2>
          <p class="sec-text">{ln.fbLead}</p>
        </div>
        {FEEDBACK_FORM_URL ? (
          <div style="text-align:center">
            <a class="vip-submit fb-external" id="fbExternal" href={FEEDBACK_FORM_URL} data-fav-entry={FEEDBACK_FORM_FAV_ENTRY} target="_blank" rel="noopener">{ln.fbFormButton} ↗</a>
          </div>
        ) : (
          <form class="vip-form" id="fbForm" novalidate data-email={FEEDBACK_EMAIL} data-subject={ln.fbSubject}>
            <fieldset class="vip-field">
              <legend>{ln.fbTopic}</legend>
              {ln.fbTopics.map((topic, i) => (
                <label class="vip-check"><input type="radio" name="topic" value={topic} checked={i === 0} /> {topic}</label>
              ))}
            </fieldset>
            <label class="vip-field">
              <span>{ln.fbMessage}</span>
              <textarea name="message" rows="6" placeholder={ln.fbPlaceholder} required></textarea>
            </label>
            <label class="vip-field">
              <span>{ln.fbFav}</span>
              <input type="text" name="fav" id="fbFav" placeholder={ln.fbFavPlaceholder} data-label={ln.fbFavLabel} />
            </label>
            <label class="vip-field">
              <span>{ln.fbName}</span>
              <input type="text" name="name" autocomplete="name" />
            </label>
            <label class="vip-field">
              <span>{ln.fbEmail}</span>
              <input type="email" name="email" autocomplete="email" />
            </label>
            <button class="vip-submit" type="submit">{ln.fbSubmit}</button>
            <p class="vip-error" id="fbError" role="alert" data-msg={ln.fbError}></p>
            <p class="vip-note">{ln.fbNote}</p>
          </form>
        )}
      </section>

      <!-- 現地取材 -->
      <section class="home-sec">
        <div class="report-box">
          <p class="sec-eyebrow">{h.reportEyebrow}</p>
          <h2 class="sec-heading">{h.reportHeading}</h2>
          <p class="sec-text">{h.reportBody}</p>
          <div class="sec-links">
            <a class="sec-link" href={`${base}/${lang}/about/campo-notes/`}>{h.reportCta} →</a>
          </div>
        </div>
      </section>

      <!-- 画家について -->
      <section class="home-sec">
        <p class="sec-eyebrow">{h.artistEyebrow}</p>
        <h2 class="sec-heading">{h.artistHeading}</h2>
        <p class="sec-text">{h.artistBody}</p>
        <div class="sec-links">
          <a class="sec-link" href={`${base}/${lang}/about/`}>{h.artistMemoir} →</a>
          <a class="sec-link" href={`${base}/${lang}/about/philosophy/`}>{h.artistWhite} →</a>
        </div>
      </section>

      <footer class="home-footer">
        <div class="home-footer-inner">
          <div>
            <p class="home-footer-logo">{t.headerTitle}</p>
            <nav>
              <a href={`${base}/${lang}/about/campo-collection/`}>{h.navCampo}</a>
              <a href={`${base}/${lang}/about/`}>{h.navArtist}</a>
              <a href={lpUrl} target="_blank" rel="noopener">{ln.navLp} ↗</a>
              <a href={`${base}/${lang}/#exhibition`} id="footExhibition">{ln.navExhibition}</a>
              <a href={`${base}/${lang}/#journey`} id="footJourney">{ln.navTour}</a>
              <a href={`${base}/${lang}/#feedback`} id="footFeedback">{ln.navFeedback}</a>
              <a href={`${base}/${lang}/about/contact/`}>{h.footerContact}</a>
              <a href={`${base}/${lang}/shop/`}>{t.navShop}</a>
              <a href={`${base}/${lang}/storage/`}>{t.navStorage}</a>
            </nav>
            <a class="family" href="https://second-penguin.com/#sp-apps" target="_blank" rel="noopener">{h.footerFamily} →</a>
          </div>
          <nav aria-label="Language">
            <a href={`${base}/ja/`}>日本語</a>
            <a href={`${base}/en/`}>English</a>
            <a href={`${base}/sp/`}>Español</a>
          </nav>
        </div>
      </footer>
    </div>

    <!-- カンポ・デ・クリプターナ構想セクション -->
    <div class="campo-concept hidden" id="campoConceptScreen">
      <div class="campo-concept-inner">
        <p class="campo-concept-eyebrow">{concept.eyebrow}</p>
        <h2 class="campo-concept-title">{concept.title}</h2>
        {concept.paragraphs.map((p) => <p class="campo-concept-text">{p}</p>)}
        <a class="campo-concept-cta" href={`${base}/${lang}/about/campo-collection/`}>{concept.cta}</a>
        <button class="back-btn" id="backToTopFromConcept">{t.backTop}</button>
      </div>
    </div>

    <!-- 展示室セレクター（「入館する」から） -->
    <div class="room-selector hidden" id="roomSelector">
      <p class="room-selector-title">EXHIBITION ROOMS</p>
      <h2 class="room-selector-heading">{t.roomSelect}</h2>
      <div class="room-cards">
        {roomCards.map((room, idx) => (
          <button class="room-card" type="button" data-room={room.id} data-name={room.name}>
            {room.cover && <img src={`${base}/gallery/${room.cover}`} alt="" loading="lazy" />}
            <span class="room-card-body">
              <span>
                <span class="room-card-number">ROOM {String(idx + 1).padStart(2, '0')}</span>
                <span class="room-card-name">{room.name}</span>
              </span>
              <span class="room-card-count">{room.count}{lang === 'ja' ? '' : ' '}{h.roomsWorks} →</span>
            </span>
          </button>
        ))}
      </div>
      <div class="storage-links">
        <p class="storage-links-lead">{h.storageLead}</p>
        <div class="storage-links-btns">
          <a class="storage-link-btn" href={`${base}/${lang}/storage/`}>{h.storageGo} →</a>
          <a class="storage-link-btn" href={`${base}/${lang}/storage/#list`}>📋 {h.storageList}</a>
        </div>
      </div>
      <button class="back-btn" id="backToTopFromSelector">{t.backTop}</button>
    </div>

    <!-- ミュージアム本体 -->
    <div class="museum" id="museum">
      <div class="museum-header">
        <div class="museum-header-row">
          <h2 class="museum-title" id="museumTitle">{t.title}</h2>
          <div class="museum-count" id="museumCount"></div>
        </div>
      </div>
      <div class="scroll-hint">{t.scrollHint}</div>

      <div class="gallery-wrap">
        <button class="scroll-arrow left" id="arrowLeft">&#8249;</button>
        <div class="gallery-track" id="galleryTrack">
          {categorizedArtworks.map((info) => {
            const cardWidth = getCardWidth(info.rawSizeJa);
            return (
            <div
              class="artwork-card"
              style={`width: ${cardWidth}px; --frame-w: ${getFrameWidth(cardWidth)}px;`}
              data-category={info.category}
              data-file={info.file}
              data-title={info.title}
              data-artist={info.artist}
              data-year={info.year}
              data-size={info.size}
              data-description={info.description}
            >
              <div class="artwork-frame wood-frame">
                <img src={`${base}/gallery/${info.file}`} alt={info.title} loading="lazy" />
              </div>
              <div class="artwork-label">
                <div class="artwork-label-title">{info.title}</div>
                <div class="artwork-label-artist">{info.artist}</div>
              </div>
            </div>
            );
          })}
        </div>
        <button class="scroll-arrow right" id="arrowRight">&#8250;</button>
      </div>
    </div>

    <!-- モーダル -->
    <div class="modal-overlay" id="modalOverlay">
      <div class="modal">
        <button class="modal-close" id="modalClose">✕</button>
        <div style="text-align: center; margin-bottom: 20px;">
          <div id="modalFrame" class="wood-frame" style="display: inline-block; --frame-w: 20px;">
            <img id="modalImg" src="" style="max-width: 100%; max-height: 48vh; object-fit: contain; display: block;" />
          </div>
        </div>
        <h3 class="modal-title" id="modalTitle"></h3>
        <p class="modal-meta">
          <span id="modalArtist"></span>
          <span class="sep">&ensp;/&ensp;</span>
          <span id="modalYear"></span>
          <span class="sep">&ensp;/&ensp;</span>
          <span id="modalSize"></span>
        </p>
        <div class="modal-description" id="modalDescription"></div>
        <div style="text-align:center"><a class="modal-page-link" id="modalPageLink" href="#">{WORK_LABELS[lang].openPage} →</a></div>
      </div>
    </div>

    <script is:inline>
      const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') ?? '';
      const homeView     = document.getElementById('home');
      const roomSelector = document.getElementById('roomSelector');
      const campoConcept = document.getElementById('campoConceptScreen');
      const museum       = document.getElementById('museum');
      const galleryTrack = document.getElementById('galleryTrack');
      const siteHeader   = document.querySelector('.site-header');

      const hamburgerBtn  = document.getElementById('hamburgerBtn');
      const mobileMenu    = document.getElementById('mobileMenu');
      const mobileOverlay = document.getElementById('mobileOverlay');

      // モバイルメニュー開閉
      function openMobileMenu() {
        hamburgerBtn.classList.add('open');
        mobileMenu.classList.add('open');
        mobileOverlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeMobileMenu() {
        hamburgerBtn.classList.remove('open');
        mobileMenu.classList.remove('open');
        mobileOverlay.classList.remove('open');
        document.body.style.overflow = '';
      }

      hamburgerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (mobileMenu.classList.contains('open')) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      });

      mobileOverlay.addEventListener('click', closeMobileMenu);

      // 画面遷移（ホーム / 構想 / 部屋選び / ギャラリー）
      function showOnly(view) {
        homeView.classList.toggle('hidden', view !== 'home');
        siteHeader.classList.toggle('solid', view === 'home' && homeView.scrollTop > window.innerHeight * 0.6);
        campoConcept.classList.toggle('hidden', view !== 'concept');
        roomSelector.classList.toggle('hidden', view !== 'selector');
        museum.classList.toggle('visible', view === 'museum');
        closeMobileMenu();
      }

      function showHome(sectionId) {
        showOnly('home');
        if (sectionId) {
          const target = document.getElementById(sectionId);
          if (target) homeView.scrollTo({ top: target.offsetTop - 60, behavior: 'smooth' });
        } else {
          homeView.scrollTo({ top: 0 });
        }
      }

      function openRoom(roomId, roomName) {
        let count = 0;
        document.querySelectorAll('.artwork-card').forEach(card => {
          if (card.dataset.category === roomId) {
            card.style.display = 'block';
            count++;
          } else {
            card.style.display = 'none';
          }
        });

        document.getElementById('museumTitle').textContent = roomName;
        document.getElementById('museumCount').textContent = count + ' WORKS';

        galleryTrack.scrollLeft = 0;
        window.scrollTo(0, 0);
        showOnly('museum');
      }

      // ロゴとメニュー
      function onNav(id, handler) {
        document.getElementById(id).addEventListener('click', (e) => {
          e.preventDefault();
          handler();
        });
      }
      onNav('navLogo', () => showHome());
      onNav('mNavTop', () => showHome());
      onNav('navExhibition', () => showHome('rooms'));
      onNav('mNavExhibition', () => showHome('rooms'));
      onNav('enterBtn', () => showOnly('selector'));
      onNav('conceptLink', () => showOnly('concept'));
      onNav('storyConcept', () => showOnly('concept'));
      onNav('scrollCue', () => showHome('story'));
      onNav('eventBadge', () => showHome('exhibition'));
      onNav('navExhibitionInfo', () => showHome('exhibition'));
      onNav('mNavExhibitionInfo', () => showHome('exhibition'));
      onNav('mNavFeedback', () => showHome('feedback'));
      onNav('footExhibition', () => showHome('exhibition'));
      onNav('footFeedback', () => showHome('feedback'));
      onNav('mNavJourney', () => showHome('journey'));
      onNav('footJourney', () => showHome('journey'));
      onNav('navLimited', () => showHome('limited'));
      onNav('mNavLimited', () => showHome('limited'));
      onNav('legacyToVip', () => showHome('limited'));
      document.getElementById('backToTopFromConcept').addEventListener('click', () => showHome());
      document.getElementById('backToTopFromSelector').addEventListener('click', () => showHome());

      // 展示室カード（ホームと部屋選び画面）
      document.querySelectorAll('.room-card').forEach(btn => {
        btn.addEventListener('click', () => openRoom(btn.dataset.room, btn.dataset.name));
      });

      // ホームを下へスクロールしたらヘッダーに地色を敷く（絵や文字と重ならないように）
      homeView.addEventListener('scroll', () => {
        siteHeader.classList.toggle('solid', homeView.scrollTop > window.innerHeight * 0.6);
      }, { passive: true });

      // 他のページから「展示室」で来たとき（/ja/#rooms）
      // 作品ページの「この一枚が好き」から来たとき（/ja/?fav=01018#feedback）、好きな一枚の欄に作品番号を入れる
      const favParam = new URLSearchParams(location.search).get('fav');
      if (favParam && /^[\w-]{1,40}$/.test(favParam)) {
        const favInput = document.getElementById('fbFav');
        if (favInput) favInput.value = favParam;
        const fbExternal = document.getElementById('fbExternal');
        if (fbExternal?.dataset.favEntry) {
          const url = new URL(fbExternal.href);
          url.searchParams.set('usp', 'pp_url');
          url.searchParams.set(fbExternal.dataset.favEntry, favParam);
          fbExternal.href = url.toString();
        }
      }

      if (['#rooms', '#limited', '#exhibition', '#feedback', '#story', '#journey'].includes(location.hash)) {
        const sectionId = location.hash.slice(1);
        requestAnimationFrame(() => showHome(sectionId));
      }

      // テーマ（神戸など）の作品だけを展示室に並べる
      function openFiles(files, title) {
        let count = 0;
        document.querySelectorAll('.artwork-card').forEach(card => {
          const show = files.includes(card.dataset.file);
          card.style.display = show ? 'block' : 'none';
          if (show) count++;
        });
        document.getElementById('museumTitle').textContent = title;
        document.getElementById('museumCount').textContent = count + ' WORKS';
        galleryTrack.scrollLeft = 0;
        window.scrollTo(0, 0);
        showOnly('museum');
      }
      const kobeOpen = document.getElementById('kobeOpen');
      kobeOpen?.addEventListener('click', () => openFiles(kobeOpen.dataset.files.split(','), kobeOpen.dataset.title));

      // スクロール矢印
      document.getElementById('arrowLeft').addEventListener('click', () => {
        galleryTrack.scrollBy({ left: -360, behavior: 'smooth' });
      });
      document.getElementById('arrowRight').addEventListener('click', () => {
        galleryTrack.scrollBy({ left: 360, behavior: 'smooth' });
      });

      // アートワークモーダル
      function openArtwork(card) {
        document.getElementById('modalImg').src                 = `${base}/gallery/${card.dataset.file}`;
        document.getElementById('modalTitle').textContent       = card.dataset.title;
        document.getElementById('modalArtist').textContent      = card.dataset.artist;
        document.getElementById('modalYear').textContent        = card.dataset.year;
        document.getElementById('modalSize').textContent        = card.dataset.size;
        document.getElementById('modalDescription').textContent = card.dataset.description;
        document.getElementById('modalPageLink').href = `${base}/${document.documentElement.lang}/works/${card.dataset.file.replace(/\.[^.]+$/, '')}/`;
        document.getElementById('modalOverlay').classList.add('active');
      }

      document.querySelectorAll('.artwork-card').forEach(card => {
        card.addEventListener('click', () => openArtwork(card));
      });

      // 「2つの柱」の作品をクリックしたら、その作品を拡大表示する
      document.querySelectorAll('[data-open-file]').forEach(btn => {
        const card = document.querySelector(`.artwork-card[data-file="${btn.dataset.openFile}"]`);
        if (card) btn.addEventListener('click', () => openArtwork(card));
      });

      // Limited Edition の申込：入力内容を入れたメール作成画面を開く
      const vipForm = document.getElementById('vipForm');
      vipForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(vipForm);
        const name = String(data.get('name') || '').trim();
        const email = String(data.get('email') || '').trim();
        const interests = data.getAll('interest');
        const error = document.getElementById('vipError');
        if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || interests.length === 0) {
          const msg = { ja: 'お名前・メールアドレス・ご関心のある項目をご確認ください。', en: 'Please check your name, email and interests.', sp: 'Revise su nombre, correo e intereses.' };
          error.textContent = msg[document.documentElement.lang] ?? msg.ja;
          return;
        }
        error.textContent = '';
        const body = [
          `${name}`,
          `${email}`,
          '',
          ...interests.map((i) => `■ ${i}`),
          '',
          String(data.get('message') || '').trim(),
        ].join('\n');
        location.href = `mailto:${vipForm.dataset.email}?subject=${encodeURIComponent(vipForm.dataset.subject)}&body=${encodeURIComponent(body)}`;
      });

      // ご感想・ご意見：入力内容を入れたメール作成画面を開く（Googleフォーム未設定のとき）
      const fbForm = document.getElementById('fbForm');
      fbForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(fbForm);
        const message = String(data.get('message') || '').trim();
        const error = document.getElementById('fbError');
        if (!message) {
          error.textContent = error.dataset.msg;
          return;
        }
        error.textContent = '';
        const body = [
          `■ ${data.get('topic')}`,
          '',
          message,
          '',
          ...(String(data.get('fav') || '').trim() ? [`■ ${document.getElementById('fbFav').dataset.label}：${String(data.get('fav')).trim()}`, ''] : []),
          String(data.get('name') || '').trim(),
          String(data.get('email') || '').trim(),
        ].join('\n').trim();
        location.href = `mailto:${fbForm.dataset.email}?subject=${encodeURIComponent(fbForm.dataset.subject)}&body=${encodeURIComponent(body)}`;
      });

      // 2027年の旅の事前登録：入力内容を入れたメール作成画面を開く（Googleフォーム未設定のとき）
      const tourForm = document.getElementById('tourForm');
      tourForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(tourForm);
        const name = String(data.get('name') || '').trim();
        const email = String(data.get('email') || '').trim();
        const error = document.getElementById('tourError');
        if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          error.textContent = tourForm.dataset.msg;
          return;
        }
        error.textContent = '';
        const body = [
          name,
          email,
          '',
          `■ ${tourForm.dataset.labelPeople}：${data.get('people') || ''}`,
          `■ ${tourForm.dataset.labelTiming}：${data.get('timing') || ''}`,
          ...data.getAll('interest').map((i) => `■ ${i}`),
          '',
          String(data.get('message') || '').trim(),
        ].join('\n').trim();
        location.href = `mailto:${tourForm.dataset.email}?subject=${encodeURIComponent(tourForm.dataset.subject)}&body=${encodeURIComponent(body)}`;
      });

      // 展示会が終わったら「終了しました」と表示し、入口のお知らせを隠す
      const exhibitSec = document.getElementById('exhibition');
      if (Date.now() > Date.parse(exhibitSec.dataset.end)) {
        document.getElementById('exhibitEnded').hidden = false;
        document.getElementById('eventBadge').hidden = true;
        document.getElementById('exhibitCal').hidden = true;
      }

      document.getElementById('modalClose').addEventListener('click', () => {
        document.getElementById('modalOverlay').classList.remove('active');
      });

      document.getElementById('modalOverlay').addEventListener('click', (e) => {
        if (e.target.id === 'modalOverlay') {
          e.target.classList.remove('active');
        }
      });

      // 今日の一枚：訪問ごとに所蔵作品から1点を選ぶ
      const todayBtn = document.getElementById('todayBtn');
      // 題名が仮（「作品 3」など）のものは除く
      const todayPool = [...document.querySelectorAll('.artwork-card')]
        .filter(c => !/^(作品|Work|Obra)\s*\d+$/.test(c.dataset.title.trim()));
      let todayCard = todayPool.find(c => c.dataset.file === todayBtn.dataset.file) ?? todayPool[0];

      function showToday(card) {
        if (!card) return;
        todayCard = card;
        const img = document.getElementById('todayImg');
        img.src = `${base}/gallery/${card.dataset.file}`;
        img.alt = card.dataset.title;
        document.getElementById('todayTitle').textContent = card.dataset.title;
        const year = card.dataset.year && card.dataset.year !== '—' ? ` ／ ${card.dataset.year}` : '';
        document.getElementById('todayMeta').textContent = card.dataset.artist + year;
      }

      function pickToday() {
        if (todayPool.length < 2) return todayCard;
        let next;
        do { next = todayPool[Math.floor(Math.random() * todayPool.length)]; } while (next === todayCard);
        return next;
      }

      showToday(pickToday());
      todayBtn.addEventListener('click', () => openArtwork(todayCard));
      document.getElementById('todayOpen').addEventListener('click', () => openArtwork(todayCard));
      document.getElementById('todayAnother').addEventListener('click', () => showToday(pickToday()));
    </script>
  </body>
</html>
