---
import artworks from '../../data/artworks.json';
import { ui, rooms } from '../../data/ui.ts';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } }
  ];
}

const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const t = ui[lang];
const roomNames = rooms[lang];

const categorizedArtworks = artworks.map((info, i) => {
  let category = 0;
  const match = info.file?.match(/(\d+)/);
  if (match) {
    const num = parseInt(match[1], 10);
    if (num >= 1 && num <= 6) category = 1;
    else if (num >= 7 && num <= 12) category = 2;
  }
  
  const hue = 30 + ((i * 7) % 16);
  const sat = 40 + ((i * 11) % 26);
  const lit = 25 + ((i * 13) % 16);
  const frameLight = `hsl(${hue}, ${sat}%, ${lit + 15}%)`;
  const frameDark = `hsl(${hue}, ${sat}%, ${lit - 12}%)`;

  return { 
    ...info, 
    category, 
    frameLight, 
    frameDark,
    title: info.title?.[lang] || info.title?.ja,
    artist: info.artist?.[lang] || info.artist?.ja,
    year: info.year?.[lang] || info.year?.ja,
    size: info.size?.[lang] || info.size?.ja,
    description: info.description?.[lang] || info.description?.ja,
    rawSizeJa: info.size?.ja
  };
});

function getCardWidth(sizeStr) {
  const defaultWidth = 280; 
  if (!sizeStr) return defaultWidth;
  const match = sizeStr.match(/(\d+(?:\.\d+)?)/);
  if (!match) return defaultWidth;
  const num = parseFloat(match[1]);
  let scale = 1;
  if (sizeStr.includes('号') || num < 100) {
    scale = num / 30; 
  } else {
    scale = num / 90;
  }
  const clampedScale = Math.max(0.5, Math.min(scale, 2.5));
  return Math.round(defaultWidth * clampedScale);
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="base-url" content={base} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.title}</title>
    <style>
      /* ========== リセット & 基本 ========== */
      * { margin: 0; padding: 0; box-sizing: border-box; }

      :root {
        --crimson-deep:   #4a0a0a;   /* 最深部のえんじ */
        --crimson-mid:    #6b1212;   /* 中間えんじ */
        --crimson-rich:   #8b1a1a;   /* メインえんじ */
        --crimson-warm:   #a52020;   /* 明るめえんじ */
        --gold-dim:       #b8960c;   /* くすみゴールド */
        --gold-bright:    #d4af37;   /* 明るいゴールド */
        --gold-light:     #e8cc6a;   /* ハイライトゴールド */
        --parchment:      #f5efe0;   /* 羊皮紙色 */
        --text-main:      #f0e6d3;   /* メインテキスト */
        --text-sub:       #c4a882;   /* サブテキスト */
        --text-muted:     #7a6452;   /* 控えめテキスト */
        --overlay-dark:   rgba(20, 4, 4, 0.75);
      }

      body {
        font-family: "Garamond", "Times New Roman", "游明朝", serif;
        background: var(--crimson-deep);
        color: var(--text-main);
        overflow-x: hidden;
      }

      /* ========== ヘッダー ========== */
      .site-header {
        position: fixed;
        top: 0; left: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 50px;
        z-index: 1000;
        background: linear-gradient(
          to bottom,
          rgba(20, 4, 4, 0.92) 0%,
          rgba(20, 4, 4, 0.0) 100%
        );
        border-bottom: 1px solid rgba(212, 175, 55, 0.15);
      }

      .header-logo {
        font-size: 1.1rem;
        letter-spacing: 0.25em;
        font-weight: 400;
        color: var(--gold-bright);
        text-shadow: 0 2px 12px rgba(0,0,0,0.9);
      }

      .header-nav {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .header-nav a {
        color: var(--text-sub);
        text-decoration: none;
        font-size: 0.82rem;
        letter-spacing: 0.15em;
        opacity: 0.85;
        transition: opacity 0.3s, color 0.3s, transform 0.3s;
        text-shadow: 0 2px 8px rgba(0,0,0,0.9);
      }

      .header-nav a:hover {
        opacity: 1;
        color: var(--gold-light);
        transform: translateY(-1px);
      }

      .lang-switcher {
        display: flex;
        gap: 12px;
        border-left: 1px solid rgba(212, 175, 55, 0.3);
        padding-left: 18px;
        margin-left: 8px;
      }

      .lang-switcher a {
        font-size: 0.75rem;
        text-decoration: none;
        color: var(--text-sub);
        opacity: 0.55;
        letter-spacing: 0.1em;
        transition: opacity 0.3s, color 0.3s;
      }

      .lang-switcher a.active {
        opacity: 1;
        font-weight: bold;
        color: var(--gold-bright);
      }

      /* ========== 入口（ヒーロー）セクション ========== */
      .entrance {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 999;
        transition: opacity 1.4s ease, visibility 1.4s ease;

        /* 重厚な背景レイヤー */
        background:
          /* 最上層: えんじグラデーション */
          linear-gradient(
            160deg,
            rgba(30, 4, 4, 0.88) 0%,
            rgba(74, 10, 10, 0.72) 40%,
            rgba(107, 18, 18, 0.65) 65%,
            rgba(30, 4, 4, 0.90) 100%
          ),
          /* 中層: テクスチャ風ノイズ */
          repeating-linear-gradient(
            45deg,
            rgba(0,0,0,0.03) 0px,
            rgba(0,0,0,0.03) 1px,
            transparent 1px,
            transparent 8px
          ),
          /* 下層: 美術館イメージ写真 */
          url('https://images.unsplash.com/photo-1577083165239-0bd9f19fc08f?auto=format&fit=crop&w=1920&q=80')
          center / cover no-repeat;
      }

      .entrance.hidden {
        opacity: 0;
        visibility: hidden;
      }

      /* ヒーロー装飾ライン */
      .entrance::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(680px, 90vw);
        height: min(340px, 60vh);
        border: 1px solid rgba(212, 175, 55, 0.25);
        pointer-events: none;
      }

      .entrance::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(700px, 92vw);
        height: min(360px, 62vh);
        border: 1px solid rgba(212, 175, 55, 0.10);
        pointer-events: none;
      }

      /* ヒーロー内テキストブロック */
      .hero-inner {
        position: relative;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        padding: 0 20px;
      }

      .hero-eyebrow {
        font-size: clamp(0.6rem, 1.2vw, 0.75rem);
        letter-spacing: 0.45em;
        color: var(--gold-dim);
        text-transform: uppercase;
        margin-bottom: 18px;
        opacity: 0.9;
      }

      .hero-title {
        font-size: clamp(2rem, 5.5vw, 3.8rem);
        font-weight: 400;
        letter-spacing: 0.18em;
        line-height: 1.15;
        color: var(--text-main);
        text-shadow:
          0 2px 20px rgba(0,0,0,0.9),
          0 0 60px rgba(180, 30, 30, 0.4);
        margin-bottom: 10px;
      }

      .hero-subtitle {
        font-size: clamp(0.65rem, 1.5vw, 0.85rem);
        letter-spacing: 0.5em;
        color: var(--gold-bright);
        text-transform: uppercase;
        margin-bottom: 48px;
        opacity: 0.8;
      }

      /* 区切り装飾 */
      .hero-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 48px;
        width: 260px;
      }

      .hero-divider::before,
      .hero-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(
          to right,
          transparent,
          var(--gold-dim),
          transparent
        );
      }

      .hero-divider-diamond {
        width: 6px;
        height: 6px;
        background: var(--gold-bright);
        transform: rotate(45deg);
        flex-shrink: 0;
      }

      /* 入館ボタン */
      .enter-btn {
        position: relative;
        padding: 15px 58px;
        background: transparent;
        color: var(--gold-bright);
        font-family: inherit;
        font-size: clamp(0.72rem, 1.4vw, 0.82rem);
        letter-spacing: 0.45em;
        text-transform: uppercase;
        cursor: pointer;
        border: none;
        overflow: hidden;
        transition: color 0.45s ease;
      }

      /* 外枠 */
      .enter-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        border: 1px solid var(--gold-dim);
        transition: border-color 0.45s ease;
      }

      /* 塗りつぶしアニメ */
      .enter-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--gold-bright);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 0.45s cubic-bezier(0.76, 0, 0.24, 1);
        z-index: -1;
      }

      .enter-btn:hover {
        color: var(--crimson-deep);
      }

      .enter-btn:hover::before {
        border-color: var(--gold-bright);
      }

      .enter-btn:hover::after {
        transform: scaleX(1);
      }

      /* ========== 展示室選択 ========== */
      .room-selector {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 998;
        transition: opacity 1.2s ease, visibility 1.2s ease;

        background:
          linear-gradient(
            135deg,
            rgba(20, 4, 4, 0.97) 0%,
            rgba(50, 8, 8, 0.95) 50%,
            rgba(20, 4, 4, 0.97) 100%
          ),
          repeating-linear-gradient(
            0deg,
            rgba(212, 175, 55, 0.02) 0px,
            rgba(212, 175, 55, 0.02) 1px,
            transparent 1px,
            transparent 60px
          );
      }

      .room-selector.hidden {
        opacity: 0;
        visibility: hidden;
      }

      .room-selector-title {
        font-size: clamp(0.65rem, 1.3vw, 0.78rem);
        letter-spacing: 0.5em;
        color: var(--gold-dim);
        text-transform: uppercase;
        margin-bottom: 12px;
      }

      .room-selector-heading {
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 400;
        letter-spacing: 0.2em;
        color: var(--text-main);
        margin-bottom: 50px;
        text-align: center;
      }

      /* 室選択ボタングリッド */
      .room-list {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        justify-content: center;
        max-width: 860px;
        padding: 0 20px;
      }

      .room-btn {
        position: relative;
        padding: 20px 36px;
        background: rgba(74, 10, 10, 0.35);
        color: var(--text-sub);
        font-family: inherit;
        font-size: 0.82rem;
        letter-spacing: 0.22em;
        min-width: 230px;
        cursor: pointer;
        border: none;
        text-align: left;
        transition: color 0.35s ease, background 0.35s ease;
        overflow: hidden;
      }

      /* 左アクセントライン */
      .room-btn::before {
        content: '';
        position: absolute;
        left: 0; top: 0;
        width: 3px;
        height: 100%;
        background: var(--gold-dim);
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 0.35s cubic-bezier(0.76, 0, 0.24, 1);
      }

      /* 外枠 */
      .room-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        border: 1px solid rgba(212, 175, 55, 0.25);
        transition: border-color 0.35s ease;
      }

      .room-btn:hover {
        background: rgba(139, 26, 26, 0.45);
        color: var(--gold-light);
      }

      .room-btn:hover::before {
        transform: scaleY(1);
      }

      .room-btn:hover::after {
        border-color: rgba(212, 175, 55, 0.55);
      }

      .room-btn-number {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.3em;
        color: var(--gold-dim);
        margin-bottom: 6px;
        transition: color 0.35s;
      }

      .room-btn:hover .room-btn-number {
        color: var(--gold-bright);
      }

      /* 戻るボタン（セレクター内） */
      .back-btn {
        margin-top: 50px;
        background: none;
        border: none;
        color: var(--text-muted);
        font-family: inherit;
        font-size: 0.75rem;
        letter-spacing: 0.35em;
        cursor: pointer;
        text-transform: uppercase;
        transition: color 0.3s;
        position: relative;
        padding: 6px 0;
      }

      .back-btn::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0;
        width: 100%;
        height: 1px;
        background: var(--gold-dim);
        transform: scaleX(0);
        transition: transform 0.3s ease;
      }

      .back-btn:hover {
        color: var(--text-sub);
      }

      .back-btn:hover::after {
        transform: scaleX(1);
      }

      /* ========== ミュージアム本体 ========== */
      .museum {
        opacity: 0;
        visibility: hidden;
        transition: opacity 1.2s ease, visibility 1.2s ease;
        min-height: 100vh;

        /* えんじから深みある暗色へのグラデ背景 */
        background:
          linear-gradient(
            to bottom,
            var(--crimson-deep) 0%,
            #2a0808 18%,
            #1a0505 35%,
            #120303 100%
          );
      }

      .museum.visible {
        opacity: 1;
        visibility: visible;
      }

      .museum-header {
        text-align: center;
        padding-top: 130px;
        padding-bottom: 10px;
        position: relative;
      }

      .museum-header::after {
        content: '';
        display: block;
        width: 80px;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
        margin: 22px auto 0;
      }

      .museum-title {
        font-size: clamp(1.2rem, 3vw, 1.8rem);
        font-weight: 400;
        letter-spacing: 0.4em;
        color: var(--text-main);
      }

      .museum-count {
        color: var(--text-muted);
        font-size: 0.72rem;
        letter-spacing: 0.25em;
        margin-top: 12px;
      }

      .scroll-hint {
        text-align: center;
        color: var(--text-muted);
        font-size: 0.65rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-top: 22px;
      }

      /* ギャラリートラック */
      .gallery-wrap {
        position: relative;
        display: flex;
        align-items: center;
        margin-top: 10px;
      }

      .gallery-track {
        display: flex;
        gap: 80px;
        padding: 60px 100px 150px;
        overflow-x: auto;
        scroll-behavior: smooth;
        align-items: center;
        scrollbar-width: thin;
        scrollbar-color: var(--crimson-mid) var(--crimson-deep);
      }

      .gallery-track::-webkit-scrollbar { height: 4px; }
      .gallery-track::-webkit-scrollbar-track { background: var(--crimson-deep); }
      .gallery-track::-webkit-scrollbar-thumb { background: var(--crimson-mid); border-radius: 2px; }

      /* スクロール矢印 */
      .scroll-arrow {
        position: absolute;
        z-index: 10;
        background: rgba(74, 10, 10, 0.7);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: var(--gold-bright);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 1.3rem;
        transition: background 0.3s, border-color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .scroll-arrow:hover {
        background: rgba(139, 26, 26, 0.9);
        border-color: var(--gold-bright);
      }

      .scroll-arrow.left { left: 18px; }
      .scroll-arrow.right { right: 18px; }

      /* 作品カード */
      .artwork-card {
        flex: 0 0 auto;
        cursor: pointer;
        position: relative;
        transition: transform 0.35s ease;
      }

      .artwork-card:hover {
        transform: translateY(-6px);
      }

      .artwork-frame {
        border-style: solid;
        border-width: 18px;
        border-color:
          var(--frame-light)
          var(--frame-dark)
          var(--frame-dark)
          var(--frame-light);
        border-radius: 10px;
        box-shadow:
          10px 15px 35px rgba(0,0,0,0.8),
          0 0 0 1px rgba(0,0,0,0.4),
          inset 0 0 20px rgba(0,0,0,0.3);
      }

      .artwork-frame img {
        width: 100%;
        display: block;
      }

      .artwork-label {
        text-align: center;
        margin-top: 22px;
        padding: 0 4px;
      }

      .artwork-label-title {
        font-size: 0.78rem;
        color: var(--text-sub);
        letter-spacing: 0.08em;
      }

      .artwork-label-artist {
        font-size: 0.68rem;
        color: var(--text-muted);
        margin-top: 5px;
        letter-spacing: 0.06em;
      }

      /* ========== モーダル ========== */
      .modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(10, 2, 2, 0.93);
        z-index: 2000;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(4px);
      }

      .modal-overlay.active { display: flex; }

      .modal {
        background: linear-gradient(160deg, #1e0808 0%, #150404 100%);
        border: 1px solid rgba(212, 175, 55, 0.2);
        padding: 40px;
        max-width: 740px;
        width: 92%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        box-shadow:
          0 30px 80px rgba(0,0,0,0.8),
          inset 0 1px 0 rgba(212, 175, 55, 0.1);
      }

      .modal-close {
        position: absolute;
        top: 16px; right: 20px;
        background: none;
        border: 1px solid rgba(212, 175, 55, 0.25);
        color: var(--text-sub);
        font-size: 1rem;
        width: 34px;
        height: 34px;
        cursor: pointer;
        transition: border-color 0.3s, color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .modal-close:hover {
        border-color: var(--gold-bright);
        color: var(--gold-bright);
      }

      .modal-title {
        font-size: 1.2rem;
        font-weight: 400;
        letter-spacing: 0.1em;
        color: var(--text-main);
        margin-bottom: 10px;
      }

      .modal-meta {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin-bottom: 22px;
        letter-spacing: 0.05em;
      }

      .modal-description {
        font-size: 0.85rem;
        line-height: 1.75;
        color: var(--text-sub);
        background: rgba(255,255,255,0.03);
        border-left: 2px solid var(--gold-dim);
        padding: 16px 18px;
      }
    </style>
  </head>
  <body>

    <!-- ヘッダー -->
    <header class="site-header">
      <div class="header-logo">{t.headerTitle}</div>
      <nav class="header-nav">
        <a href="#" id="navTop">{t.backTop}</a>
        <a href={`${base}/${lang}/about/`}>{t.navAbout}</a>
        <a href="#" id="navExhibition">{t.roomSelect}</a>
        <a href="#" onclick={`alert('${t.alertShop}'); return false;`}>{t.navShop}</a>
        <div class="lang-switcher">
          <a href={`${base}/ja/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
          <a href={`${base}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
          <a href={`${base}/sp/`} class={lang === 'sp' ? 'active' : ''}>SP</a>
        </div>
      </nav>
    </header>

    <!-- ヒーロー / 入口 -->
    <div class="entrance" id="entrance">
      <div class="hero-inner">
        <p class="hero-eyebrow">TOKUNAGA ART MUSEUM</p>
        <h1 class="hero-title">{t.title}</h1>
        <p class="hero-subtitle">PERMANENT COLLECTION</p>
        <div class="hero-divider">
          <div class="hero-divider-diamond"></div>
        </div>
        <button class="enter-btn" id="enterBtn">{t.enter}</button>
      </div>
    </div>

    <!-- 展示室セレクター -->
    <div class="room-selector hidden" id="roomSelector">
      <p class="room-selector-title">EXHIBITION ROOMS</p>
      <h2 class="room-selector-heading">{t.roomSelect}</h2>
      <div class="room-list">
        {roomNames.map((room, idx) => (
          <button class="room-btn" data-room={room.id} data-name={room.name}>
            <span class="room-btn-number">ROOM {String(idx + 1).padStart(2, '0')}</span>
            {room.prefix}{room.name}
          </button>
        ))}
      </div>
      <button class="back-btn" id="backToTopFromSelector">{t.backTop}</button>
    </div>

    <!-- ミュージアム本体 -->
    <div class="museum" id="museum">
      <div class="museum-header">
        <h2 class="museum-title" id="museumTitle">{t.title}</h2>
        <div class="museum-count" id="museumCount"></div>
      </div>
      <div class="scroll-hint">{t.scrollHint}</div>

      <div class="gallery-wrap">
        <button class="scroll-arrow left" id="arrowLeft">&#8249;</button>
        <div class="gallery-track" id="galleryTrack">
          {categorizedArtworks.map((info) => (
            <div
              class="artwork-card"
              style={`width: ${getCardWidth(info.rawSizeJa)}px; --frame-light: ${info.frameLight}; --frame-dark: ${info.frameDark};`}
              data-category={info.category}
              data-file={info.file}
              data-title={info.title}
              data-artist={info.artist}
              data-year={info.year}
              data-size={info.size}
              data-description={info.description}
            >
              <div class="artwork-frame">
                <img src={`${base}/gallery/${info.file}`} alt={info.title} loading="lazy" />
              </div>
              <div class="artwork-label">
                <div class="artwork-label-title">{info.title}</div>
                <div class="artwork-label-artist">{info.artist}</div>
              </div>
            </div>
          ))}
        </div>
        <button class="scroll-arrow right" id="arrowRight">&#8250;</button>
      </div>
    </div>

    <!-- モーダル -->
    <div class="modal-overlay" id="modalOverlay">
      <div class="modal">
        <button class="modal-close" id="modalClose">✕</button>
        <div style="text-align: center; margin-bottom: 24px;">
          <img id="modalImg" src="" style="max-width: 100%; max-height: 58vh; object-fit: contain;" />
        </div>
        <h3 class="modal-title" id="modalTitle"></h3>
        <p class="modal-meta">
          <span id="modalArtist"></span>
          &ensp;/&ensp;<span id="modalYear"></span>
          &ensp;/&ensp;<span id="modalSize"></span>
        </p>
        <div class="modal-description" id="modalDescription"></div>
      </div>
    </div>

    <script define:vars={{ alertPreparing: t.alertPreparing }}>
      const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') ?? '';
      const entrance    = document.getElementById('entrance');
      const roomSelector = document.getElementById('roomSelector');
      const museum      = document.getElementById('museum');
      const galleryTrack = document.getElementById('galleryTrack');

      function showEntrance() {
        entrance.classList.remove('hidden');
        roomSelector.classList.add('hidden');
        museum.classList.remove('visible');
      }
      function showSelector() {
        entrance.classList.add('hidden');
        roomSelector.classList.remove('hidden');
        museum.classList.remove('visible');
      }

      document.getElementById('enterBtn').onclick = showSelector;
      document.getElementById('navExhibition').onclick = (e) => { e.preventDefault(); showSelector(); };
      document.getElementById('navTop').onclick      = (e) => { e.preventDefault(); showEntrance(); };
      document.getElementById('backToTopFromSelector').onclick = showEntrance;

      document.querySelectorAll('.room-btn').forEach(btn => {
        btn.onclick = () => {
          const roomId   = btn.dataset.room;
          const roomName = btn.dataset.name;

          if (parseInt(roomId) >= 3) {
            alert(alertPreparing);
            return;
          }

          let count = 0;
          document.querySelectorAll('.artwork-card').forEach(card => {
            if (card.dataset.category === roomId) {
              card.style.display = 'block';
              count++;
            } else {
              card.style.display = 'none';
            }
          });

          document.getElementById('museumTitle').textContent = roomName;
          document.getElementById('museumCount').textContent = count + ' WORKS';

          galleryTrack.scrollLeft = 0;
          roomSelector.classList.add('hidden');
          museum.classList.add('visible');
        };
      });

      document.getElementById('arrowLeft').onclick  = () => galleryTrack.scrollBy({ left: -400, behavior: 'smooth' });
      document.getElementById('arrowRight').onclick = () => galleryTrack.scrollBy({ left:  400, behavior: 'smooth' });

      document.querySelectorAll('.artwork-card').forEach(card => {
        card.onclick = () => {
          document.getElementById('modalImg').src        = `${base}/gallery/${card.dataset.file}`;
          document.getElementById('modalTitle').textContent       = card.dataset.title;
          document.getElementById('modalArtist').textContent      = card.dataset.artist;
          document.getElementById('modalYear').textContent        = card.dataset.year;
          document.getElementById('modalSize').textContent        = card.dataset.size;
          document.getElementById('modalDescription').textContent = card.dataset.description;
          document.getElementById('modalOverlay').classList.add('active');
        };
      });

      document.getElementById('modalClose').onclick = () =>
        document.getElementById('modalOverlay').classList.remove('active');
      document.getElementById('modalOverlay').onclick = (e) => {
        if (e.target.id === 'modalOverlay') e.target.classList.remove('active');
      };
    </script>
  </body>
</html>
