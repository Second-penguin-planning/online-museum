---
import artworks from '../../data/artworks.json';
import { ui, rooms, home } from '../../data/ui.ts';
import { campoConceptContent } from '../../data/campoConcept.ts';
import { campoCollectionItems } from '../../data/campoCollection.ts';
import AboutNavDropdown from '../../components/AboutNavDropdown.astro';
import SeoMeta from '../../components/SeoMeta.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } }
  ];
}

const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const t = ui[lang];
const roomNames = rooms[lang];
const concept = campoConceptContent[lang] ?? campoConceptContent.ja;
const h = home[lang] ?? home.ja;
const worksUnit = { ja: '点', en: 'works', sp: 'obras' }[lang];
const storyStats = h.storyStats.map((s) =>
  s.num === 'WORKS' ? { ...s, num: `${campoCollectionItems.length}${lang === 'ja' ? '' : ' '}${worksUnit}` } : s
);

// 所蔵庫で「ギャラリーに公開」を選んだ作品だけを展示する
const publishedArtworks = artworks.filter(a => a.published);

// 額縁の色（茶・金・濃い茶）と形（5パターン）をランダムに組み合わせる
const FRAME_COLORS = [
  { light: '#a97c50', dark: '#6b4423' }, // 茶
  { light: '#e8ca6e', dark: '#a8842e' }, // 金
  { light: '#5c3a24', dark: '#2a1a0e' }, // 濃い茶
];
const FRAME_SHAPES = ['classic', 'ridge', 'sharp', 'groove', 'ornate'];

const categorizedArtworks = publishedArtworks.map((info, i) => {
  let category = 0;
  if (info.artistKey === 'takuma') category = 1;
  else if (info.artistKey === 'sachiko') category = 2;

  const frameColor = FRAME_COLORS[Math.floor(Math.random() * FRAME_COLORS.length)];
  const frameShape = FRAME_SHAPES[Math.floor(Math.random() * FRAME_SHAPES.length)];

  return {
    ...info,
    category,
    frameLight: frameColor.light,
    frameDark: frameColor.dark,
    frameShape,
    title:       info.title?.[lang]       || info.title?.ja       || '—',
    artist:      info.artist?.[lang]      || info.artist?.ja      || '—',
    year:        info.year?.[lang]        || info.year?.ja        || '—',
    size:        info.size?.[lang]        || info.size?.ja        || '—',
    description: info.description?.[lang] || info.description?.ja || '',
    rawSizeJa:   info.size?.ja
  };
});

// ホームの「展示室」カード用：部屋ごとの作品数と代表作
const ROOM_COVER: Record<string, string> = { '1': '01018.jpg' };
const roomCards = roomNames.map((room) => {
  const works = categorizedArtworks.filter((a) => String(a.category) === room.id);
  const cover = works.find((a) => a.file === ROOM_COVER[room.id]) ?? works[0];
  return { ...room, count: works.length, cover: cover?.file };
}).filter((room) => room.count > 0);

// 「今日の一枚」の初期表示（JSが読み込まれると訪問ごとに入れ替わる）
const todayDefault = categorizedArtworks.find((a) => a.file === '01044.jpg') ?? categorizedArtworks[0];
const storyImage = '01018.jpg';

function getCardWidth(sizeStr) {
  const defaultWidth = 280; 
  if (!sizeStr) return defaultWidth;
  const match = sizeStr.match(/(\d+(?:\.\d+)?)/);
  if (!match) return defaultWidth;
  const num = parseFloat(match[1]);
  let scale = 1;
  if (sizeStr.includes('号') || num < 100) {
    scale = num / 30; 
  } else {
    scale = num / 90;
  }
  const clampedScale = Math.max(0.5, Math.min(scale, 2.5));
  return Math.round(defaultWidth * clampedScale);
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="base-url" content={base} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`${t.title}｜${h.tagline}`}</title>
    <SeoMeta lang={lang} title={`${t.title}｜${h.tagline}`} description={h.description} />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      :root {
        --crimson-deep:   #ffffff;
        --crimson-mid:    #f6f1e8;
        --crimson-rich:   #ede2c9;
        --crimson-warm:   #e3d3ab;
        --gold-dim:       #c9a227;
        --gold-bright:    #b8860b;
        --gold-light:     #8a6508;
        --parchment:      #faf7f0;
        --text-main:      #2a2015;
        --text-sub:       #5c4a35;
        --text-muted:     #8c7a63;
        --overlay-dark:   rgba(255, 255, 255, 0.75);
      }

      body {
        font-family: "Garamond", "Times New Roman", "游明朝", serif;
        background: var(--crimson-deep);
        color: var(--text-main);
        overflow-x: hidden;
      }

      .site-header {
        position: fixed;
        top: 0; left: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 50px;
        gap: 32px;
        z-index: 1000;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.95) 0%,
          rgba(255, 255, 255, 0.0) 100%
        );
        border-bottom: 1px solid rgba(212, 175, 55, 0.15);
      }

      .site-header.solid {
        background: rgba(255, 253, 248, 0.97);
        box-shadow: 0 1px 12px rgba(60, 40, 10, 0.08);
      }

      .header-logo {
        font-size: 1.1rem;
        letter-spacing: 0.25em;
        font-weight: 400;
        color: var(--gold-bright);
        text-decoration: none;
        text-shadow: 0 1px 8px rgba(255,255,255,0.9);
        flex-shrink: 0;
      }

      .header-nav {
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .header-nav a,
      .header-nav button {
        color: var(--text-sub);
        text-decoration: none;
        font-size: 0.82rem;
        letter-spacing: 0.15em;
        opacity: 0.85;
        transition: opacity 0.3s, color 0.3s, transform 0.3s;
        text-shadow: 0 1px 8px rgba(255,255,255,0.9);
        white-space: nowrap;
        background: none;
        border: none;
        font-family: inherit;
        cursor: pointer;
        padding: 0;
      }

      .header-nav a:hover,
      .header-nav button:hover {
        opacity: 1;
        color: var(--gold-light);
        transform: translateY(-1px);
      }

      .header-nav a.nav-campo-highlight {
        opacity: 1;
        color: var(--gold-bright);
        border: 1px solid rgba(212, 175, 55, 0.5);
        border-radius: 999px;
        padding: 6px 14px !important;
      }
      .header-nav a.nav-campo-highlight:hover {
        background: rgba(212, 175, 55, 0.12);
        border-color: var(--gold-bright);
      }
      .mobile-menu-nav a.nav-campo-highlight {
        color: var(--gold-bright);
      }

      .lang-switcher {
        display: flex;
        gap: 12px;
        border-left: 1px solid rgba(212, 175, 55, 0.3);
        padding-left: 18px;
        margin-left: 8px;
      }

      .lang-switcher a {
        font-size: 0.75rem;
        text-decoration: none;
        color: var(--text-sub);
        opacity: 0.55;
        letter-spacing: 0.1em;
        transition: opacity 0.3s, color 0.3s;
      }

      .lang-switcher a.active {
        opacity: 1;
        font-weight: bold;
        color: var(--gold-bright);
      }

      .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 40px;
        height: 40px;
        background: none;
        border: 1px solid rgba(212, 175, 55, 0.3);
        cursor: pointer;
        padding: 8px;
        flex-shrink: 0;
        transition: border-color 0.3s;
        z-index: 1100;
        position: relative;
      }

      .hamburger:hover { border-color: var(--gold-bright); }

      .hamburger span {
        display: block;
        width: 22px;
        height: 1.5px;
        background: var(--gold-bright);
        transition: transform 0.35s ease, opacity 0.35s ease;
        transform-origin: center;
      }

      .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
      .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
      .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

      .mobile-menu {
        position: fixed;
        top: 0; right: 0;
        width: min(280px, 80vw);
        height: 100%;
        background: linear-gradient(
          160deg,
          rgba(255, 255, 255, 0.98) 0%,
          rgba(246, 241, 232, 0.98) 100%
        );
        border-left: 1px solid rgba(212, 175, 55, 0.2);
        z-index: 1050;
        flex-direction: column;
        padding: 80px 32px 40px;
        gap: 0;
        transform: translateX(100%);
        transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1);
        box-shadow: -8px 0 30px rgba(0,0,0,0.6);
        display: flex;
        pointer-events: none;
      }

      .mobile-menu.open {
        transform: translateX(0);
        pointer-events: auto;
      }

      .mobile-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1040;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease, visibility 0.4s ease;
        pointer-events: none;
      }

      .mobile-overlay.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      .mobile-menu-nav {
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .mobile-menu-nav a,
      .mobile-menu-nav button {
        display: block;
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        border-bottom: 1px solid rgba(212, 175, 55, 0.12);
        color: var(--text-sub);
        font-family: inherit;
        font-size: 0.88rem;
        letter-spacing: 0.2em;
        padding: 18px 0;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.3s, padding-left 0.3s;
      }

      .mobile-menu-nav a:hover,
      .mobile-menu-nav button:hover {
        color: var(--gold-light);
        padding-left: 8px;
      }

      .mobile-menu-nav a:first-child,
      .mobile-menu-nav button:first-child {
        border-top: 1px solid rgba(212, 175, 55, 0.12);
      }

      .mobile-lang-switcher {
        display: flex;
        gap: 16px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid rgba(212, 175, 55, 0.2);
      }

      .mobile-lang-switcher a {
        font-size: 0.8rem;
        text-decoration: none;
        color: var(--text-sub);
        opacity: 0.55;
        letter-spacing: 0.12em;
        transition: opacity 0.3s, color 0.3s;
      }

      .mobile-lang-switcher a.active {
        opacity: 1;
        font-weight: bold;
        color: var(--gold-bright);
      }

      /* ホーム：入口写真の下に区画が続く縦スクロール画面 */
      .home {
        position: fixed;
        inset: 0;
        z-index: 990;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        background: var(--parchment);
        transition: opacity 1.2s ease, visibility 1.2s ease;
      }

      .home.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .entrance {
        position: relative;
        width: 100%;
        height: 100vh;
        height: 100svh;
        min-height: 520px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background-color: #ddd8cf;
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
      }

      /* 写真の下半分に影を敷いて、白文字を読めるようにする */
      .entrance::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(20, 14, 6, 0) 30%,
          rgba(20, 14, 6, 0.38) 55%,
          rgba(20, 14, 6, 0.72) 100%
        );
        pointer-events: none;
      }

      .hero-inner {
        position: absolute;
        bottom: 11%;
        left: 50%;
        transform: translateX(-50%);
        width: min(760px, 100%);
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        padding: 0 24px;
        z-index: 1;
      }

      .hero-eyebrow {
        font-size: clamp(0.6rem, 2.5vw, 0.75rem);
        letter-spacing: 0.35em;
        color: #f1dfae;
        text-transform: uppercase;
        margin-bottom: 14px;
        text-shadow: 0 1px 6px rgba(0,0,0,0.6);
      }

      .hero-title {
        font-size: clamp(1.9rem, 6vw, 3.6rem);
        font-weight: 400;
        letter-spacing: 0.15em;
        line-height: 1.2;
        color: #ffffff;
        text-shadow: 0 2px 18px rgba(0, 0, 0, 0.55);
        margin-bottom: 14px;
      }

      .hero-subtitle {
        font-size: clamp(0.88rem, 3.4vw, 1.12rem);
        letter-spacing: 0.12em;
        line-height: 1.8;
        color: #fbf6ea;
        margin-bottom: 26px;
        text-shadow: 0 1px 10px rgba(0,0,0,0.6);
        text-wrap: balance;
      }

      .hero-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 36px;
        width: min(260px, 70vw);
      }

      .hero-divider::before,
      .hero-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
      }

      .hero-divider-diamond {
        width: 6px;
        height: 6px;
        background: var(--gold-bright);
        transform: rotate(45deg);
        flex-shrink: 0;
      }

      .enter-btn {
        position: relative;
        padding: 14px 40px;
        background: var(--gold-bright);
        color: #ffffff;
        font-family: inherit;
        font-size: clamp(0.8rem, 2.5vw, 0.9rem);
        letter-spacing: 0.4em;
        text-transform: uppercase;
        white-space: nowrap;
        cursor: pointer;
        border: 1px solid #d9b65c;
        border-radius: 2px;
        min-width: 220px;
        min-height: 52px;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        box-shadow: 0 6px 20px rgba(0,0,0,0.35);
        transition: background 0.3s ease, transform 0.3s ease;
      }

      .enter-btn:hover {
        background: var(--gold-light);
        transform: translateY(-1px);
      }

      .concept-link {
        margin-top: 20px;
        background: none;
        border: none;
        cursor: pointer;
        font-family: inherit;
        color: #f1dfae;
        font-size: 0.66rem;
        letter-spacing: 0.3em;
        text-shadow: 0 1px 6px rgba(0,0,0,0.7);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        transition: opacity 0.3s;
      }
      .concept-link:hover { opacity: 0.85; }
      .concept-link span {
        font-family: 'Garamond', 'Times New Roman', '游明朝', serif;
        letter-spacing: 0.08em;
        font-size: 0.95rem;
        color: #ffffff;
        text-decoration: underline;
        text-decoration-color: rgba(241, 223, 174, 0.8);
        text-underline-offset: 4px;
      }

      .scroll-cue {
        position: absolute;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1;
        color: rgba(255,255,255,0.8);
        font-size: 0.6rem;
        letter-spacing: 0.35em;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        background: none;
        border: none;
        font-family: inherit;
        cursor: pointer;
      }
      .scroll-cue::after {
        content: '';
        width: 1px;
        height: 22px;
        background: rgba(255,255,255,0.7);
        animation: cue 2.2s ease-in-out infinite;
        transform-origin: top;
      }
      @keyframes cue { 0%,100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }
      @media (prefers-reduced-motion: reduce) { .scroll-cue::after { animation: none; } }

      /* ── ホームの各区画 ── */
      .home-sec {
        max-width: 1040px;
        margin: 0 auto;
        padding: 88px 24px;
        border-top: 1px solid rgba(201, 162, 39, 0.22);
      }
      .entrance + .home-sec { border-top: 0; }
      .sec-eyebrow {
        font-size: 0.68rem;
        letter-spacing: 0.35em;
        color: var(--gold-bright);
        margin-bottom: 10px;
      }
      .sec-heading {
        font-size: clamp(1.35rem, 4vw, 2rem);
        font-weight: 400;
        letter-spacing: 0.12em;
        line-height: 1.5;
        color: var(--text-main);
        margin-bottom: 18px;
        text-wrap: balance;
      }
      .sec-text {
        font-size: 0.98rem;
        line-height: 2;
        color: var(--text-sub);
        max-width: 34em;
      }
      .sec-text + .sec-text { margin-top: 12px; }
      .sec-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px 24px;
        align-items: center;
        margin-top: 28px;
      }
      .sec-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 26px;
        background: var(--text-main);
        color: #fff;
        text-decoration: none;
        font-size: 0.85rem;
        letter-spacing: 0.15em;
        border: none;
        font-family: inherit;
        cursor: pointer;
        transition: background 0.3s;
      }
      .sec-cta:hover { background: var(--gold-light); }
      .sec-link {
        color: var(--gold-light);
        text-decoration: none;
        font-size: 0.88rem;
        letter-spacing: 0.08em;
        border-bottom: 1px solid var(--gold-dim);
        padding-bottom: 2px;
        background: none;
        border-top: 0; border-left: 0; border-right: 0;
        font-family: inherit;
        cursor: pointer;
      }
      .sec-link:hover { color: var(--text-main); }

      .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 56px;
        align-items: center;
      }
      .split > * { min-width: 0; }

      .home-frame {
        border-width: 16px;
        border-style: solid;
        border-color: #a97c50 #6b4423 #6b4423 #a97c50;
        border-radius: 4px;
        box-shadow: 8px 14px 30px rgba(0,0,0,0.45), 0 0 0 1px rgba(0,0,0,0.3), inset 0 0 16px rgba(0,0,0,0.3);
        background: #2a1a0e;
      }
      .home-frame img { display: block; width: 100%; height: auto; }

      .today-figure {
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
      }
      .today-btn {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        max-width: min(520px, 100%);
        transition: transform 0.35s ease;
      }
      .today-btn:hover { transform: translateY(-4px); }
      .today-btn img { max-height: 62vh; width: auto; max-width: 100%; }
      .today-caption { text-align: center; }
      .today-caption b { display: block; font-weight: 400; font-size: 1.05rem; letter-spacing: 0.08em; color: var(--text-main); }
      .today-caption span { font-size: 0.8rem; color: var(--text-muted); letter-spacing: 0.06em; }

      .story-stats {
        display: grid;
        grid-template-columns: repeat(3, auto);
        justify-content: start;
        gap: 10px 32px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid rgba(201, 162, 39, 0.3);
      }
      .story-stats b { display: block; font-weight: 400; font-size: 1.3rem; color: var(--text-main); letter-spacing: 0.04em; }
      .story-stats span { font-size: 0.72rem; color: var(--text-muted); letter-spacing: 0.08em; }

      /* 展示室カード（ホームと部屋選び画面で共通） */
      .room-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        width: 100%;
        max-width: 860px;
        margin: 0 auto;
      }
      .room-card {
        display: flex;
        flex-direction: column;
        text-align: left;
        background: #fffdf8;
        border: 1px solid rgba(201, 162, 39, 0.35);
        padding: 0;
        cursor: pointer;
        font-family: inherit;
        color: var(--text-main);
        transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }
      .room-card:hover {
        transform: translateY(-4px);
        border-color: var(--gold-bright);
        box-shadow: 0 14px 30px -14px rgba(60, 40, 10, 0.45);
      }
      .room-card img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
      }
      .room-card-body {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px;
      }
      .room-card-number {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.3em;
        color: var(--gold-bright);
        margin-bottom: 4px;
      }
      .room-card-name { font-size: 1.05rem; letter-spacing: 0.12em; }
      .room-card-count { font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; letter-spacing: 0.06em; }

      .report-box {
        background: var(--crimson-mid);
        border: 1px solid rgba(201, 162, 39, 0.3);
        padding: 40px clamp(20px, 5vw, 56px);
      }

      .home-footer {
        background: #26211b;
        color: #d8cfbf;
        padding: 48px 24px 40px;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
      }
      .home-footer-inner {
        max-width: 1040px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 28px;
      }
      .home-footer-logo { color: #d9b65c; letter-spacing: 0.25em; font-size: 0.9rem; margin-bottom: 8px; }
      .home-footer nav { display: flex; flex-wrap: wrap; gap: 10px 22px; }
      .home-footer a { color: #d8cfbf; text-decoration: none; }
      .home-footer a:hover { color: #f1dfae; text-decoration: underline; }
      .home-footer .family { display: block; margin-top: 14px; color: #a99f8e; }

      @media (max-width: 768px) {
        .home-sec { padding: 64px 20px; }
        .split { grid-template-columns: 1fr; gap: 36px; }
        .story .split > figure { order: -1; }
        .story-stats { grid-template-columns: repeat(3, 1fr); gap: 10px 14px; }
        .story-stats b { font-size: 1.05rem; }
      }

      .campo-concept {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        z-index: 991;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow-y: auto;
        padding: 90px 24px 60px;
        background: var(--parchment);
        transition: opacity 1.2s ease, visibility 1.2s ease;
      }
      .campo-concept.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .campo-concept-inner {
        max-width: 720px;
        margin: 0 auto;
        text-align: center;
      }

      .campo-concept-eyebrow {
        font-size: 0.72rem;
        letter-spacing: 0.35em;
        color: var(--gold-bright);
        margin-bottom: 18px;
      }

      .campo-concept-title {
        font-size: clamp(1.4rem, 3.5vw, 2rem);
        letter-spacing: 0.06em;
        color: var(--text-main);
        margin-bottom: 28px;
      }

      .campo-concept-text {
        font-size: 0.98rem;
        line-height: 2;
        color: var(--text-sub);
        margin-bottom: 20px;
        text-align: left;
      }
      .campo-concept-text:last-of-type { margin-bottom: 36px; }

      .campo-concept-cta {
        display: inline-block;
        color: var(--gold-bright);
        text-decoration: none;
        font-size: 0.88rem;
        letter-spacing: 0.12em;
        border-bottom: 1px solid var(--gold-dim);
        padding-bottom: 4px;
        transition: color 0.3s, border-color 0.3s;
      }
      .campo-concept-cta:hover {
        color: var(--gold-light);
        border-color: var(--gold-light);
      }

      @media (max-width: 640px) {
        .campo-concept { padding: 60px 20px; }
        .campo-concept-text { font-size: 0.92rem; line-height: 1.9; }
      }

      .room-selector {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 992;
        transition: opacity 1.2s ease, visibility 1.2s ease;
        overflow-y: auto;
        padding: 80px 20px 40px;
        background:
          linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.97) 0%,
            rgba(246, 241, 232, 0.95) 50%,
            rgba(255, 255, 255, 0.97) 100%
          ),
          repeating-linear-gradient(
            0deg,
            rgba(212, 175, 55, 0.04) 0px,
            rgba(212, 175, 55, 0.04) 1px,
            transparent 1px,
            transparent 60px
          );
      }

      .room-selector.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .room-selector-title {
        font-size: clamp(0.6rem, 2.5vw, 0.78rem);
        letter-spacing: 0.5em;
        color: var(--gold-dim);
        text-transform: uppercase;
        margin-bottom: 12px;
        text-align: center;
      }

      .room-selector-heading {
        font-size: clamp(1.2rem, 4vw, 2rem);
        font-weight: 400;
        letter-spacing: 0.2em;
        color: var(--text-main);
        margin-bottom: 40px;
        text-align: center;
      }

      .room-list {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: center;
        max-width: 860px;
        width: 100%;
        padding: 0;
      }

      .room-btn {
        position: relative;
        padding: 18px 28px;
        background: rgba(237, 226, 201, 0.5);
        color: var(--text-sub);
        font-family: inherit;
        font-size: clamp(0.78rem, 2.5vw, 0.82rem);
        letter-spacing: 0.18em;
        min-width: min(210px, 42vw);
        cursor: pointer;
        border: none;
        text-align: left;
        transition: color 0.35s ease, background 0.35s ease;
        overflow: hidden;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        min-height: 44px;
      }

      .room-btn::before {
        content: '';
        position: absolute;
        left: 0; top: 0;
        width: 3px;
        height: 100%;
        background: var(--gold-dim);
        transform: scaleY(0);
        transform-origin: bottom;
        transition: transform 0.35s cubic-bezier(0.76, 0, 0.24, 1);
      }

      .room-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        border: 1px solid rgba(212, 175, 55, 0.25);
        transition: border-color 0.35s ease;
      }

      .room-btn:hover {
        background: rgba(227, 211, 171, 0.65);
        color: var(--gold-light);
      }

      .room-btn:hover::before { transform: scaleY(1); }
      .room-btn:hover::after  { border-color: rgba(212, 175, 55, 0.55); }

      .room-btn-number {
        display: block;
        font-size: 0.6rem;
        letter-spacing: 0.3em;
        color: var(--gold-dim);
        margin-bottom: 6px;
        transition: color 0.35s;
      }

      .room-btn:hover .room-btn-number { color: var(--gold-bright); }

      .back-btn {
        margin-top: 40px;
        background: none;
        border: none;
        color: var(--text-muted);
        font-family: inherit;
        font-size: 0.75rem;
        letter-spacing: 0.35em;
        cursor: pointer;
        text-transform: uppercase;
        transition: color 0.3s;
        position: relative;
        padding: 6px 0;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
        min-height: 44px;
      }

      .back-btn::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0;
        width: 100%;
        height: 1px;
        background: var(--gold-dim);
        transform: scaleX(0);
        transition: transform 0.3s ease;
      }

      .back-btn:hover { color: var(--text-sub); }
      .back-btn:hover::after { transform: scaleX(1); }

      .museum {
        opacity: 0;
        visibility: hidden;
        transition: opacity 1.2s ease, visibility 1.2s ease;
        min-height: 100vh;
        background:
          linear-gradient(
            to bottom,
            var(--crimson-deep) 0%,
            #f6f1e8 18%,
            #efe6d4 35%,
            #ede2c9 100%
          );
      }

      .museum.visible {
        opacity: 1;
        visibility: visible;
      }

      .museum-header {
        text-align: center;
        padding-top: 90px;
        padding-bottom: 4px;
        position: relative;
        padding-left: 20px;
        padding-right: 20px;
      }

      .museum-header::after {
        content: '';
        display: block;
        width: 80px;
        height: 1px;
        background: linear-gradient(to right, transparent, var(--gold-dim), transparent);
        margin: 8px auto 0;
      }

      .museum-header-row {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .museum-title {
        font-size: clamp(1rem, 4vw, 1.8rem);
        font-weight: 400;
        letter-spacing: 0.3em;
        color: var(--text-main);
      }

      .museum-count {
        color: var(--text-muted);
        font-size: 0.72rem;
        letter-spacing: 0.25em;
      }

      .scroll-hint {
        text-align: center;
        color: var(--text-muted);
        font-size: 0.65rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-top: 6px;
      }

      .gallery-wrap {
        position: relative;
        display: flex;
        align-items: center;
        margin-top: 2px;
      }

      .gallery-track {
        display: flex;
        gap: 60px;
        padding: 30px 80px 120px;
        overflow-x: auto;
        scroll-behavior: smooth;
        align-items: center;
        scrollbar-width: thin;
        scrollbar-color: var(--crimson-mid) var(--crimson-deep);
        -webkit-overflow-scrolling: touch;
        width: 100%;
      }

      .gallery-track::-webkit-scrollbar { height: 4px; }
      .gallery-track::-webkit-scrollbar-track { background: var(--crimson-deep); }
      .gallery-track::-webkit-scrollbar-thumb { background: var(--crimson-mid); border-radius: 2px; }

      .scroll-arrow {
        position: absolute;
        z-index: 10;
        background: rgba(237, 226, 201, 0.85);
        border: 1px solid rgba(212, 175, 55, 0.3);
        color: var(--gold-bright);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 1.3rem;
        transition: background 0.3s, border-color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
        flex-shrink: 0;
      }

      .scroll-arrow:hover {
        background: rgba(227, 211, 171, 0.95);
        border-color: var(--gold-bright);
      }

      .scroll-arrow.left  { left: 6px; }
      .scroll-arrow.right { right: 6px; }

      .artwork-card {
        flex: 0 0 auto;
        cursor: pointer;
        position: relative;
        transition: transform 0.35s ease;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
      }

      .artwork-card:hover { transform: translateY(-6px); }

      .artwork-frame {
        border-width: 14px;
        border-color:
          var(--frame-light)
          var(--frame-dark)
          var(--frame-dark)
          var(--frame-light);
        box-shadow:
          8px 12px 28px rgba(0,0,0,0.8),
          0 0 0 1px rgba(0,0,0,0.4),
          inset 0 0 16px rgba(0,0,0,0.3);
      }

      /* 額の形 5パターン */
      .frame-shape-classic { border-style: solid; border-radius: 6px; }
      .frame-shape-ridge   { border-style: ridge; border-radius: 16px; border-width: 16px; }
      .frame-shape-sharp   { border-style: solid; border-radius: 0; }
      .frame-shape-groove  { border-style: groove; border-radius: 4px; }
      .frame-shape-ornate  { border-style: double; border-radius: 22px 4px 22px 4px; border-width: 20px; }

      .artwork-frame img {
        width: 100%;
        display: block;
      }

      .artwork-label {
        text-align: center;
        margin-top: 18px;
        padding: 0 4px;
      }

      .artwork-label-title {
        font-size: 0.78rem;
        color: var(--text-sub);
        letter-spacing: 0.08em;
      }

      .artwork-label-artist {
        font-size: 0.68rem;
        color: var(--text-muted);
        margin-top: 5px;
        letter-spacing: 0.06em;
      }

      .modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(10, 2, 2, 0.93);
        z-index: 2000;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(4px);
        padding: 16px;
      }

      .modal-overlay.active { display: flex; }

      .modal {
        background: linear-gradient(160deg, #ffffff 0%, #f6f1e8 100%);
        border: 1px solid rgba(212, 175, 55, 0.2);
        padding: 32px 24px;
        max-width: 740px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        box-shadow:
          0 30px 80px rgba(0,0,0,0.8),
          inset 0 1px 0 rgba(212, 175, 55, 0.1);
        -webkit-overflow-scrolling: touch;
      }

      .modal-close {
        position: absolute;
        top: 12px; right: 14px;
        background: none;
        border: 1px solid rgba(212, 175, 55, 0.25);
        color: var(--text-sub);
        font-size: 1rem;
        width: 34px;
        height: 34px;
        cursor: pointer;
        transition: border-color 0.3s, color 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: manipulation;
      }

      .modal-close:hover {
        border-color: var(--gold-bright);
        color: var(--gold-bright);
      }

      .modal-title {
        font-size: clamp(1rem, 3.5vw, 1.2rem);
        font-weight: 400;
        letter-spacing: 0.1em;
        color: var(--text-main);
        margin-bottom: 10px;
        padding-right: 40px;
      }

      .modal-meta {
        font-size: clamp(0.72rem, 2.5vw, 0.82rem);
        color: var(--text-muted);
        margin-bottom: 22px;
        letter-spacing: 0.05em;
        line-height: 1.8;
      }

      .modal-description {
        font-size: clamp(0.8rem, 2.5vw, 0.85rem);
        line-height: 1.75;
        color: var(--text-sub);
        background: rgba(0,0,0,0.03);
        border-left: 2px solid var(--gold-dim);
        padding: 14px 16px;
      }

      /* メニューが収まらない幅ではハンバーガーに切り替える */
      @media (max-width: 900px) {
        .header-nav  { display: none; }
        .hamburger   { display: flex; }
      }

      @media (max-width: 768px) {
        .site-header { padding: 12px 18px; }
        .header-logo { font-size: 0.82rem; letter-spacing: 0.15em; }
        .header-nav  { display: none; }
        .hamburger   { display: flex; }

        .gallery-track { gap: 36px; padding: 40px 56px 80px; }
        .scroll-arrow { width: 32px; height: 32px; font-size: 1.1rem; }
        .scroll-arrow.left  { left: 4px; }
        .scroll-arrow.right { right: 4px; }

        .modal { padding: 28px 18px; max-height: 88vh; }
        .modal-meta { display: flex; flex-direction: column; gap: 2px; }
        .modal-meta .sep { display: none; }

        .room-btn { min-width: calc(50vw - 28px); padding: 16px 18px; }
        .museum-header { padding-top: 80px; }
      }

      @media (max-width: 480px) {
        .gallery-track { gap: 28px; padding: 36px 48px 70px; }
        .room-list { gap: 10px; }
        .room-btn { min-width: calc(100vw - 56px); }
      }
    </style>
  </head>
  <body>

    <!-- ヘッダー -->
    <header class="site-header">
      <a href={`${base}/${lang}/`} class="header-logo" id="navLogo">{t.headerTitle}</a>

      <!-- PC用ナビ -->
      <nav class="header-nav">
        <a href={`${base}/${lang}/#rooms`} id="navExhibition">{h.navRooms}</a>
        <a href={`${base}/${lang}/about/campo-collection/`} class="nav-campo-highlight">{h.navCampo}</a>
        <AboutNavDropdown lang={lang} base={base} mode="desktop" label={h.navArtist} />
        <div class="lang-switcher">
          <a href={`${base}/ja/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
          <a href={`${base}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
          <a href={`${base}/sp/`} class={lang === 'sp' ? 'active' : ''}>ES</a>
        </div>
      </nav>

      <!-- ハンバーガーボタン -->
      <button class="hamburger" id="hamburgerBtn" aria-label="メニューを開く">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>

    <!-- モバイルオーバーレイ -->
    <div class="mobile-overlay" id="mobileOverlay"></div>

    <!-- モバイルメニュー -->
    <div class="mobile-menu" id="mobileMenu">
      <nav class="mobile-menu-nav">
        <a href={`${base}/${lang}/`} id="mNavTop">{t.backTop}</a>
        <a href={`${base}/${lang}/#rooms`} id="mNavExhibition">{h.navRooms}</a>
        <a href={`${base}/${lang}/about/campo-collection/`} class="nav-campo-highlight">{h.navCampo}</a>
        <AboutNavDropdown lang={lang} base={base} mode="mobile" label={h.navArtist} />
      </nav>
      <div class="mobile-lang-switcher">
        <a href={`${base}/ja/`} class={lang === 'ja' ? 'active' : ''}>JP</a>
        <a href={`${base}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
        <a href={`${base}/sp/`} class={lang === 'sp' ? 'active' : ''}>ES</a>
      </div>
    </div>

    <!-- ホーム：入口写真＋区画 -->
    <div class="home" id="home">
      <section class="entrance" id="entrance">
        <script is:inline define:vars={{ heroBase: `${base}/hero/`, heroCount: 8 }}>
          // 所蔵作品を壁に掛けた入口写真を、訪問ごとにランダムで選ぶ
          const n = 1 + Math.floor(Math.random() * heroCount);
          document.getElementById('entrance').style.backgroundImage = `url('${heroBase}hero-${n}.jpg')`;
        </script>
        <div class="hero-inner">
          <p class="hero-eyebrow">{t.headerTitle}</p>
          <h1 class="hero-title">{lang === 'ja' ? (<>徳永アート<br />ミュージアム</>) : t.title}</h1>
          <p class="hero-subtitle">{h.tagline}</p>
          <button class="enter-btn" id="enterBtn">{t.enter}</button>
          <button class="concept-link" id="conceptLink">{concept.eyebrow}<span>{concept.title}</span></button>
        </div>
        <button class="scroll-cue" id="scrollCue" type="button">{h.scrollCue}</button>
      </section>

      <!-- 今日の一枚 -->
      <section class="home-sec" id="today">
        <div class="split">
          <div>
            <p class="sec-eyebrow">{h.todayEyebrow}</p>
            <h2 class="sec-heading">{h.todayHeading}</h2>
            <p class="sec-text">{h.todayNote}</p>
            <div class="sec-links">
              <button class="sec-cta" id="todayOpen" type="button">{h.todayOpen}</button>
              <button class="sec-link" id="todayAnother" type="button">{h.todayAnother}</button>
            </div>
          </div>
          <figure class="today-figure">
            <button class="today-btn" id="todayBtn" type="button" data-file={todayDefault.file}>
              <div class="home-frame"><img id="todayImg" src={`${base}/gallery/${todayDefault.file}`} alt={todayDefault.title} /></div>
            </button>
            <figcaption class="today-caption">
              <b id="todayTitle">{todayDefault.title}</b>
              <span id="todayMeta">{todayDefault.artist}{todayDefault.year !== '—' ? ` ／ ${todayDefault.year}` : ''}</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- 物語 -->
      <section class="home-sec story">
        <div class="split">
          <figure style="margin:0">
            <a href={`${base}/${lang}/about/campo-collection/`} class="home-frame" style="display:block">
              <img src={`${base}/gallery/${storyImage}`} alt="" loading="lazy" />
            </a>
          </figure>
          <div>
            <p class="sec-eyebrow">{h.storyEyebrow}</p>
            <h2 class="sec-heading">{h.storyHeading}</h2>
            {h.storyBody.map((p) => <p class="sec-text">{p}</p>)}
            <div class="story-stats">
              {storyStats.map((s) => <div><b>{s.num}</b><span>{s.label}</span></div>)}
            </div>
            <div class="sec-links">
              <a class="sec-cta" href={`${base}/${lang}/about/campo-collection/`}>{h.storyCta} →</a>
              <button class="sec-link" id="storyConcept" type="button">{h.storyConcept}</button>
            </div>
          </div>
        </div>
      </section>

      <!-- 展示室 -->
      <section class="home-sec" id="rooms">
        <p class="sec-eyebrow" style="text-align:center">{h.roomsEyebrow}</p>
        <h2 class="sec-heading" style="text-align:center;margin-bottom:36px">{h.roomsHeading}</h2>
        <div class="room-cards">
          {roomCards.map((room, idx) => (
            <button class="room-card" type="button" data-room={room.id} data-name={room.name}>
              {room.cover && <img src={`${base}/gallery/${room.cover}`} alt="" loading="lazy" />}
              <span class="room-card-body">
                <span>
                  <span class="room-card-number">ROOM {String(idx + 1).padStart(2, '0')}</span>
                  <span class="room-card-name">{room.name}</span>
                </span>
                <span class="room-card-count">{room.count}{lang === 'ja' ? '' : ' '}{h.roomsWorks} →</span>
              </span>
            </button>
          ))}
        </div>
      </section>

      <!-- 現地取材 -->
      <section class="home-sec">
        <div class="report-box">
          <p class="sec-eyebrow">{h.reportEyebrow}</p>
          <h2 class="sec-heading">{h.reportHeading}</h2>
          <p class="sec-text">{h.reportBody}</p>
          <div class="sec-links">
            <a class="sec-link" href={`${base}/${lang}/about/campo-notes/`}>{h.reportCta} →</a>
          </div>
        </div>
      </section>

      <!-- 画家について -->
      <section class="home-sec">
        <p class="sec-eyebrow">{h.artistEyebrow}</p>
        <h2 class="sec-heading">{h.artistHeading}</h2>
        <p class="sec-text">{h.artistBody}</p>
        <div class="sec-links">
          <a class="sec-link" href={`${base}/${lang}/about/`}>{h.artistMemoir} →</a>
          <a class="sec-link" href={`${base}/${lang}/about/philosophy/`}>{h.artistWhite} →</a>
        </div>
      </section>

      <footer class="home-footer">
        <div class="home-footer-inner">
          <div>
            <p class="home-footer-logo">{t.headerTitle}</p>
            <nav>
              <a href={`${base}/${lang}/about/campo-collection/`}>{h.navCampo}</a>
              <a href={`${base}/${lang}/about/`}>{h.navArtist}</a>
              <a href={`${base}/${lang}/about/contact/`}>{h.footerContact}</a>
              <a href={`${base}/${lang}/shop/`}>{t.navShop}</a>
              <a href={`${base}/${lang}/storage/`}>{t.navStorage}</a>
            </nav>
            <a class="family" href="https://second-penguin.com/#sp-apps" target="_blank" rel="noopener">{h.footerFamily} →</a>
          </div>
          <nav aria-label="Language">
            <a href={`${base}/ja/`}>日本語</a>
            <a href={`${base}/en/`}>English</a>
            <a href={`${base}/sp/`}>Español</a>
          </nav>
        </div>
      </footer>
    </div>

    <!-- カンポ・デ・クリプターナ構想セクション -->
    <div class="campo-concept hidden" id="campoConceptScreen">
      <div class="campo-concept-inner">
        <p class="campo-concept-eyebrow">{concept.eyebrow}</p>
        <h2 class="campo-concept-title">{concept.title}</h2>
        {concept.paragraphs.map((p) => <p class="campo-concept-text">{p}</p>)}
        <a class="campo-concept-cta" href={`${base}/${lang}/about/campo-collection/`}>{concept.cta}</a>
        <button class="back-btn" id="backToTopFromConcept">{t.backTop}</button>
      </div>
    </div>

    <!-- 展示室セレクター（「入館する」から） -->
    <div class="room-selector hidden" id="roomSelector">
      <p class="room-selector-title">EXHIBITION ROOMS</p>
      <h2 class="room-selector-heading">{t.roomSelect}</h2>
      <div class="room-cards">
        {roomCards.map((room, idx) => (
          <button class="room-card" type="button" data-room={room.id} data-name={room.name}>
            {room.cover && <img src={`${base}/gallery/${room.cover}`} alt="" loading="lazy" />}
            <span class="room-card-body">
              <span>
                <span class="room-card-number">ROOM {String(idx + 1).padStart(2, '0')}</span>
                <span class="room-card-name">{room.name}</span>
              </span>
              <span class="room-card-count">{room.count}{lang === 'ja' ? '' : ' '}{h.roomsWorks} →</span>
            </span>
          </button>
        ))}
      </div>
      <button class="back-btn" id="backToTopFromSelector">{t.backTop}</button>
    </div>

    <!-- ミュージアム本体 -->
    <div class="museum" id="museum">
      <div class="museum-header">
        <div class="museum-header-row">
          <h2 class="museum-title" id="museumTitle">{t.title}</h2>
          <div class="museum-count" id="museumCount"></div>
        </div>
      </div>
      <div class="scroll-hint">{t.scrollHint}</div>

      <div class="gallery-wrap">
        <button class="scroll-arrow left" id="arrowLeft">&#8249;</button>
        <div class="gallery-track" id="galleryTrack">
          {categorizedArtworks.map((info) => (
            <div
              class="artwork-card"
              style={`width: ${getCardWidth(info.rawSizeJa)}px; --frame-light: ${info.frameLight}; --frame-dark: ${info.frameDark};`}
              data-category={info.category}
              data-file={info.file}
              data-title={info.title}
              data-artist={info.artist}
              data-year={info.year}
              data-size={info.size}
              data-description={info.description}
              data-frame-light={info.frameLight}
              data-frame-dark={info.frameDark}
              data-frame-shape={info.frameShape}
            >
              <div class={`artwork-frame frame-shape-${info.frameShape}`}>
                <img src={`${base}/gallery/${info.file}`} alt={info.title} loading="lazy" />
              </div>
              <div class="artwork-label">
                <div class="artwork-label-title">{info.title}</div>
                <div class="artwork-label-artist">{info.artist}</div>
              </div>
            </div>
          ))}
        </div>
        <button class="scroll-arrow right" id="arrowRight">&#8250;</button>
      </div>
    </div>

    <!-- モーダル -->
    <div class="modal-overlay" id="modalOverlay">
      <div class="modal">
        <button class="modal-close" id="modalClose">✕</button>
        <div style="text-align: center; margin-bottom: 20px;">
          <div id="modalFrame" class="frame-shape-classic" style="display: inline-block; border-width: 18px; box-shadow: 8px 12px 32px rgba(0,0,0,0.85), 0 0 0 1px rgba(0,0,0,0.4), inset 0 0 20px rgba(0,0,0,0.3);">
            <img id="modalImg" src="" style="max-width: 100%; max-height: 48vh; object-fit: contain; display: block;" />
          </div>
        </div>
        <h3 class="modal-title" id="modalTitle"></h3>
        <p class="modal-meta">
          <span id="modalArtist"></span>
          <span class="sep">&ensp;/&ensp;</span>
          <span id="modalYear"></span>
          <span class="sep">&ensp;/&ensp;</span>
          <span id="modalSize"></span>
        </p>
        <div class="modal-description" id="modalDescription"></div>
      </div>
    </div>

    <script is:inline>
      const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') ?? '';
      const homeView     = document.getElementById('home');
      const roomSelector = document.getElementById('roomSelector');
      const campoConcept = document.getElementById('campoConceptScreen');
      const museum       = document.getElementById('museum');
      const galleryTrack = document.getElementById('galleryTrack');
      const siteHeader   = document.querySelector('.site-header');

      const hamburgerBtn  = document.getElementById('hamburgerBtn');
      const mobileMenu    = document.getElementById('mobileMenu');
      const mobileOverlay = document.getElementById('mobileOverlay');

      // モバイルメニュー開閉
      function openMobileMenu() {
        hamburgerBtn.classList.add('open');
        mobileMenu.classList.add('open');
        mobileOverlay.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeMobileMenu() {
        hamburgerBtn.classList.remove('open');
        mobileMenu.classList.remove('open');
        mobileOverlay.classList.remove('open');
        document.body.style.overflow = '';
      }

      hamburgerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (mobileMenu.classList.contains('open')) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      });

      mobileOverlay.addEventListener('click', closeMobileMenu);

      // 画面遷移（ホーム / 構想 / 部屋選び / ギャラリー）
      function showOnly(view) {
        homeView.classList.toggle('hidden', view !== 'home');
        siteHeader.classList.toggle('solid', view === 'home' && homeView.scrollTop > window.innerHeight * 0.6);
        campoConcept.classList.toggle('hidden', view !== 'concept');
        roomSelector.classList.toggle('hidden', view !== 'selector');
        museum.classList.toggle('visible', view === 'museum');
        closeMobileMenu();
      }

      function showHome(sectionId) {
        showOnly('home');
        if (sectionId) {
          const target = document.getElementById(sectionId);
          if (target) homeView.scrollTo({ top: target.offsetTop - 60, behavior: 'smooth' });
        } else {
          homeView.scrollTo({ top: 0 });
        }
      }

      function openRoom(roomId, roomName) {
        let count = 0;
        document.querySelectorAll('.artwork-card').forEach(card => {
          if (card.dataset.category === roomId) {
            card.style.display = 'block';
            count++;
          } else {
            card.style.display = 'none';
          }
        });

        document.getElementById('museumTitle').textContent = roomName;
        document.getElementById('museumCount').textContent = count + ' WORKS';

        galleryTrack.scrollLeft = 0;
        window.scrollTo(0, 0);
        showOnly('museum');
      }

      // ロゴとメニュー
      function onNav(id, handler) {
        document.getElementById(id).addEventListener('click', (e) => {
          e.preventDefault();
          handler();
        });
      }
      onNav('navLogo', () => showHome());
      onNav('mNavTop', () => showHome());
      onNav('navExhibition', () => showHome('rooms'));
      onNav('mNavExhibition', () => showHome('rooms'));
      onNav('enterBtn', () => showOnly('selector'));
      onNav('conceptLink', () => showOnly('concept'));
      onNav('storyConcept', () => showOnly('concept'));
      onNav('scrollCue', () => showHome('today'));
      document.getElementById('backToTopFromConcept').addEventListener('click', () => showHome());
      document.getElementById('backToTopFromSelector').addEventListener('click', () => showHome());

      // 展示室カード（ホームと部屋選び画面）
      document.querySelectorAll('.room-card').forEach(btn => {
        btn.addEventListener('click', () => openRoom(btn.dataset.room, btn.dataset.name));
      });

      // ホームを下へスクロールしたらヘッダーに地色を敷く（絵や文字と重ならないように）
      homeView.addEventListener('scroll', () => {
        siteHeader.classList.toggle('solid', homeView.scrollTop > window.innerHeight * 0.6);
      }, { passive: true });

      // 他のページから「展示室」で来たとき（/ja/#rooms）
      if (location.hash === '#rooms') {
        requestAnimationFrame(() => showHome('rooms'));
      }

      // スクロール矢印
      document.getElementById('arrowLeft').addEventListener('click', () => {
        galleryTrack.scrollBy({ left: -360, behavior: 'smooth' });
      });
      document.getElementById('arrowRight').addEventListener('click', () => {
        galleryTrack.scrollBy({ left: 360, behavior: 'smooth' });
      });

      // アートワークモーダル
      function openArtwork(card) {
        document.getElementById('modalImg').src                 = `${base}/gallery/${card.dataset.file}`;
        document.getElementById('modalTitle').textContent       = card.dataset.title;
        document.getElementById('modalArtist').textContent      = card.dataset.artist;
        document.getElementById('modalYear').textContent        = card.dataset.year;
        document.getElementById('modalSize').textContent        = card.dataset.size;
        document.getElementById('modalDescription').textContent = card.dataset.description;
        const frameLight = card.dataset.frameLight;
        const frameDark  = card.dataset.frameDark;
        const modalFrame = document.getElementById('modalFrame');
        modalFrame.style.borderColor = `${frameLight} ${frameDark} ${frameDark} ${frameLight}`;
        modalFrame.className = `frame-shape-${card.dataset.frameShape}`;
        document.getElementById('modalOverlay').classList.add('active');
      }

      document.querySelectorAll('.artwork-card').forEach(card => {
        card.addEventListener('click', () => openArtwork(card));
      });

      document.getElementById('modalClose').addEventListener('click', () => {
        document.getElementById('modalOverlay').classList.remove('active');
      });

      document.getElementById('modalOverlay').addEventListener('click', (e) => {
        if (e.target.id === 'modalOverlay') {
          e.target.classList.remove('active');
        }
      });

      // 今日の一枚：訪問ごとに所蔵作品から1点を選ぶ
      const todayBtn = document.getElementById('todayBtn');
      // 題名が仮（「作品 3」など）のものは除く
      const todayPool = [...document.querySelectorAll('.artwork-card')]
        .filter(c => !/^(作品|Work|Obra)\s*\d+$/.test(c.dataset.title.trim()));
      let todayCard = todayPool.find(c => c.dataset.file === todayBtn.dataset.file) ?? todayPool[0];

      function showToday(card) {
        if (!card) return;
        todayCard = card;
        const img = document.getElementById('todayImg');
        img.src = `${base}/gallery/${card.dataset.file}`;
        img.alt = card.dataset.title;
        document.getElementById('todayTitle').textContent = card.dataset.title;
        const year = card.dataset.year && card.dataset.year !== '—' ? ` ／ ${card.dataset.year}` : '';
        document.getElementById('todayMeta').textContent = card.dataset.artist + year;
      }

      function pickToday() {
        if (todayPool.length < 2) return todayCard;
        let next;
        do { next = todayPool[Math.floor(Math.random() * todayPool.length)]; } while (next === todayCard);
        return next;
      }

      showToday(pickToday());
      todayBtn.addEventListener('click', () => openArtwork(todayCard));
      document.getElementById('todayOpen').addEventListener('click', () => openArtwork(todayCard));
      document.getElementById('todayAnother').addEventListener('click', () => showToday(pickToday()));
    </script>
  </body>
</html>
