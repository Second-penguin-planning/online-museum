---
import shopData from '../../data/shop.json';
import { ui } from '../../data/ui.ts';
import { readdirSync } from 'fs';
import { join } from 'path';

export function getStaticPaths() {
  return [
    { params: { lang: 'ja' } },
    { params: { lang: 'en' } },
    { params: { lang: 'sp' } },
  ];
}

const { lang } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = ui[lang];

// galleryフォルダの99xxx.jpg を自動スキャン
const galleryDir = join(process.cwd(), 'public/gallery');
const allShopFiles = readdirSync(galleryDir)
  .filter(f => /^99\d+\.(jpg|jpeg|png|webp)$/i.test(f))
  .sort();

const registeredFiles = new Set(shopData.map((s: any) => s.file));

const unregistered = allShopFiles
  .filter(f => !registeredFiles.has(f))
  .map(f => ({ file: f }));

const allItems = [...shopData, ...unregistered];

const shopItems = allItems.map((item: any) => ({
  ...item,
  title:       item.title?.[lang]       || item.title?.ja       || '—',
  price:       item.price ?? null,
  description: item.description?.[lang] || item.description?.ja || '',
}));

const shopUI = {
  ja: {
    eyebrow: 'MUSEUM SHOP',
    title:   'ミュージアムショップ',
    nav:     { gallery: 'ギャラリー', about: 'アバウト', storage: '所蔵庫' },
    soldOut: '売切れ',
    inquiry: 'お問い合わせ',
    noPrice: '価格未登録',
    noTitle: '— タイトル未登録 —',
    adminEyebrow: 'SHOP ADMIN',
    adminTitle:  '商 品 情 報 登 録',
    adminBtn:    '⚙ ADMIN',
    adminAuth:   '管 理 者 認 証',
    adminEnter:  '認 証 す る',
    adminPwErr:  'パスワードが違います',
    submitBtn:   '登 録 す る',
    formSections: {
      basic: '基本情報',
      title: 'タイトル',
      price: '価格・在庫',
      desc:  '商品説明',
      github: 'GitHub 認証',
    },
    labels: {
      file:      'ファイル名（例: 99002.jpg）',
      titleJa:   'タイトル（日本語）',
      titleEn:   'タイトル（英語）',
      titleSp:   'タイトル（スペイン語）',
      price:     '価格（円）例: 50000',
      soldOut:   '売切れ',
      descJa:    '説明（日本語）',
      descEn:    '説明（英語）',
      descSp:    '説明（スペイン語）',
      token:     'Personal Access Token',
      tokenNote: 'GitHub Settings → Developer settings → Personal access tokens で発行。Contents: Read and Write 権限が必要です。',
    },
    status: {
      loading: '送信中...',
      success: '✓ 登録が完了しました。数分後に反映されます。',
    },
  },
  en: {
    eyebrow: 'MUSEUM SHOP',
    title:   'Museum Shop',
    nav:     { gallery: 'Gallery', about: 'About', storage: 'Storage' },
    soldOut: 'Sold Out',
    inquiry: 'Inquire',
    noPrice: 'Price not set',
    noTitle: '— Title not registered —',
    adminEyebrow: 'SHOP ADMIN',
    adminTitle:  'Register Product',
    adminBtn:    '⚙ ADMIN',
    adminAuth:   'Admin Authentication',
    adminEnter:  'Authenticate',
    adminPwErr:  'Incorrect password',
    submitBtn:   'Register',
    formSections: {
      basic: 'Basic Info',
      title: 'Title',
      price: 'Price & Stock',
      desc:  'Description',
      github: 'GitHub Auth',
    },
    labels: {
      file:      'File name (e.g. 99002.jpg)',
      titleJa:   'Title (Japanese)',
      titleEn:   'Title (English)',
      titleSp:   'Title (Spanish)',
      price:     'Price (JPY) e.g. 50000',
      soldOut:   'Sold out',
      descJa:    'Description (Japanese)',
      descEn:    'Description (English)',
      descSp:    'Description (Spanish)',
      token:     'Personal Access Token',
      tokenNote: 'Generate at GitHub Settings → Developer settings → Personal access tokens. Requires Contents: Read and Write.',
    },
    status: {
      loading: 'Submitting...',
      success: '✓ Registered successfully. Changes will appear in a few minutes.',
    },
  },
  sp: {
    eyebrow: 'TIENDA DEL MUSEO',
    title:   'Tienda del Museo',
    nav:     { gallery: 'Galería', about: 'Acerca', storage: 'Archivo' },
    soldOut: 'Agotado',
    inquiry: 'Consultar',
    noPrice: 'Precio no registrado',
    noTitle: '— Título no registrado —',
    adminEyebrow: 'ADMIN TIENDA',
    adminTitle:  'Registrar Producto',
    adminBtn:    '⚙ ADMIN',
    adminAuth:   'Autenticación de Admin',
