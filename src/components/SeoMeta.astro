---
// src/components/SeoMeta.astro
// 各ページの <head> に入れる説明文・SNS共有用カード（OGP / X）・言語別URL。
// LINE や Facebook にリンクを貼ったとき、絵の画像と説明文が出るようにする。
type Lang = 'ja' | 'en' | 'sp';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** public/og/ 配下の画像名、または public/ からのパス（例 'gallery/01018.jpg'）。省略時はトップ用 */
  image?: 'og-home.jpg' | 'og-campo.jpg' | `gallery/${string}`;
  /** 検索結果に出したくないページ（所蔵庫など） */
  noindex?: boolean;
}

const { lang, title, description, image = 'og-home.jpg', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site ?? new URL('https://second-penguin-planning.github.io')).origin.toLowerCase();

const path = Astro.url.pathname;
const pageUrl = `${site}${path}`;
// 作品ページは作品画像そのものを共有カードに使う（1200×630 の共有用画像ではないので寸法は書かない）
const isOgImage = !image.includes('/');
const imageUrl = isOgImage ? `${site}${base}/og/${image}` : `${site}${base}/${image}`;

const ogLocale: Record<Lang, string> = { ja: 'ja_JP', en: 'en_US', sp: 'es_ES' };
const hreflang: Record<Lang, string> = { ja: 'ja', en: 'en', sp: 'es' };
const langs: Lang[] = ['ja', 'en', 'sp'];
const altUrl = (l: Lang) => `${site}${path.replace(`${base}/${lang}/`, `${base}/${l}/`)}`;
---

<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={pageUrl} />
{langs.map((l) => <link rel="alternate" hreflang={hreflang[l]} href={altUrl(l)} />)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={lang === 'ja' ? '徳永アートミュージアム' : 'Tokunaga Art Museum'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={imageUrl} />
{isOgImage && <meta property="og:image:width" content="1200" />}
{isOgImage && <meta property="og:image:height" content="630" />}
<meta property="og:locale" content={ogLocale[lang]} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
