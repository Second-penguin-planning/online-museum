---
// src/layouts/AboutSectionLayout.astro
// 「概要」配下の各ページ（はじめに・製作者と連絡先・経歴・記録・カンポ概要）共通レイアウト。
// about.astro（随想ページ）と同じ配色・ヘッダー様式に合わせている。
import { getAboutNav, aboutNavLabel, type Lang } from '../data/aboutNav';

interface Props {
  lang: Lang;
  base: string;
  slug: string; // /about/ 配下のパス。例: 'intro', 'takuma-biography'
  metaTitle: string;
  metaDescription: string;
  pageTitle: string;
}

const { lang, base, slug, metaTitle, metaDescription, pageTitle } = Astro.props;
const entries = getAboutNav(lang, base);

const backLabel: Record<Lang, string> = {
  ja: '← ギャラリーへ戻る',
  en: '← Back to Gallery',
  sp: '← Volver a la Galería',
};
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --crimson:   #4a0a0a;
      --crimson-mid: #6b1414;
      --gold:      #d4af37;
      --gold-pale: #e8d070;
      --cream:     #faf6ef;
      --text:      #1a1208;
      --text-mid:  #3d2b1f;
      --sidebar-w: 280px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'EB Garamond', 'Yu Mincho', '游明朝', serif;
      background: var(--cream);
      color: var(--text);
      min-height: 100vh;
    }

    .sp-familybar { padding: 8px 16px; text-align: center; font-family: -apple-system, "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif; }
    .sp-familybar--dark { background: #16181d; border-bottom: 1px solid #33363f; }
    .sp-familybar__link { font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; color: #e8e2d0; }
    .sp-familybar__link:hover { text-decoration: underline; }

    .page-header {
      background: linear-gradient(135deg, var(--crimson) 0%, var(--crimson-mid) 100%);
      padding: 2rem 2.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 3px solid var(--gold);
      position: sticky;
      top: 0;
      z-index: 100;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .back-link {
      color: var(--gold-pale);
      text-decoration: none;
      font-size: 1rem;
      letter-spacing: .08em;
      transition: color .2s;
    }
    .back-link:hover { color: #fff; }
    .header-title {
      color: var(--gold);
      font-size: 1.4rem;
      letter-spacing: .15em;
      text-align: center;
    }
    .lang-nav { display: flex; gap: .75rem; }
    .lang-nav a {
      color: var(--gold-pale);
      text-decoration: none;
      font-size: .85rem;
      letter-spacing: .1em;
      padding: .25rem .5rem;
      border: 1px solid transparent;
      border-radius: 3px;
      transition: all .2s;
    }
    .lang-nav a:hover,
    .lang-nav a.active { border-color: var(--gold); color: var(--gold); }

    /* ─── レイアウト ─── */
    .about-layout {
      display: flex;
      align-items: flex-start;
      max-width: 1100px;
      margin: 0 auto;
      gap: 2.5rem;
      padding: 2.5rem 2rem 5rem;
    }
    .about-sidebar {
      flex: 0 0 var(--sidebar-w);
      position: sticky;
      top: 110px;
    }
    .sidebar-heading {
      color: var(--crimson);
      font-size: .95rem;
      letter-spacing: .15em;
      border-bottom: 1px solid var(--gold);
      padding-bottom: .6rem;
      margin-bottom: .8rem;
    }
    .about-sidebar > ul { list-style: none; }
    .about-sidebar > ul > li { margin-bottom: .3rem; }
    .about-sidebar a {
      display: block;
      color: var(--text-mid);
      text-decoration: none;
      font-size: .92rem;
      padding: .35rem 0;
      border-left: 2px solid transparent;
      padding-left: .6rem;
      transition: color .2s, border-color .2s, padding-left .2s;
    }
    .about-sidebar a:hover,
    .about-sidebar a.active { color: var(--crimson); border-left-color: var(--gold); padding-left: .9rem; }
    .sidebar-group { margin-top: .5rem; }
    .sidebar-group > span {
      display: block;
      font-size: .88rem;
      letter-spacing: .05em;
      color: var(--text-mid);
      opacity: .8;
      padding: .2rem 0 .2rem .6rem;
    }
    .sidebar-group > ul { list-style: none; padding-left: .8rem; }

    .about-main { flex: 1; min-width: 0; }
    .about-main h1 {
      font-size: 1.9rem;
      color: var(--crimson);
      letter-spacing: .06em;
      margin-bottom: 1.6rem;
      border-bottom: 2px solid var(--gold);
      padding-bottom: .8rem;
    }
    .about-main :global(p) { line-height: 1.9; font-size: 1.02rem; margin-bottom: 1.1rem; }
    .placeholder-notice {
      display: inline-block;
      color: var(--crimson);
      background: rgba(212,175,55,0.12);
      border: 1px solid var(--gold);
      border-radius: 4px;
      padding: .5rem 1rem;
      font-size: .9rem;
      letter-spacing: .05em;
      margin-bottom: 1.4rem;
    }

    @media (max-width: 860px) {
      .page-header { padding: 1rem 1.25rem; }
      .header-title { font-size: 1.1rem; order: -1; width: 100%; text-align: left; }
      .about-layout { flex-direction: column; padding: 1.5rem 1.25rem 3rem; gap: 1.5rem; }
      .about-sidebar { position: static; width: 100%; }
    }
  </style>
</head>
<body>

  <div class="sp-familybar sp-familybar--dark">
    <a href="https://second-penguin.com/#sp-apps" target="_blank" rel="noopener" class="sp-familybar__link">
      セコンドペンギン企画 ファミリーサイト一覧へ <span aria-hidden="true">→</span>
    </a>
  </div>

  <header class="page-header">
    <a href={`${base}/${lang}/`} class="back-link">{backLabel[lang]}</a>
    <span class="header-title">{pageTitle}</span>
    <nav class="lang-nav">
      <a href={`${base}/ja/about/${slug}`} class:list={['lang-link', { active: lang === 'ja' }]}>日本語</a>
      <a href={`${base}/en/about/${slug}`} class:list={['lang-link', { active: lang === 'en' }]}>English</a>
      <a href={`${base}/sp/about/${slug}`} class:list={['lang-link', { active: lang === 'sp' }]}>Español</a>
    </nav>
  </header>

  <div class="about-layout">
    <aside class="about-sidebar">
      <p class="sidebar-heading">{aboutNavLabel[lang]}</p>
      <ul>
        {entries.map(entry => (
          'children' in entry ? (
            <li class="sidebar-group">
              <span>{entry.label}</span>
              <ul>
                {entry.children.map(child => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li><a href={entry.href}>{entry.label}</a></li>
          )
        ))}
      </ul>
    </aside>

    <main class="about-main">
      <h1>{pageTitle}</h1>
      <slot />
    </main>
  </div>

</body>
</html>
